     /// `getTypeOfPropertyOrIndexSignatureOfType` (`checker.go`): the named
     /// property's type, else the value type of an index signature applicable
-    /// to the name.
+    /// to the name. Both lookups read the reduced apparent type
+    /// (`getPropertyOfType`, `getIndexInfosOfType`), so a `NoInfer<T>`
+    /// constituent answers `T`'s member.
     fn get_type_of_property_or_index_signature_of_type(
         &mut self,
         t: TypeId,
         name: &str,
     ) -> Option<TypeId> {
+        let t = match self.no_infer_base_type(t) {
+            Some(base) => self.apparent_type(base),
+            None => t,
+        };
         if let Some(prop) = self.get_type_of_property_of_type(t, name) {
             return Some(prop);
         }
