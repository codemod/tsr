 func (c *Checker) instantiateSymbol(symbol *ast.Symbol, m *TypeMapper) *ast.Symbol {
+
+    if symbol != nil && symbol.Name == "value" && symbol.Parent != nil && symbol.Parent.Name == "Base" {
+        var pcs [16]uintptr
+        n := runtime.Callers(2, pcs[:])
+        frames := runtime.CallersFrames(pcs[:n])
+        var names []string
+        for { frame, more := frames.Next(); names = append(names, frame.Function); if !more { break } }
+        links := c.valueSymbolLinks.TryGet(symbol)
+        var read, write *Type
+        if links != nil { read=links.resolvedType; write=links.writeType }
+        fmt.Printf("NATIVE_INSTANTIATE checker=%d symbol=%p checkFlags=%d mapper=%p read=%p write=%p stack=%s\n", c.id, symbol, symbol.CheckFlags, m, read, write, strings.Join(names," > "))
+    }
 	if symbol == nil {
 		return nil
 	}
