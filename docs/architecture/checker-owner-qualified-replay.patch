+/// Native ast.GetSymbolId publication slot (pinned 5b1047d).
+/// Zero means uncomputed. This identity is never a `SymbolStore` index.
+/// Bound records share the slot across Checkers; each private clone starts fresh.
+#[derive(Debug, Default)]
+pub struct NativeSymbolIdentity(std::sync::atomic::AtomicU64);
+
+impl NativeSymbolIdentity {
+    /// Publish one process-unique identity with native first-read ordering.
+    /// Contending readers may burn IDs but all observe the winning slot.
+    #[must_use]
+    pub fn get(&self) -> u64 {
+        use std::sync::atomic::{AtomicU64, Ordering};
+        static NEXT_ID: AtomicU64 = AtomicU64::new(1);
+        let mut id = self.0.load(Ordering::Relaxed);
+        if id == 0 {
+            id = NEXT_ID.fetch_add(1, Ordering::Relaxed);
+            if let Err(published) =
+                self.0.compare_exchange(0, id, Ordering::Relaxed, Ordering::Relaxed)
+            {
+                id = published;
+            }
+        }
+        id
+    }
+}
