+package checker
+
+// Temporary observer. It never answers a semantic query or forces type/member
+// resolution. Checker-local pointers are observation keys, not shared caches.
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"slices"
+)
+
+var memberCompletionProbeEnabled = os.Getenv("TSGO_MEMBER_COMPLETION_PROBE") == "1"
+
+type memberCompletionRow struct {
+	ID                 TypeId                      `json:"id"`
+	Owner              uint32                      `json:"owner"`
+	TypeOwner          uint32                      `json:"type_owner"`
+	Name               string                      `json:"name"`
+	Alias              string                      `json:"alias"`
+	Flags              TypeFlags                   `json:"flags"`
+	ObjectFlags        ObjectFlags                 `json:"object_flags"`
+	Queries            int                         `json:"queries"`
+	FinalFlagHits      int                         `json:"final_flag_hits"`
+	ActiveFlagHits     int                         `json:"active_flag_hits"`
+	UnresolvedFlagHits int                         `json:"unresolved_flag_hits"`
+	ActiveMisses       int                         `json:"active_misses"`
+	Workers            map[string]int              `json:"workers"`
+	DeclaredWorkers    int                         `json:"declared_workers"`
+	Publications       []memberCompletionView      `json:"publications"`
+	Returns            []memberCompletionReturn    `json:"returns"`
+	References         []memberCompletionReference `json:"references"`
+	KeyRequests        []memberCompletionKey       `json:"key_requests"`
+	ResetCalls         int                         `json:"reset_calls"`
+	ResolvedResets     int                         `json:"resolved_resets"`
+	ActiveDepth        int                         `json:"active_depth"`
+	FinalView          memberCompletionView        `json:"final_view"`
+}
+type memberCompletionView struct {
+	Epoch       int      `json:"epoch"`
+	ActiveDepth int      `json:"active_depth"`
+	Resolved    bool     `json:"resolved"`
+	Unresolved  bool     `json:"unresolved"`
+	Names       []string `json:"names"`
+	Calls       int      `json:"calls"`
+	Constructs  int      `json:"constructs"`
+	Indexes     int      `json:"indexes"`
+}
+type memberCompletionReturn struct {
+	Epoch      int  `json:"epoch"`
+	Active     bool `json:"active"`
+	Resolved   bool `json:"resolved"`
+	Unresolved bool `json:"unresolved"`
+	Properties int  `json:"properties"`
+	Count      int  `json:"count"`
+}
+type memberCompletionReference struct {
+	Target       TypeId   `json:"target"`
+	Parameters   []TypeId `json:"parameters"`
+	Arguments    []TypeId `json:"arguments"`
+	Padded       []TypeId `json:"padded"`
+	ThisAppended bool     `json:"this_appended"`
+}
+type memberCompletionKey struct {
+	Include    TypeFlags `json:"include"`
+	Origin     bool      `json:"origin"`
+	Unresolved bool      `json:"unresolved"`
+	Active     bool      `json:"active"`
+}
+type memberCompletionProbe struct {
+	rows map[*Type]*memberCompletionRow
+}
+
+func (c *Checker) memberCompletionRow(t *Type) *memberCompletionRow {
+	p := c.memberCompletionProbe
+	r := p.rows[t]
+	if r == nil {
+		r = &memberCompletionRow{ID: t.id, Owner: c.id, Flags: t.flags, Workers: map[string]int{}}
+		p.rows[t] = r
+	}
+	if t.symbol != nil {
+		r.Name = t.symbol.Name
+	}
+	if t.alias != nil && t.alias.symbol != nil {
+		r.Alias = t.alias.symbol.Name
+	}
+	if t.checker != nil {
+		r.TypeOwner = t.checker.id
+	}
+	r.ObjectFlags = t.objectFlags
+	return r
+}
+func (c *Checker) memberCompletionView(t *Type) memberCompletionView {
+	r := c.memberCompletionRow(t)
+	d := t.AsStructuredType()
+	v := memberCompletionView{Epoch: len(r.Publications), ActiveDepth: r.ActiveDepth,
+		Resolved:   t.objectFlags&ObjectFlagsMembersResolved != 0,
+		Unresolved: t.objectFlags&ObjectFlagsUnresolvedMembers != 0,
+		Calls:      d.callSignatureCount, Constructs: len(d.signatures) - d.callSignatureCount,
+		Indexes: len(d.indexInfos), Names: []string{}}
+	for _, prop := range d.properties {
+		v.Names = append(v.Names, prop.Name)
+	}
+	return v
+}
+func (c *Checker) memberCompletionEnterQuery(t *Type) {
+	r := c.memberCompletionRow(t)
+	r.Queries++
+	if t.objectFlags&ObjectFlagsMembersResolved != 0 {
+		if r.ActiveDepth != 0 {
+			r.ActiveFlagHits++
+		} else {
+			r.FinalFlagHits++
+		}
+		if t.objectFlags&ObjectFlagsUnresolvedMembers != 0 {
+			r.UnresolvedFlagHits++
+		}
+	} else if r.ActiveDepth != 0 {
+		r.ActiveMisses++
+	}
+}
+func (c *Checker) memberCompletionReturnQuery(t *Type) {
+	r := c.memberCompletionRow(t)
+	v := c.memberCompletionView(t)
+	q := memberCompletionReturn{Epoch: v.Epoch, Active: r.ActiveDepth != 0,
+		Resolved: v.Resolved, Unresolved: v.Unresolved, Properties: len(v.Names), Count: 1}
+	if len(r.Returns) > 0 {
+		last := &r.Returns[len(r.Returns)-1]
+		if last.Epoch == q.Epoch && last.Active == q.Active && last.Resolved == q.Resolved && last.Unresolved == q.Unresolved && last.Properties == q.Properties {
+			last.Count++
+			return
+		}
+	}
+	r.Returns = append(r.Returns, q)
+}
+func (c *Checker) memberCompletionBegin(t *Type, kind string) func() {
+	r := c.memberCompletionRow(t)
+	r.Workers[kind]++
+	r.ActiveDepth++
+	return func() { r.ActiveDepth--; r.FinalView = c.memberCompletionView(t) }
+}
+func (c *Checker) memberCompletionPublish(t *Type) {
+	r := c.memberCompletionRow(t)
+	v := c.memberCompletionView(t)
+	v.Epoch++
+	r.Publications = append(r.Publications, v)
+}
+func (c *Checker) memberCompletionReference(t, target *Type, parameters, arguments, padded []*Type) {
+	ids := func(types []*Type) []TypeId {
+		result := make([]TypeId, len(types))
+		for i, t := range types {
+			result[i] = t.id
+		}
+		return result
+	}
+	r := c.memberCompletionRow(t)
+	r.References = append(r.References, memberCompletionReference{target.id, ids(parameters), ids(arguments), ids(padded), len(padded) > len(arguments)})
+}
+func (c *Checker) memberCompletionKey(t *Type, key PropertiesTypesKey) {
+	r := c.memberCompletionRow(t)
+	r.KeyRequests = append(r.KeyRequests, memberCompletionKey{key.include, key.includeOrigin, key.unresolvedMembers, r.ActiveDepth != 0})
+}
+func (c *Checker) memberCompletionReset(t *Type) {
+	r := c.memberCompletionRow(t)
+	r.ResetCalls++
+	if t.objectFlags&ObjectFlagsMembersResolved != 0 {
+		r.ResolvedResets++
+	}
+}
+func (c *Checker) memberCompletionDump(file string) {
+	rows := make([]*memberCompletionRow, 0, len(c.memberCompletionProbe.rows))
+	for t, r := range c.memberCompletionProbe.rows {
+		r.ObjectFlags = t.objectFlags
+		rows = append(rows, r)
+	}
+	slices.SortFunc(rows, func(a, b *memberCompletionRow) int { return int(a.ID) - int(b.ID) })
+	data, err := json.Marshal(struct {
+		Owner uint32                 `json:"owner"`
+		File  string                 `json:"file"`
+		Rows  []*memberCompletionRow `json:"rows"`
+	}{c.id, file, rows})
+	if err != nil {
+		panic(err)
+	}
+	fmt.Fprintf(os.Stderr, "MEMBER_COMPLETION %s\n", data)
+}
