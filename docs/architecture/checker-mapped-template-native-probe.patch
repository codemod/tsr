@@ -0,0 +1,61 @@
+package checker
+
+import (
+	"encoding/json"
+	"fmt"
+	"github.com/microsoft/typescript-go/internal/ast"
+	"os"
+	"sync"
+)
+
+var literalProbeEnabled = os.Getenv("TSR_NATIVE_LITERAL_PROBE") == "1"
+var literalProbeData = struct {
+	sync.Mutex
+	Counters map[*Checker]*[22]uint64
+	Files    map[string]uint64
+}{}
+
+func literalProbe(c *Checker, index int, value uint64) {
+	if !literalProbeEnabled {
+		return
+	}
+	literalProbeData.Lock()
+	defer literalProbeData.Unlock()
+	if literalProbeData.Counters == nil {
+		literalProbeData.Counters = make(map[*Checker]*[22]uint64)
+	}
+	d := literalProbeData.Counters[c]
+	if d == nil {
+		d = new([22]uint64)
+		literalProbeData.Counters[c] = d
+	}
+	d[index] += value
+}
+func literalProbeChecked(c *Checker, file *ast.SourceFile) {
+	if !literalProbeEnabled {
+		return
+	}
+	literalProbe(c, 13, 1)
+	literalProbeData.Lock()
+	defer literalProbeData.Unlock()
+	if literalProbeData.Files == nil {
+		literalProbeData.Files = make(map[string]uint64)
+	}
+	literalProbeData.Files[file.FileName()]++
+}
+func ReportLiteralProbe() {
+	if !literalProbeEnabled {
+		return
+	}
+	literalProbeData.Lock()
+	defer literalProbeData.Unlock()
+	rows := make([]*[22]uint64, 0, len(literalProbeData.Counters))
+	for _, d := range literalProbeData.Counters {
+		rows = append(rows, d)
+	}
+	payload, err := json.Marshal(map[string]any{"checkers": rows, "checked_files": literalProbeData.Files})
+	if err != nil {
+		panic(err)
+	}
+	fmt.Fprintf(os.Stderr, "TSR_NATIVE_LITERAL_PROBE\t%s\n", payload)
+}
