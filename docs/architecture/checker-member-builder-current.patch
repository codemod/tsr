+    // Native resolveDeclaredMembers publishes the declaration table before
+    // preparing signature/index fields. The Rust binder lacks __call/__new
+    // symbols, so their existing declaration signature owner supplies them.
+    fn publication_declared_fields(&mut self,owner:SymbolId) -> Option<StructuredFields> {
+        if let Some(fields)=self.member_publication.declared.get(&owner) {return fields.clone();}
+        let own:Vec<_>=self.binder.symbols().get(owner).members.as_ref().map(|members|members.iter().map(|(name,&symbol)|(name.to_string(),symbol)).collect()).unwrap_or_default();
+        let mut fields=StructuredFields::default();
+        for (name,symbol) in own {
+            if self.symbol_is_value(symbol) {fields.members.insert(name,self.symbols.bound(symbol).unwrap());}
+        }
+        self.member_publication.declared.insert(owner,Some(fields.clone()));
+        let finished=(|| {
+        // getMembersOfSymbol includes the existing late-bound semantic table.
+        // Use its canonical resolver and declaration symbol, so computed names
+        // stay actual suppliers rather than being reconstructed by a getter.
+        for (name,declaration) in self.late_bound_members_of(owner,false) {
+            if let Some(symbol)=self.binder.symbol_of(declaration) {
+                fields.members.entry(name).or_insert(self.symbols.bound(symbol).unwrap());
+            }
+        }
+        let declarations=self.binder.symbols().get(owner).declarations.to_vec();
+        for declaration in declarations {
+            match self.node_map.get(declaration) {
+                Some(Node::InterfaceDeclaration(node)) => {
+                    for member in node.members {
+                        match member {
+                            TypeElement::CallSignatureDeclaration(node) => fields.calls.push(self.get_signature_from_declaration(node.node_id?)?),
+                            TypeElement::ConstructSignatureDeclaration(node) => fields.constructs.push(self.get_signature_from_declaration(node.node_id?)?),
+                            TypeElement::IndexSignatureDeclaration(node) => fields.indexes.extend(self.index_infos_of_declaration(node)),
+                            _=>{},
+                        }
+                    }
+                }
+                Some(Node::ClassDeclaration(node)) => {
+                    for member in node.members {
+                        if let tsr_ast::ClassElement::IndexSignatureDeclaration(node)=member
+                            && !tsr_ast::has_syntactic_modifier(node.modifiers,tsr_ast::SyntaxKind::StaticKeyword) {
+                            fields.indexes.extend(self.index_infos_of_declaration(node));
+                        }
+                    }
+                }
+                Some(Node::ClassExpression(node)) => {
+                    for member in node.members {
+                        if let tsr_ast::ClassElement::IndexSignatureDeclaration(node)=member
+                            && !tsr_ast::has_syntactic_modifier(node.modifiers,tsr_ast::SyntaxKind::StaticKeyword) {
+                            fields.indexes.extend(self.index_infos_of_declaration(node));
+                        }
+                    }
+                }
+                _=>{},
+            }
+        }
+        Some(fields)
+        })();
+        self.member_publication.declared.insert(owner,finished.clone());
+        finished
+    }
