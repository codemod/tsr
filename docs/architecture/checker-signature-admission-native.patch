+package checker
+
+import (
+	"fmt"
+	"github.com/microsoft/typescript-go/internal/ast"
+	"sync"
+)
+
+// A test-only observer on a fresh pinned archive. Event snapshots read fields
+// and the actual resolution stack; they never ask another semantic question.
+type nativeAdmissionTrace struct{ events []map[string]any }
+
+var nativeAdmissionTraces sync.Map
+
+func nativeAdmissionEvent(c *Checker, event string, t *Type, sig *Signature) {
+	v, ok := nativeAdmissionTraces.Load(c)
+	if !ok {
+		return
+	}
+	row := map[string]any{"event": event, "checker": fmt.Sprintf("%p", c), "resolution_depth": len(c.typeResolutions)}
+	if t != nil {
+		row["type_id"] = uint32(t.id)
+		row["object_flags"] = uint32(t.objectFlags)
+		if t.flags&TypeFlagsObject != 0 {
+			row["members_resolved"] = t.objectFlags&ObjectFlagsMembersResolved != 0
+			row["signature_count"] = len(t.AsStructuredType().signatures)
+		}
+		if t.symbol != nil {
+			row["symbol"] = t.symbol.Name
+		}
+	}
+	if sig != nil {
+		row["signature_id"] = uint32(sig.id)
+		row["return_resolved"] = sig.resolvedReturnType != nil
+		active := false
+		for _, r := range c.typeResolutions {
+			if r.target == sig && r.propertyName == TypeSystemPropertyNameResolvedReturnType {
+				active = true
+			}
+		}
+		row["return_active"] = active
+		row["has_target"] = sig.target != nil
+		if sig.declaration != nil && sig.declaration.Name() != nil {
+			row["declaration"] = sig.declaration.Name().Text()
+		}
+	}
+	trace := v.(*nativeAdmissionTrace)
+	trace.events = append(trace.events, row)
+}
+
+func (c *Checker) NativeAdmissionContract(fn, owner *ast.Node, order, mapperKind string) map[string]any {
+	trace := &nativeAdmissionTrace{}
+	nativeAdmissionTraces.Store(c, trace)
+	defer nativeAdmissionTraces.Delete(c)
+	t := c.getTypeOfSymbol(c.getMergedSymbol(fn.Symbol()))
+	state := func(t *Type) map[string]any {
+		d := t.AsStructuredType()
+		returns := []bool{}
+		for _, s := range d.signatures {
+			returns = append(returns, s.resolvedReturnType != nil)
+		}
+		return map[string]any{"type_id": uint32(t.id), "members_resolved": t.objectFlags&ObjectFlagsMembersResolved != 0, "signature_count": len(d.signatures), "returns_resolved": returns}
+	}
+	var signatures []*Signature
+	if order == "signatures-first" || order == "return-first" {
+		signatures = c.getSignaturesOfType(t, SignatureKindCall)
+	}
+	if order == "return-first" {
+		for _, s := range signatures {
+			c.getReturnTypeOfSignature(s)
+		}
+	}
+	before := state(t)
+	var mapper *TypeMapper
+	switch mapperKind {
+	case "this-only":
+		d := c.getDeclaredTypeOfClassOrInterface(c.getMergedSymbol(owner.Symbol()))
+		mapper = newTypeMapper([]*Type{d.AsInterfaceType().thisType}, []*Type{d})
+	case "outer-number", "outer-no-op":
+		ps := c.getOuterTypeParameters(fn, true)
+		args := make([]*Type, len(ps))
+		for i, p := range ps {
+			args[i] = c.numberType
+			if mapperKind == "outer-no-op" {
+				args[i] = p
+			}
+		}
+		mapper = newTypeMapper(ps, args)
+	case "nil":
+	default:
+		panic(mapperKind)
+	}
+	start := len(trace.events)
+	image := c.instantiateTypeWithAlias(t, mapper, nil)
+	afterMap := state(image)
+	originalAfterMap := state(t)
+	mapEvents := append([]map[string]any{}, trace.events[start:]...)
+	repeated := c.instantiateTypeWithAlias(t, mapper, nil)
+	signatures = c.getSignaturesOfType(image, SignatureKindCall)
+	afterSignatures := state(image)
+	returnTypes := []string{}
+	returnError := []bool{}
+	targets := []bool{}
+	ownParameters := []int{}
+	for _, sig := range signatures {
+		targets = append(targets, sig.target != nil)
+		ownParameters = append(ownParameters, len(sig.typeParameters))
+		ret := c.getReturnTypeOfSignature(sig)
+		returnTypes = append(returnTypes, c.TypeToString(ret))
+		returnError = append(returnError, ret == c.errorType)
+	}
+	beforeWarm := len(trace.events)
+	repeatedSignatures := c.getSignaturesOfType(image, SignatureKindCall)
+	for _, sig := range repeatedSignatures {
+		c.getReturnTypeOfSignature(sig)
+	}
+	warmEvents := append([]map[string]any{}, trace.events[beforeWarm:]...)
+	return map[string]any{"checker": fmt.Sprintf("%p", c), "before": before, "after_map": afterMap, "original_after_map": originalAfterMap, "after_signatures": afterSignatures, "after_returns": state(image), "same_identity": image == t, "repeat_same_identity": repeated == image, "return_types": returnTypes, "return_error": returnError, "signature_targets": targets, "own_parameter_counts": ownParameters, "map_events": mapEvents, "warm_events": warmEvents, "all_events": trace.events}
+}
