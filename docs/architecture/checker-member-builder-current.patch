+//! Isolated structured-member experiment. Broader native metadata and fidelity
+//! remain unqualified; natural field publication is tested separately.
+use crate::{Checker, TypeId};
+use crate::flags::TypeFlags;
+use crate::types::TypeData;
+use crate::symbol_access::{CheckFlags, SymbolRef};
+use rustc_hash::FxHashMap;
+use tsr_binder::{SymbolFlags, SymbolId};
+use crate::signatures::Signature;
+use crate::index_signatures::IndexInfo;
+use tsr_ast::{Node, TypeElement};
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) enum MemberQuery {
+    Published { symbol:SymbolRef, revision:u64, active:bool },
+    Absent { revision:u64, active:bool },
+    Unsupported,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+struct ImageKey { ty:TypeId, receiver:TypeId }
+
+#[derive(Clone, Default)]
+struct StructuredFields {
+    members:FxHashMap<String,SymbolRef>,
+    calls:Vec<Signature>,
+    constructs:Vec<Signature>,
+    indexes:Vec<IndexInfo>,
+}
+
+#[derive(Default)]
+struct PropertyImage {
+    members:FxHashMap<String,SymbolRef>,
+    calls:Vec<Signature>,
+    constructs:Vec<Signature>,
+    indexes:Vec<IndexInfo>,
+    published:bool,
+    inheritance_active:bool,
+    frames:Vec<u64>,
+    revision:u64,
+    done:bool,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct MapperId(pub(crate) usize);
+
+#[derive(Clone)]
+struct MapperOperation {
+    owner:TypeId,
+    receiver:TypeId,
+    prior:Option<MapperId>,
+}
+
+#[derive(Clone, Default)]
+pub(crate) struct MemberLinks {
+    pub(crate) target:Option<SymbolRef>,
+    pub(crate) mapper:Option<MapperId>,
+    pub(crate) read:Option<TypeId>,
+    pub(crate) write:Option<TypeId>,
+    pub(crate) containing:Option<TypeId>,
+}
+
+#[derive(Default)]
+pub(crate) struct MemberPublication {
+    images:FxHashMap<ImageKey,PropertyImage>,
+    declared:FxHashMap<SymbolId,Option<StructuredFields>>,
+    pub(crate) links:FxHashMap<SymbolRef,MemberLinks>,
+    mappers:Vec<MapperOperation>,
+    composites:FxHashMap<(TypeId,TypeId,String),SymbolRef>,
+    apparent:FxHashMap<TypeId,TypeId>,
+    references:FxHashMap<(SymbolId,Vec<TypeId>),TypeId>,
+    reduced:FxHashMap<TypeId,bool>,
+    #[cfg(test)]
+    pub(crate) base_reentries:Vec<(SymbolId,Vec<TypeId>,bool)>,
+    #[cfg(test)]
+    pub(crate) member_entries:Vec<(SymbolId,TypeId)>,
+    #[cfg(test)]
+    pub(crate) target_resets:Vec<(SymbolId,TypeId,usize,bool)>,
+    #[cfg(test)]
+    pub(crate) field_events:Vec<(String,SymbolId,TypeId,bool,bool,usize,Vec<String>,usize,usize,usize)>,
+}
+
+#[cfg(test)]
+mod structured_field_tests {
+    use super::ImageKey;
+    use tsr_ast::HasNodeId;
+
+
+
+    #[test]
+    fn contextual_inherited_callback_reads_published_member_type() {
+        let source="interface Base<T>{a:(x:T)=>T} interface Child<U> extends Base<U>{} const probe:Child<number>={a:x=>{const n:number=x;return x;}};";
+        for order in ["cold","typed-reader-first","checked-first"] {
+            let arena=tsr_core::Arena::new();
+            let parsed=tsr_parser::parse(&arena,source);
+            assert!(parsed.diagnostics.is_empty());
+            let bound=tsr_binder::bind(&arena,parsed.source_file,&parsed.nodes,tsr_binder::FileInfo {name:"test.ts",text:source});
+            let root=parsed.source_file.node_id().unwrap();
+            let mut checker=crate::Checker::new(&bound,&parsed.nodes,&parsed.node_map);
+            if order=="typed-reader-first" {
+                let probe=checker.binder.lookup_local(root,"probe").unwrap();
+                let context=checker.get_type_of_symbol(probe);
+                let member=checker.get_type_of_property_of_type(context,"a").unwrap();
+                let signatures=checker.call_signatures_of_type(member).unwrap();
+                assert_eq!(checker.parameter_type(&signatures[0].parameters[0]),checker.intrinsics.number,"the ordinary typed reader already preserves the inherited mapper");
+            }
+            checker.check_source_file(root,crate::check::FileContext {ambient:false,has_parse_errors:false});
+            assert!(checker.diagnostics().is_empty(),"{order}: native accepts the contextual callback: {:?}",checker.diagnostics());
+            if order=="checked-first" {
+                checker.check_source_file(root,crate::check::FileContext {ambient:false,has_parse_errors:false});
+                assert!(checker.diagnostics().is_empty(),"warm source check preserves the contextual read");
+            }
+        }
+    }
+
+    #[test]
+    fn this_argument_admission_preserves_thisless_interfaces() {
+        let source="interface Plain {value:number} interface DerivedPlain extends Plain {own:boolean} interface Self {self:this} interface Generic<T> {value:T} declare class Box {value:number} declare const plain:Plain; declare const derived:DerivedPlain; declare const selfValue:Self; declare const generic:Generic<number>; declare const box:Box; declare const whole:Plain & Self;";
+        for (name, changes) in [("plain",false),("derived",false),("selfValue",true),("generic",true),("box",true)] {
+            for order in ["cold","checked-first","warm"] {
+                let arena=tsr_core::Arena::new();
+                let parsed=tsr_parser::parse(&arena,source);
+                assert!(parsed.diagnostics.is_empty());
+                let bound=tsr_binder::bind(&arena,parsed.source_file,&parsed.nodes,tsr_binder::FileInfo {name:"test.ts",text:source});
+                let root=parsed.source_file.node_id().unwrap();
+                let mut checker=crate::Checker::new(&bound,&parsed.nodes,&parsed.node_map);
+                if order=="checked-first" {checker.check_source_file(root,crate::check::FileContext {ambient:false,has_parse_errors:false});}
+                let symbol=checker.binder.lookup_local(root,name).unwrap();
+                let whole=checker.binder.lookup_local(root,"whole").unwrap();
+                let ty=checker.get_type_of_symbol(symbol);
+                let receiver=checker.get_type_of_symbol(whole);
+                if order=="warm" {let _=checker.publication_with_this(ty,receiver);}
+                let mapped=checker.publication_with_this(ty,receiver);
+                assert_eq!(mapped!=ty,changes,"{name}/{order}: native reference admission is required before adding a this argument");
+                assert_eq!(checker.publication_with_this(mapped,receiver),mapped,"explicit final argument is retained");
+                if changes {
+                    let (_,args)=checker.type_reference_targets.get(&mapped).unwrap();
+                    assert_eq!(args.last(),Some(&receiver));
+                }
+            }
+        }
+    }
