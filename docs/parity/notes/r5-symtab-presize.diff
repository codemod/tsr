+/// Upper-bound-ish counts of what a container's children declare, read off
+/// the container node's own lists (`r5-symtab.md` §5). Zero means "no hint":
+/// the table grows as it always did.
+#[derive(Clone, Copy, Default)]
+struct TableHints {
+    members: usize,
+    exports: usize,
+    locals: usize,
+}
+
+impl TableHints {
+    fn of(node: Node<'_>) -> Self {
+        fn body(body: Option<&tsr_ast::Block<'_>>) -> usize {
+            body.map_or(0, |block| block.statements.len())
+        }
+        let members = |members| Self { members, ..Self::default() };
+        let locals = |locals| Self { locals, ..Self::default() };
+        match node {
+            Node::SourceFile(file) => locals(file.statements.len()),
+            Node::Block(block) => locals(block.statements.len()),
+            Node::ModuleBlock(block) => locals(block.statements.len()),
+            Node::ModuleDeclaration(module) => match module.body {
+                Some(tsr_ast::ModuleBody::ModuleBlock(block)) => {
+                    let n = block.statements.len();
+                    Self { exports: n, locals: n, ..Self::default() }
+                }
+                _ => Self::default(),
+            },
+            Node::ClassDeclaration(class) => {
+                members(class.members.len() + class.type_parameters.len())
+            }
+            Node::ClassExpression(class) => {
+                members(class.members.len() + class.type_parameters.len())
+            }
+            Node::InterfaceDeclaration(interface) => {
+                members(interface.members.len() + interface.type_parameters.len())
+            }
+            Node::TypeLiteralNode(literal) => members(literal.members.len()),
+            Node::ObjectLiteralExpression(literal) => members(literal.properties.len()),
+            Node::JsxAttributes(attributes) => members(attributes.properties.len()),
+            Node::EnumDeclaration(declaration) => {
+                Self { exports: declaration.members.len(), ..Self::default() }
+            }
+            Node::FunctionDeclaration(f) => locals(
+                f.type_parameters.len()
+                    + f.parameters.len()
+                    + body(f.body.map(|tsr_ast::FunctionBody::Block(b)| b)),
+            ),
+            Node::FunctionExpression(f) => locals(
+                f.type_parameters.len()
+                    + f.parameters.len()
+                    + body(f.body.map(|tsr_ast::FunctionBody::Block(b)| b)),
+            ),
+            Node::MethodDeclaration(f) => locals(
+                f.type_parameters.len()
+                    + f.parameters.len()
+                    + body(f.body.map(|tsr_ast::FunctionBody::Block(b)| b)),
+            ),
+            Node::ConstructorDeclaration(f) => locals(
+                f.type_parameters.len()
+                    + f.parameters.len()
+                    + body(f.body.map(|tsr_ast::FunctionBody::Block(b)| b)),
+            ),
+            Node::GetAccessorDeclaration(f) => locals(
+                f.type_parameters.len()
+                    + f.parameters.len()
+                    + body(f.body.map(|tsr_ast::FunctionBody::Block(b)| b)),
+            ),
+            Node::SetAccessorDeclaration(f) => locals(
+                f.type_parameters.len()
+                    + f.parameters.len()
+                    + body(f.body.map(|tsr_ast::FunctionBody::Block(b)| b)),
+            ),
+            Node::ArrowFunction(f) => locals(
+                f.type_parameters.len()
+                    + f.parameters.len()
+                    + body(match f.body {
+                        Some(tsr_ast::ConciseBody::Block(b)) => Some(b),
+                        _ => None,
+                    }),
+            ),
+            _ => Self::default(),
+        }
+    }
+}
