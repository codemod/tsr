+#[cfg(test)]
+mod private_owner_naming_tests {
+    use super::*;
+
+    #[test]
+    fn private_best_name_rejects_same_named_distinct_copies() {
+        let source = "class C {} const reference = C;";
+        let arena = tsr_core::Arena::new();
+        let parsed = tsr_parser::parse(&arena, source);
+        let bound = tsr_binder::bind(
+            &arena,
+            parsed.source_file,
+            &parsed.nodes,
+            tsr_binder::FileInfo { name: "owner.ts", text: source },
+        );
+        let class = bound
+            .symbols()
+            .iter()
+            .find(|(_, entry)| entry.name == "C" && entry.flags.contains(SymbolFlags::CLASS))
+            .unwrap()
+            .0;
+        let root = parsed.source_file.node_id.unwrap();
+        let mut checker = Checker::new(&bound, &parsed.nodes, &parsed.node_map);
+        let raw = checker.symbols.bound(bound.merged_symbol(class)).unwrap();
+        let head = checker.symbols.clone_module_symbol(&raw).unwrap();
+        let twin = checker.symbols.clone_module_symbol(&raw).unwrap();
+        for _ in 0..3 {
+            assert_eq!(
+                checker
+                    .best_name_ref(
+                        &checker.symbols.bound(class).expect("bound test declaration"),
+                        root
+                    )
+                    .as_deref(),
+                Some("C")
+            );
+            assert_eq!(checker.best_name_ref(&raw, root).as_deref(), Some("C"));
+            assert_eq!(checker.best_name_ref(&head, root), None);
+            assert_eq!(checker.best_name_ref(&twin, root), None);
+        }
+    }
+
