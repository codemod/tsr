+    /// A `@typedef`/`@callback` alias. Native reparses it into a
+    /// `JSTypeAliasDeclaration`; at the top level of a JS module (ES or
+    /// CommonJS) bindBlockScopedDeclaration reaches declareModuleMember, whose
+    /// `hasExportModifier` admits IsImplicitlyExportedJSDocDeclaration
+    /// (`ast/utilities.go:4184`, `binder.go:375`): the alias is an export of
+    /// the module, with a local export marker, exactly as a written exported
+    /// type alias is (`import("./a").Foo` resolves it). Anywhere else it is a
+    /// block-scoped local (`r6-declared.md` §6).
+    fn declare_jsdoc_type_alias(
+        &mut self,
+        scope: NodeId,
+        root: NodeId,
+        name: &'a str,
+        declaration: NodeId,
+    ) {
+        let module = (scope == root && (self.is_module || self.commonjs_module))
+            .then_some(self.module_symbol)
+            .flatten();
+        let Some(module) = module else {
+            self.declare_jsdoc_symbol(scope, name, SymbolFlags::TYPE_ALIAS, declaration);
+            return;
+        };
+        let flags = SymbolFlags::TYPE_ALIAS;
+        let local = self.declare_into_with_excludes(
+            Destination::Locals,
+            root,
+            Some(module),
+            name,
+            SymbolFlags::empty(),
+            flags.excludes(),
+            declaration,
+        );
+        let exported =
+            self.declare_into(Destination::Exports, root, Some(module), name, flags, declaration);
+        self.symbols.get_mut(local).export_symbol = Some(exported);
+        self.node_symbols[declaration.index() - self.node_base] = Some(exported);
+    }
