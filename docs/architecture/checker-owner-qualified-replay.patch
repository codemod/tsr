+        ),
+    ] {
+        let arena = Arena::new();
+        let fixture = program(&arena, &[("m", library), ("main", client)]);
+        let root = fixture.host.files[1].1;
+        let x = fixture.bound.lookup_local(root, "x").unwrap();
+        for check_first in [false, true] {
+            let mut checker = Checker::with_module_host(
+                &fixture.bound,
+                &fixture.nodes,
+                &fixture.node_map,
