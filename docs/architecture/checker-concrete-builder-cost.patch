+
+// Private locating observer. No counter or key supplies a semantic answer.
+pub(crate) struct ConstructionCost {
+    pub(crate) enabled: bool,
+    pub(crate) timed: bool,
+    pub(crate) depth: usize,
+    pub(crate) calls: u64,
+    pub(crate) roots: u64,
+    pub(crate) hits: u64,
+    pub(crate) mints: u64,
+    pub(crate) declared_mints: u64,
+    pub(crate) root_ns: u128,
+    pub(crate) declared_ns: u128,
+    pub(crate) mint_keys: FxHashMap<(SymbolId, Vec<TypeId>), u64>,
+    pub(crate) declared_keys: FxHashMap<SymbolId, u64>,
+    pub(crate) overflow: u64,
+}
+impl ConstructionCost {
+    fn new() -> Self {
+        let mode = std::env::var("TSR_CONSTRUCTION_COST").ok();
+        Self { enabled: matches!(mode.as_deref(), Some("count" | "time")),
+            timed: mode.as_deref() == Some("time"), depth: 0, calls: 0, roots: 0,
+            hits: 0, mints: 0, declared_mints: 0, root_ns: 0, declared_ns: 0,
+            mint_keys: FxHashMap::default(), declared_keys: FxHashMap::default(), overflow: 0 }
+    }
+    pub(crate) fn minted(&mut self, symbol: SymbolId, arguments: &[TypeId]) {
+        self.mints += 1;
+        let key = (symbol, arguments.to_vec());
+        if let Some(count) = self.mint_keys.get_mut(&key) { *count += 1; }
+        else if self.mint_keys.len() < 100_000 { self.mint_keys.insert(key, 1); }
+        else { self.overflow += 1; }
+    }
+    pub(crate) fn declared(&mut self, symbol: SymbolId) {
+        self.declared_mints += 1;
+        if let Some(count) = self.declared_keys.get_mut(&symbol) { *count += 1; }
+        else if self.declared_keys.len() < 100_000 { self.declared_keys.insert(symbol, 1); }
+        else { self.overflow += 1; }
+    }
+}
+impl Drop for ConstructionCost {
+    fn drop(&mut self) {
+        if self.enabled {
+            // Keys stay inside one checker; only aggregate counts leave it.
+            let repeated = self.mint_keys.values().map(|n| n - 1).sum::<u64>();
+            let declared_repeated = self.declared_keys.values().map(|n| n - 1).sum::<u64>();
+            eprintln!("CONSTRUCTION_COST {{\"timed\":{},\"calls\":{},\"roots\":{},\"existing_cache_hits\":{},\"reference_mints\":{},\"reference_keys\":{},\"repeated_reference_mints\":{},\"declared_mints\":{},\"declared_keys\":{},\"repeated_declared_mints\":{},\"root_ns\":{},\"declared_ns\":{},\"overflow\":{}}}",
+                self.timed, self.calls, self.roots, self.hits, self.mints, self.mint_keys.len(), repeated,
+                self.declared_mints, self.declared_keys.len(), declared_repeated, self.root_ns, self.declared_ns, self.overflow);
+        }
+    }
+}
