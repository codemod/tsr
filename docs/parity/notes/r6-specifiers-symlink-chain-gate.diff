+    /// `computeModuleSpecifiers`' `importedFileIsInNodeModules` (`:400`) for
+    /// `module`'s source file seen from `reference`'s: whether a symlinked
+    /// path reaching it runs through `node_modules`. `symbol_chain`'s
+    /// `node_modules` arm reads it for a module whose own (real) path is
+    /// outside any `node_modules` (a workspace package linked into one).
+    pub(crate) fn module_has_symlinked_node_modules_path(
+        &self,
+        module: tsr_binder::SymbolId,
+        reference: NodeId,
+    ) -> bool {
+        let Some(symlinks) = self.known_symlinks() else { return false };
+        let Some(host) = self.module_host else { return false };
+        let Some(module_file) =
+            self.binder.symbols().get(module).declarations.iter().copied().find(|&declaration| {
+                self.nodes.kind(declaration) == tsr_ast::SyntaxKind::SourceFile
+            })
+        else {
+            return false;
+        };
+        let (Some(from), Some(to)) = (
+            self.source_file_of(reference).and_then(|file| host.file_path(file)),
+            host.file_path(module_file),
+        ) else {
+            return false;
+        };
+        each_file_name_of_module(&from, &to, Some(symlinks), "", true)
+            .iter()
+            .any(|path| path.is_in_node_modules)
+    }
