+// Temporary diagnostic module. No production cache or representation changes.
+#![allow(missing_docs)]
+use crate::{Checker, TypeId};
+use std::cell::RefCell;
+use std::sync::OnceLock;
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::time::Instant;
+use tsr_binder::SymbolId;
+
+static COUNTS: [AtomicU64; 48] = [const { AtomicU64::new(0) }; 48];
+std::thread_local! { static LOCAL_COUNTS: std::cell::Cell<[u64;100]> = const { std::cell::Cell::new([0;100]) }; }
+fn local_add(index: usize, value: u64) {
+    LOCAL_COUNTS.with(|local| {
+        let mut values = local.get();
+        values[index] += value;
+        local.set(values);
+    });
+}
+fn local_max(index: usize, value: u64) {
+    LOCAL_COUNTS.with(|local| {
+        let mut values = local.get();
+        values[index] = values[index].max(value);
+        local.set(values);
+    });
+}
+fn predicate_record(index: usize, value: u64) {
+    PREDICATE[index].fetch_add(value, Ordering::Relaxed);
+    local_add(48 + index, value);
+}
+fn reference_record(index: usize, value: u64) {
+    REFERENCE[index].fetch_add(value, Ordering::Relaxed);
+    local_add(56 + index, value);
+}
+
+fn enabled() -> bool {
+    static ENABLED: OnceLock<bool> = OnceLock::new();
+    *ENABLED.get_or_init(|| std::env::var_os("TSR_MAPPER_PROFILE").is_some())
+}
+fn record(site: usize, offset: usize, value: u64) {
+    if enabled() {
+        COUNTS[site * 12 + offset].fetch_add(value, Ordering::Relaxed);
+        local_add(site * 12 + offset, value);
+    }
+}
+type Key = (TypeId, Vec<(TypeId, TypeId)>);
+type Frame = (usize, usize, Key);
+fn table_domain(site: usize) -> usize {
+    usize::from(site == 1)
+}
+std::thread_local! { static ACTIVE: RefCell<Vec<Frame>> = const { RefCell::new(Vec::new()) }; }
+fn active(owner: usize, site: usize, key: &Key) -> bool {
+    ACTIVE.with(|s| {
+        s.borrow().iter().any(|(live_owner, domain, k)| {
+            *live_owner == owner && *domain == table_domain(site) && k == key
+        })
+    })
+}
+
+static PREDICATE: [AtomicU64; 8] = [const { AtomicU64::new(0) }; 8];
+pub fn predicate_key(id: TypeId, parameters: &[TypeId], top_level: bool) -> (TypeId, Vec<TypeId>) {
+    if enabled() {
+        predicate_record(usize::from(!top_level), 1);
+        predicate_record(if top_level { 2 } else { 3 }, parameters.len() as u64);
+    }
+    let start = enabled().then(Instant::now);
+    let key = {
+        let _scope = allocation::enter(if top_level { 5 } else { 6 });
+        (id, parameters.to_vec())
+    };
+    if let Some(start) = start {
+        predicate_record(
+            4,
+            u64::try_from(start.elapsed().as_nanos())
+                .expect("probe interval exceeds u64 nanoseconds"),
+        );
+    }
+    key
+}
+pub fn predicate_hit() {
+    if enabled() {
+        predicate_record(5, 1);
+    }
+}
+pub fn predicate_worker(top_level: bool) {
+    if enabled() {
+        predicate_record(if top_level { 6 } else { 7 }, 1);
+    }
+}
+
+pub fn key(site: usize, id: TypeId, map: &[(TypeId, TypeId)]) -> Key {
+    let start = enabled().then(Instant::now);
+    record(site, 0, 1);
+    record(site, 1, map.len() as u64);
+    if enabled() {
+        COUNTS[site * 12 + 2].fetch_max(map.len() as u64, Ordering::Relaxed);
+        local_max(site * 12 + 2, map.len() as u64);
+    }
+    let key = {
+        let _scope = allocation::enter(site + 1);
+        (id, map.to_vec())
+    };
+    if let Some(start) = start {
+        record(
+            site,
+            3,
+            u64::try_from(start.elapsed().as_nanos())
+                .expect("probe interval exceeds u64 nanoseconds"),
+        );
+    }
+    key
+}
+pub fn lookup_start() -> Option<Instant> {
+    enabled().then(Instant::now)
+}
+pub fn lookup(
+    site: usize,
+    owner: usize,
+    key: &Key,
+    result: Option<TypeId>,
+    error: TypeId,
+    start: Option<Instant>,
+) {
+    if let Some(start) = start {
+        record(
+            site,
+            4,
+            u64::try_from(start.elapsed().as_nanos())
+                .expect("probe interval exceeds u64 nanoseconds"),
+        );
+    }
+    match result {
+        None => record(site, 8, 1),
+        Some(value) => {
+            let active = enabled() && active(owner, site, key);
+            record(
+                site,
+                if active {
+                    5
+                } else if value == error {
+                    7
+                } else {
+                    6
+                },
+                1,
+            );
+        }
+    }
+}
+pub struct Worker {
+    site: usize,
+    start: Option<Instant>,
+    success: bool,
+}
+impl Worker {
+    pub fn enter(site: usize, owner: usize, key: &Key) -> Self {
+        // Pointer values identify only overlapping method frames. They never
+        // dereference storage, resolve a type or survive this worker's Drop.
+        // Exact ordered keys separate contexts within the same live checker.
+        if enabled() {
+            ACTIVE.with(|s| s.borrow_mut().push((owner, table_domain(site), key.clone())));
+        }
+        Self { site, start: enabled().then(Instant::now), success: false }
+    }
+    pub fn complete(&mut self, success: bool) {
+        self.success = success;
+    }
+}
+impl Drop for Worker {
+    fn drop(&mut self) {
+        if let Some(start) = self.start {
+            record(
+                self.site,
+                9,
+                u64::try_from(start.elapsed().as_nanos())
+                    .expect("probe interval exceeds u64 nanoseconds"),
+            );
+            record(self.site, if self.success { 10 } else { 11 }, 1);
+            ACTIVE.with(|s| {
+                s.borrow_mut().pop().expect("balanced diagnostic worker frames");
+            });
+        }
+    }
+}
+#[must_use]
+pub fn clone_key(key: &Key) -> Key {
+    let _scope = allocation::enter(7);
+    key.clone()
+}
+pub(crate) fn literal_properties(
+    checker: &Checker<'_, '_>,
+    id: TypeId,
+) -> Option<Vec<crate::objects::AnonymousProperty>> {
+    let _scope = allocation::enter(8);
+    checker.anonymous_properties.get(&id).map(|(p, _)| p.clone())
+}
+pub(crate) fn literal_signatures(
+    checker: &Checker<'_, '_>,
+    id: TypeId,
+) -> Option<Vec<crate::signatures::Signature>> {
+    let _scope = allocation::enter(9);
+    checker.signature_types.get(&id).cloned()
+}
+pub fn global_counts() -> Vec<(&'static str, u64)> {
+    let names = [
+        "anonymous_requests",
+        "anonymous_key_items",
+        "anonymous_max_key_items",
+        "anonymous_key_ns",
+        "anonymous_lookup_ns",
+        "anonymous_active_hits",
+        "anonymous_nonactive_hits",
+        "anonymous_nonactive_error_hits",
+        "anonymous_worker_starts",
+        "anonymous_worker_inclusive_ns",
+        "anonymous_worker_successes",
+        "anonymous_worker_failures",
+        "signature_requests",
+        "signature_key_items",
+        "signature_max_key_items",
+        "signature_key_ns",
+        "signature_lookup_ns",
+        "signature_active_hits",
+        "signature_nonactive_hits",
+        "signature_nonactive_error_hits",
+        "signature_worker_starts",
+        "signature_worker_inclusive_ns",
+        "signature_worker_successes",
+        "signature_worker_failures",
+        "mapped_requests",
+        "mapped_key_items",
+        "mapped_max_key_items",
+        "mapped_key_ns",
+        "mapped_lookup_ns",
+        "mapped_active_hits",
+        "mapped_nonactive_hits",
+        "mapped_nonactive_error_hits",
+        "mapped_worker_starts",
+        "mapped_worker_inclusive_ns",
+        "mapped_worker_successes",
+        "mapped_worker_failures",
+        "literal_requests",
+        "literal_key_items",
+        "literal_max_key_items",
+        "literal_key_ns",
+        "literal_lookup_ns",
+        "literal_active_hits",
+        "literal_nonactive_hits",
+        "literal_nonactive_error_hits",
+        "literal_worker_starts",
+        "literal_worker_inclusive_ns",
+        "literal_worker_successes",
+        "literal_worker_failures",
+    ];
+    let mut counts: Vec<_> =
+        names.into_iter().zip(COUNTS.iter().map(|v| v.load(Ordering::Relaxed))).collect();
+    counts.extend(
+        [
+            "predicate_top_requests",
+            "predicate_unused_nested_keys",
+            "predicate_top_key_items",
+            "predicate_unused_nested_key_items",
+            "predicate_key_ns",
