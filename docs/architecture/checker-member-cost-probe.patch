diff --git a/crates/tsr-checker/src/member_query_profile.rs b/crates/tsr-checker/src/member_query_profile.rs
new file mode 100644
--- /dev/null
+++ b/crates/tsr-checker/src/member_query_profile.rs
@@ -0,0 +1,284 @@
+//! Temporary opt-in observation of one CLI checker's member-name queries.
+#![allow(missing_docs)]
+use crate::TypeId;
+use std::{
+    cell::RefCell,
+    collections::{HashMap, HashSet},
+    sync::OnceLock,
+};
+use tsr_binder::SymbolId;
+
+#[derive(Default)]
+struct Entry {
+    calls: usize,
+    success: usize,
+    unsupported: usize,
+    active_reentries: usize,
+    risky: usize,
+    repeated_stable: usize,
+    changed: usize,
+    walks: usize,
+    repeated_walks: usize,
+    examined: usize,
+    names: usize,
+    bytes: usize,
+    repeated_bytes: usize,
+    last: Option<Option<Vec<String>>>,
+    path: &'static str,
+    last_guarded: bool,
+}
+struct Frame {
+    id: TypeId,
+    active: bool,
+    risky: bool,
+    walks: usize,
+    examined: usize,
+    path: &'static str,
+}
+#[derive(Default)]
+struct Stats {
+    sites: HashMap<&'static str, [u64; 6]>,
+    entries: HashMap<TypeId, Entry>,
+    paths: HashMap<&'static str, [usize; 6]>,
+    stack: Vec<Frame>,
+    late: HashSet<(SymbolId, bool)>,
+    late_reentries: usize,
+    alias_forces: usize,
+    guard_prunes: usize,
+    failed_bases: usize,
+}
+thread_local! { static STATS: RefCell<Stats> = RefCell::new(Stats::default()); }
+pub fn enabled() -> bool {
+    static ENABLED: OnceLock<bool> = OnceLock::new();
+    *ENABLED.get_or_init(|| std::env::var_os("TSR_PROFILE_MEMBER_QUERIES").is_some())
+}
+pub fn reset() {
+    if enabled() {
+        STATS.with(|s| *s.borrow_mut() = Stats::default());
+    }
+}
+pub fn enter(id: TypeId) {
+    STATS.with(|s| {
+        let mut s = s.borrow_mut();
+        let active = s.stack.iter().any(|f| f.id == id);
+        s.stack.push(Frame {
+            id,
+            active,
+            risky: active,
+            walks: 0,
+            examined: 0,
+            path: "unsupported",
+        });
+    });
+}
+pub fn path(path: &'static str) {
+    if enabled() {
+        STATS.with(|s| {
+            if let Some(f) = s.borrow_mut().stack.last_mut() {
+                f.path = path;
+            }
+        });
+    }
+}
+pub fn walk(examined: usize) {
+    if enabled() {
+        STATS.with(|s| {
+            if let Some(f) = s.borrow_mut().stack.last_mut() {
+                f.walks += 1;
+                f.examined += examined;
+            }
+        });
+    }
+}
+pub fn event(event: &str) {
+    if enabled() {
+        STATS.with(|s| {
+            let mut s = s.borrow_mut();
+            match event {
+                "alias" => s.alias_forces += 1,
+                "cycle" => s.guard_prunes += 1,
+                "base" => s.failed_bases += 1,
+                _ => unreachable!(),
+            }
+            if event != "alias" {
+                if let Some(f) = s.stack.last_mut() {
+                    f.risky = true;
+                }
+            }
+        });
+    }
+}
+pub fn late_hit(owner: SymbolId, is_static: bool) {
+    if enabled() {
+        STATS.with(|s| {
+            let mut s = s.borrow_mut();
+            if s.late.contains(&(owner, is_static)) {
+                s.late_reentries += 1;
+                if let Some(f) = s.stack.last_mut() {
+                    f.risky = true;
+                }
+            }
+        });
+    }
+}
+pub fn late_enter(owner: SymbolId, is_static: bool) {
+    if enabled() {
+        STATS.with(|s| {
+            assert!(s.borrow_mut().late.insert((owner, is_static)));
+        });
+    }
+}
+pub fn late_leave(owner: SymbolId, is_static: bool) {
+    if enabled() {
+        STATS.with(|s| {
+            assert!(s.borrow_mut().late.remove(&(owner, is_static)));
+        });
+    }
+}
+pub fn leave(result: &Option<Vec<String>>) {
+    STATS.with(|s| {
+        let mut s = s.borrow_mut();
+        let f = s.stack.pop().unwrap();
+        if f.risky {
+            if let Some(parent) = s.stack.last_mut() {
+                parent.risky = true;
+            }
+        }
+        let e = s.entries.entry(f.id).or_default();
+        e.calls += 1;
+        e.active_reentries += usize::from(f.active);
+        e.risky += usize::from(f.risky);
+        e.walks += f.walks;
+        e.examined += f.examined;
+        let prior_path = e.path;
+        let bytes = result.as_ref().map_or(0, |v| v.iter().map(String::len).sum::<usize>());
+        if let Some(v) = result {
+            e.success += 1;
+            e.names += v.len();
+            e.bytes += bytes;
+        } else {
+            e.unsupported += 1;
+        }
+        if let Some(last) = &e.last {
+            if last == result
+                && result.is_some()
+                && !f.risky
+                && !f.active
+                && !e.last_guarded
+                && prior_path == f.path
+            {
+                e.repeated_stable += 1;
+                e.repeated_walks += f.walks;
+                e.repeated_bytes += bytes;
+            } else if last != result {
+                e.changed += 1;
+            }
+        }
+        let stable = e.last.as_ref().is_some_and(|last| last == result)
+            && result.is_some()
+            && !f.risky
+            && !f.active
+            && !e.last_guarded
+            && prior_path == f.path;
+        e.last = Some(result.clone());
+        e.path = f.path;
+        e.last_guarded = f.risky || f.active;
+        let p = s.paths.entry(f.path).or_default();
+        p[0] += 1;
+        p[1] += usize::from(result.is_some());
+        p[2] += usize::from(f.risky || f.active);
+        p[3] += usize::from(stable);
+        p[4] += f.walks;
+        p[5] += if stable { f.walks } else { 0 };
+    });
+}
+pub fn report(checker: &crate::Checker<'_, '_>) {
+    if !enabled() {
+        return;
+    }
+    STATS.with(|s| { let s=s.borrow(); assert!(s.stack.is_empty() && s.late.is_empty());
+        for (site, values) in { let mut sites:Vec<_>=s.sites.iter().collect(); sites.sort_by_key(|(site,_)|**site); sites } {
+            eprintln!("MEMBER_SITE {{\"site\":\"{}\",\"requests\":{},\"strings\":{},\"copied_payload_bytes\":{},\"string_capacity_bytes\":{},\"comparisons\":{},\"observed_ns\":{}}}", site, values[0],values[1],values[2],values[3],values[4],values[5]);
+        }
+        let retained_payload:usize=s.entries.values().filter_map(|e|e.last.as_ref()?.as_ref()).map(|v|v.iter().map(String::capacity).sum::<usize>()).sum();
+        let retained_vectors:usize=s.entries.values().filter_map(|e|e.last.as_ref()?.as_ref()).map(|v|v.capacity()*std::mem::size_of::<String>()).sum();
+        eprintln!("MEMBER_OBSERVER {{\"retained_string_capacity\":{},\"retained_vector_capacity_bytes\":{}}}",retained_payload,retained_vectors);
+        let sums=|get: fn(&Entry)->usize| s.entries.values().map(get).sum::<usize>();
+        eprintln!("MEMBER_QUERY {{\"unique_types\":{},\"calls\":{},\"success\":{},\"unsupported\":{},\"active_reentries\":{},\"risky\":{},\"stable_repeats\":{},\"changed_answers\":{},\"walks\":{},\"stable_repeat_walks\":{},\"examined\":{},\"returned_names\":{},\"returned_name_bytes\":{},\"stable_repeat_name_bytes\":{},\"late_reentries\":{},\"alias_force_queries\":{},\"visited_guard_prunes\":{},\"failed_bases\":{}}}",s.entries.len(),sums(|e|e.calls),sums(|e|e.success),sums(|e|e.unsupported),sums(|e|e.active_reentries),sums(|e|e.risky),sums(|e|e.repeated_stable),sums(|e|e.changed),sums(|e|e.walks),sums(|e|e.repeated_walks),sums(|e|e.examined),sums(|e|e.names),sums(|e|e.bytes),sums(|e|e.repeated_bytes),s.late_reentries,s.alias_forces,s.guard_prunes,s.failed_bases);
+        let mut paths:Vec<_>=s.paths.iter().collect(); paths.sort_by_key(|(name,_)|**name);
+        for (name,p) in paths { eprintln!("MEMBER_PATH {{\"path\":\"{}\",\"calls\":{},\"success\":{},\"guarded\":{},\"stable_repeats\":{},\"walks\":{},\"stable_repeat_walks\":{}}}",name,p[0],p[1],p[2],p[3],p[4],p[5]); }
+        let mut entries:Vec<_>=s.entries.iter().collect(); entries.sort_by_key(|(id,e)| (std::cmp::Reverse(e.calls),id.index()));
+        for (id,_) in entries.iter().take(40) { eprintln!("MEMBER_LABEL\t{}\t{:?}",id.index(),checker.store.get(**id).data); }
+        for (id,e) in entries { eprintln!("MEMBER_TYPE {{\"type_id\":{},\"path\":\"{}\",\"calls\":{},\"success\":{},\"unsupported\":{},\"active_reentries\":{},\"risky\":{},\"stable_repeats\":{},\"changed_answers\":{},\"walks\":{},\"stable_repeat_walks\":{},\"returned_name_bytes\":{},\"stable_repeat_name_bytes\":{}}}",id.index(),e.path,e.calls,e.success,e.unsupported,e.active_reentries,e.risky,e.repeated_stable,e.changed,e.walks,e.repeated_walks,e.bytes,e.repeated_bytes); }
+    });
+}
+
+pub fn clock() -> Option<std::time::Instant> {
+    static TIMING: OnceLock<bool> = OnceLock::new();
+    (enabled() && *TIMING.get_or_init(|| std::env::var_os("TSR_PROFILE_MEMBER_TIMING").is_some()))
+        .then(std::time::Instant::now)
+}
+fn add(
+    site: &'static str,
+    strings: usize,
+    bytes: usize,
+    capacity: usize,
+    comparisons: usize,
+    start: Option<std::time::Instant>,
+) {
+    if !enabled() {
+        return;
+    }
+    let elapsed = start.map_or(0, |s| s.elapsed().as_nanos() as u64);
+    STATS.with(|s| {
+        let mut s = s.borrow_mut();
+        let v = s.sites.entry(site).or_default();
+        v[0] += 1;
+        v[1] += strings as u64;
+        v[2] += bytes as u64;
+        v[3] += capacity as u64;
+        v[4] += comparisons as u64;
+        v[5] += elapsed;
+    });
+}
+pub fn copy_name(name: &str, site: &'static str) -> String {
+    let start = clock();
+    let result = name.to_owned();
+    add(site, 1, name.len(), result.capacity(), 0, start);
+    result
+}
+pub fn contains(names: &[String], name: &str, site: &'static str) -> bool {
+    if !enabled() {
+        return names.iter().any(|n| n == name);
+    }
+    let start = clock();
+    let position = names.iter().position(|n| n == name);
+    add(site, 0, 0, 0, position.map_or(names.len(), |i| i + 1), start);
+    position.is_some()
+}
+pub fn late_copy(
+    names: &[(String, tsr_ast::NodeId)],
+    site: &'static str,
+) -> Vec<(String, tsr_ast::NodeId)> {
+    let start = clock();
+    let result = names.to_vec();
+    add(
+        site,
+        result.len(),
+        result.iter().map(|(n, _)| n.len()).sum(),
+        result.iter().map(|(n, _)| n.capacity()).sum(),
+        0,
+        start,
+    );
+    result
+}
+pub fn boundary(site: &'static str, start: Option<std::time::Instant>) {
+    add(site, 0, 0, 0, 0, start);
+}
+
+pub fn projection_copy(names:&Option<Option<Vec<String>>>,site:&'static str)->Option<Option<Vec<String>>> {
+    let start=clock();let result=names.clone();
+    let strings=result.as_ref().and_then(|n|n.as_ref());
+    add(site,strings.map_or(0,Vec::len),strings.map_or(0,|v|v.iter().map(String::len).sum()),strings.map_or(0,|v|v.iter().map(String::capacity).sum()),0,start);
+    result
+}
