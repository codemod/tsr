+                let plain = checker.get_declared_type_of_symbol(plain);
+                let empty = checker.get_declared_type_of_symbol(empty);
+                let merged = checker.get_declared_type_of_symbol(merged);
+                assert_eq!(checker.get_type_with_this_argument(plain, None), plain);
+                assert_eq!(checker.get_type_with_this_argument(empty, Some(plain)), empty);
+                let default = checker.get_type_with_this_argument(merged, None);
+                let this_type = checker.reference_this_argument(default).unwrap();
+                assert_eq!(checker.get_type_of_property_of_type(default, "first"), Some(this_type));
+                assert_eq!(
+                    checker.get_type_of_property_of_type(default, "second"),
+                    Some(this_type)
+                );
+                assert_eq!(checker.get_type_with_this_argument(merged, None), default);
+                let concrete = checker.get_type_with_this_argument(merged, Some(plain));
+                assert_ne!(concrete, default);
+                assert_eq!(checker.get_type_of_property_of_type(concrete, "first"), Some(plain));
+                assert_eq!(checker.get_type_of_property_of_type(concrete, "second"), Some(plain));
+            },
