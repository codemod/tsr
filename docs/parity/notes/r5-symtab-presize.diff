     /// Add `name` to the appropriate table, merging with an existing symbol where
     /// TypeScript allows it and reporting a duplicate where it does not.
+    /// Size a table's first allocation from the node that owns it, just
+    /// before the insert that would allocate it (`r5-symtab.md` §5). The
+    /// owning node is found on the ancestor stack; a table whose owner is
+    /// not there (deferred expando bindings, merges) grows as before. Never
+    /// creates or publishes a table the insert would not, and order is the
+    /// insert order whatever the capacity (ADR-0049).
+    fn size_first_table(
+        &mut self,
+        destination: Destination,
+        table_owner: NodeId,
+        symbol_owner: Option<SymbolId>,
+    ) {
+        match destination {
+            Destination::Locals => {
+                let Some(table) = self.locals.get_mut(&table_owner) else { return };
+                if table.capacity() != 0 {
+                    return;
+                }
+                let hint = if table_owner == self.file_node {
+                    self.file_statements
+                } else if let Some(&(_, node)) =
+                    self.ancestors.iter().rev().find(|(id, _)| *id == table_owner)
+                {
+                    TableHints::of(node).locals
+                } else {
+                    return;
+                };
+                if hint > 0 {
+                    table.reserve(hint);
+                }
+            }
