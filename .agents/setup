#!/usr/bin/env bash
# Prepares a fresh Amp orb for this repository. Runs once per fresh orb (or on
# top of a stale snapshot), so every step must be idempotent and cheap when the
# work is already done. See https://ampcode.com/docs/orbs.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

BD_VERSION="1.3.1"

step() {
  local name="$1"
  shift
  local start=$SECONDS
  echo "==> ${name}"
  "$@"
  echo "<== ${name} ($((SECONDS - start))s)"
}

install_rust() {
  # Box images ship a root-owned system rustup (RUSTUP_HOME=/usr/local/rustup)
  # without the pinned channel. Its proxies refuse to run once RUSTUP_HOME or
  # CARGO_HOME point elsewhere ("rustup is not installed at ~/.cargo"), so use
  # a user-owned rustup with user-owned homes instead of reusing it.
  export CARGO_HOME="$HOME/.cargo"
  export RUSTUP_HOME="$HOME/.rustup"
  # rustup's installer cannot update this running script's environment.
  export PATH="$CARGO_HOME/bin:$PATH"
  if [ ! -x "$CARGO_HOME/bin/rustup" ]; then
    curl --proto '=https' --tlsv1.2 -fsSL https://sh.rustup.rs |
      RUSTUP_INIT_SKIP_PATH_CHECK=yes sh -s -- -y --profile minimal --default-toolchain none --no-modify-path
  fi
  # Installs the channel and components pinned in rust-toolchain.toml; a no-op
  # when they are already present.
  rustup toolchain install
  rustc --version
}

install_offline_python() {
  # Debian's externally managed Python and older distro tomlkit cannot run the
  # directory-source assembler. Keep its pinned dependency in a private venv.
  local root="$HOME/.local/share/tsr/offline-python"
  python3 -m venv "$root"
  "$root/bin/python3" -m pip install --disable-pip-version-check --require-hashes \
    -r scripts/offline-cargo/requirements.txt
  "$root/bin/python3" -c 'import tomlkit; print("offline bootstrap tomlkit", tomlkit.__version__)'
  export PATH="$root/bin:$PATH"
}

persist_path() {
  # Login shells (Amp, supervised services) need cargo and ~/.local/bin on PATH.
  local marker="# tsr orb toolchain"
  if ! grep -Fqx "$marker" "$HOME/.bash_profile" 2>/dev/null; then
    cat >>"$HOME/.bash_profile" <<'EOF'

# tsr orb toolchain
case ":$PATH:" in *":$HOME/.cargo/bin:"*) ;; *) export PATH="$HOME/.cargo/bin:$PATH" ;; esac
case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) export PATH="$HOME/.local/bin:$PATH" ;; esac
EOF
  fi
  local homes_marker="# tsr orb rust homes"
  if ! grep -Fqx "$homes_marker" "$HOME/.bash_profile" 2>/dev/null; then
    cat >>"$HOME/.bash_profile" <<'EOF'

# tsr orb rust homes
export CARGO_HOME="$HOME/.cargo"
export RUSTUP_HOME="$HOME/.rustup"
EOF
  fi
  local python_marker="# tsr offline bootstrap Python"
  if ! grep -Fqx "$python_marker" "$HOME/.bash_profile" 2>/dev/null; then
    cat >>"$HOME/.bash_profile" <<'EOF'

# tsr offline bootstrap Python
case ":$PATH:" in *":$HOME/.local/share/tsr/offline-python/bin:"*) ;; *) export PATH="$HOME/.local/share/tsr/offline-python/bin:$PATH" ;; esac
EOF
  fi
}

init_submodules() {
  # Recursive: the conformance corpus lives in the TypeScript submodule inside
  # typescript-go. Shallow: nothing reads the submodules' history.
  git submodule sync --recursive --quiet
  git submodule update --init --recursive --depth 1 --jobs 4
}

install_go() {
  # The pinned tsgo oracle requires Go 1.26. Keep it available for direct
  # declaration-output comparisons, not only checked-in corpus baselines.
  local version="1.26.8"
  local root="$HOME/.local/share/go${version}"
  if [ ! -x "$root/bin/go" ]; then
    local tmp
    tmp="$(mktemp -d)"
    curl -fsSL -o "$tmp/go.tgz" "https://go.dev/dl/go${version}.linux-amd64.tar.gz"
    echo "d0f743b33e8d8945e6b1f432edd15785c70507121d6e2a723b21285eddf8b57b  $tmp/go.tgz" | sha256sum -c -
    mkdir -p "$root"
    tar xzf "$tmp/go.tgz" --strip-components=1 -C "$root"
    rm -rf "$tmp"
  fi
  mkdir -p "$HOME/.local/bin"
  ln -sf "$root/bin/go" "$HOME/.local/bin/go"
  "$HOME/.local/bin/go" version
}

install_bd() {
  mkdir -p "$HOME/.local/bin"
  if [ "$("$HOME/.local/bin/bd" version 2>/dev/null | awk '{print $3}')" != "$BD_VERSION" ]; then
    local tmp
    tmp="$(mktemp -d)"
    curl -fsSL -o "$tmp/bd.tgz" \
      "https://github.com/gastownhall/beads/releases/download/v${BD_VERSION}/beads_${BD_VERSION}_linux_amd64.tar.gz"
    tar xzf "$tmp/bd.tgz" -C "$tmp" bd
    install -m 0755 "$tmp/bd" "$HOME/.local/bin/bd"
    rm -rf "$tmp"
  fi
  export PATH="$HOME/.local/bin:$PATH"
  chmod 700 .beads  # bd warns on group/world-readable .beads
  # Creates the embedded Dolt database from the tracked JSONL on a fresh clone;
  # validates and leaves an existing database alone. Lane boxes do not use bd,
  # and the ~3 minute import is where Box exec connections dropped (tsr-2zk.50),
  # so it runs detached; its log is /tmp/bd-bootstrap.log.
  (nohup bd bootstrap --yes --quiet >/tmp/bd-bootstrap.log 2>&1 &)
}

build_tsgo() {
  # The pinned native oracle for perf-project comparisons, rebuilt only when the
  # vendored typescript-go commit changes.
  local rev
  rev="$(git -C vendor/typescript-go rev-parse HEAD)"
  if [ ! -x target/tsgo-pinned ] || [ "$(cat target/tsgo-pinned.rev 2>/dev/null)" != "$rev" ]; then
    mkdir -p target
    (cd vendor/typescript-go && GOTOOLCHAIN=local "$HOME/.local/bin/go" build -o ../../target/tsgo-pinned ./cmd/tsgo)
    echo "$rev" >target/tsgo-pinned.rev
  fi
  target/tsgo-pinned --version
}

step "rust toolchain" install_rust
step "offline bootstrap Python" install_offline_python
step "login shell PATH" persist_path
step "git submodules" init_submodules
step "tsgo oracle toolchain" install_go
step "beads (bd)" install_bd
step "pinned tsgo (target/tsgo-pinned)" build_tsgo
# Fetch locked dependencies, but leave compilation to the task that needs it.
# Building every debug, test, Clippy and release target here took over five
# minutes on a 2-CPU orb and produced a roughly 12 GB snapshot.
step "cargo dependencies" cargo fetch --locked
