+    #[test]
+    fn inline_parameter_cycle_markers_survive_spill_and_metadata_changes() {
+        let arena = Arena::new();
+        let source = "declare function owner<T>(value: T): T;";
+        let parsed = tsr_parser::parse(&arena, source);
+        let bound = tsr_binder::bind(
+            &arena,
+            parsed.source_file,
+            &parsed.nodes,
+            tsr_binder::FileInfo { name: "cycle.ts", text: source },
+        );
+        let mut checker = Checker::new(&bound, &parsed.nodes, &parsed.node_map);
+        let Statement::FunctionDeclaration(declaration) = parsed.source_file.statements[0] else {
+            panic!("owner");
+        };
+        let owner = bound.symbol_of(declaration.node_id.unwrap()).unwrap();
+        let parameter = checker.get_signatures_of_symbol(owner).unwrap()[0].parameters[0].r#type;
+        let shadow =
+            checker.store.new_named(crate::flags::TypeFlags::TYPE_PARAMETER, "T".into(), None);
+        let chain: Vec<_> = (0..32)
+            .map(|n| {
+                checker.store.new_named(crate::flags::TypeFlags::OBJECT, format!("Cycle{n}"), None)
+            })
+            .collect();
+        for pair in chain.windows(2) {
+            checker.type_reference_targets.insert(pair[0], (owner, vec![pair[1]]));
+        }
+        let last = *chain.last().unwrap();
+        checker.type_reference_targets.insert(last, (owner, vec![chain[0], shadow, parameter]));
+        assert!(checker.mentions_type_parameter(chain[0], &[parameter], &["T"]));
+        checker.type_reference_targets.insert(last, (owner, vec![chain[0], shadow]));
+        assert!(!checker.mentions_type_parameter(chain[0], &[parameter], &["T"]));
+        checker.type_reference_targets.insert(last, (owner, vec![chain[0], parameter]));
+        assert!(checker.mentions_registered_type_parameter(chain[0]));
+        checker.type_parameter_symbols.remove(&parameter);
+        assert!(!checker.mentions_registered_type_parameter(chain[0]));
+        checker.type_parameter_symbols.insert(shadow, owner);
+        assert!(!checker.mentions_registered_type_parameter(chain[0]));
+        checker.type_reference_targets.insert(last, (owner, vec![chain[0], shadow]));
+        assert!(checker.mentions_registered_type_parameter(chain[0]));
+    }
