+    /// `lateBindMember`'s conflict arm (`checker.go:16033`): a late-bound
+    /// name already holding a declaration whose flags this member's excludes
+    /// reject reports TS2300 at every gathered declaration and at this one,
+    /// then starts a fresh late symbol for the name.
+    fn late_bind_member_conflict(
+        &mut self,
+        late_symbols: &mut rustc_hash::FxHashMap<String, (SymbolFlags, Vec<tsr_ast::NodeId>)>,
+        name: &str,
+        member: tsr_ast::NodeId,
+        flags: SymbolFlags,
+    ) {
+        let entry =
+            late_symbols.entry(name.to_string()).or_insert((SymbolFlags::empty(), Vec::new()));
+        if entry.0.intersects(flags.excludes()) {
+            let mut at: Vec<tsr_ast::NodeId> = std::mem::take(&mut entry.1);
+            at.push(member);
+            entry.0 = SymbolFlags::empty();
+            self.report_late_bound_duplicates(&at, member, name);
+        }
+        entry.0 |= flags;
+        entry.1.push(member);
+    }
