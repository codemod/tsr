    "helper_source": "package main\nimport (\"bufio\"; \"encoding/json\"; \"os\"; \"github.com/microsoft/typescript-go/internal/tspath\")\nfunc normalizePathForCJSResolution(containingDirectory string, moduleName string) string {\n\tcombined := tspath.CombinePaths(containingDirectory, moduleName)\n\tparts := tspath.GetPathComponents(combined, \"\")\n\tlastPart := parts[len(parts)-1]\n\tif lastPart == \".\" || lastPart == \"..\" {\n\t\treturn tspath.EnsureTrailingDirectorySeparator(tspath.NormalizePath(combined))\n\t}\n\treturn tspath.NormalizePath(combined)\n}\n\nfunc main() { s:=bufio.NewScanner(os.Stdin); w:=bufio.NewWriter(os.Stdout); defer w.Flush(); e:=json.NewEncoder(w); for s.Scan() { var v [2]string; if err:=json.Unmarshal(s.Bytes(),&v);err!=nil {panic(err)}; combined:=tspath.CombinePaths(v[0],v[1]); parts:=tspath.GetPathComponents(combined, \"\"); e.Encode([]any{combined,parts,normalizePathForCJSResolution(v[0],v[1])}) }; if err:=s.Err();err!=nil{panic(err)} }\n",
