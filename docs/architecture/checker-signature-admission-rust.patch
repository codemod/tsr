+    /// Native 5b1047d getObjectTypeInstantiation/getOuterTypeParameters
+    /// (checker.go:22304/23756) can retain an anonymous function before its
+    /// signature vector exists. Its own generic parameters do not belong to
+    /// that outer window. Prove this from the original declaration and owner;
+    /// empty metadata and printed names are not an identity proof.
+    ///
+    /// This bounded admission leaves pending/active/foreign-key originals to
+    /// the existing return guard. It adds no completion, cache or mapper image.
+    pub(crate) fn uncomputed_callable_instantiation_is_identity(&self, ty: TypeId) -> bool {
+        let crate::types::TypeData::Anonymous { symbol, .. } = self.store.get(ty).data else {
+            return false;
+        };
+        let owner = self.binder.symbols().get(self.binder.merged_symbol(symbol));
+        if !owner.flags.contains(SymbolFlags::FUNCTION)
+            || owner.flags.intersects(SymbolFlags::CLASS | SymbolFlags::ENUM)
+        {
+            return false;
+        }
+        if self.signature_types.contains_key(&ty)
+            || !self.alias_evaluation_bindings.is_empty()
+            || self.mapped_template_depth != 0
+            || self.unresolved_types.contains(&ty)
+            || self.symbol_types.get(&symbol) != Some(&ty)
+        {
+            return false;
+        }
+        let mut found_function = false;
+        for &declaration in &owner.declarations {
+            if !matches!(self.node_map.get(declaration), Some(Node::FunctionDeclaration(_))) {
+                continue;
+            }
+            found_function = true;
+            if self.pending_signature_returns.keys().any(|key| key.node == declaration)
+                || self.resolutions.active_signature_keys(declaration).next().is_some()
+            {
+                return false;
+            }
+            let mut current = self.nodes.parent(declaration);
+            while let Some(node) = current {
+                let has_outer_parameters = match self.node_map.get(node) {
+                    // includeThisTypes is true in native, even for a nongeneric
+                    // enclosing class/interface. Keep that receiver distinct.
+                    Some(
+                        Node::ClassDeclaration(_)
+                        | Node::ClassExpression(_)
+                        | Node::InterfaceDeclaration(_)
+                        | Node::MappedTypeNode(_)
+                        | Node::ConditionalTypeNode(_),
+                    ) => true,
+                    Some(Node::FunctionDeclaration(n)) => !n.type_parameters.is_empty(),
+                    Some(Node::FunctionExpression(n)) => {
+                        !n.type_parameters.is_empty()
+                            || self.is_context_sensitive_function_like(node)
+                    }
+                    Some(Node::ArrowFunction(n)) => {
+                        !n.type_parameters.is_empty()
+                            || self.is_context_sensitive_function_like(node)
+                    }
+                    Some(Node::MethodDeclaration(n)) => {
+                        !n.type_parameters.is_empty()
+                            || self.is_context_sensitive_function_like(node)
+                    }
+                    Some(Node::CallSignatureDeclaration(n)) => !n.type_parameters.is_empty(),
+                    Some(Node::ConstructSignatureDeclaration(n)) => !n.type_parameters.is_empty(),
+                    Some(Node::MethodSignatureDeclaration(n)) => !n.type_parameters.is_empty(),
+                    Some(Node::FunctionTypeNode(n)) => !n.type_parameters.is_empty(),
+                    Some(Node::ConstructorTypeNode(n)) => !n.type_parameters.is_empty(),
+                    Some(Node::TypeAliasDeclaration(n)) => !n.type_parameters.is_empty(),
+                    Some(_) => false,
+                    None => return false,
+                };
+                if has_outer_parameters {
+                    return false;
+                }
+                current = self.nodes.parent(node);
+            }
