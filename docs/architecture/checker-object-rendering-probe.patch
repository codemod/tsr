+    #[test]
+    fn disabled_events_and_unwind_restore_the_executing_origin() {
+        let _lock = TEST_LOCK.lock().unwrap();
+        enable(false);
+        let old_requests = TRAFFIC[247].allocations.load(Ordering::Relaxed);
+        let disabled = OwnerGuard::enter(248);
+        let layout = Layout::from_size_align(31, 32).unwrap();
+        let pointer = unsafe { Meter.alloc(layout) };
+        assert!(!pointer.is_null());
+        assert_eq!(snapshot(248).live_requested_bytes, 0);
+        assert_eq!(TRAFFIC[247].allocations.load(Ordering::Relaxed), old_requests);
+        unsafe { Meter.dealloc(pointer, layout) };
+        drop(disabled);
+        enable(true);
+        let _outer = OwnerGuard::enter(248);
+        assert_eq!(event_origin(), 248);
+        let failure = std::panic::catch_unwind(|| {
+            let _inner = OwnerGuard::enter(249);
+            assert_eq!(event_origin(), 249);
+            panic!("origin unwinding control");
+        });
+        assert!(failure.is_err());
+        assert_eq!(event_origin(), 248);
+    }
