+                || source_declaration != symbols.get(target_property).value_declaration
+            {
+                return RelationResult::NotRelated;
+            }
+        } else if self.checker.property_has_modifier(target_property, protected) {
+            let valid = self.is_valid_override_of(source_property, target_property);
+            if valid != RelationResult::Related {
