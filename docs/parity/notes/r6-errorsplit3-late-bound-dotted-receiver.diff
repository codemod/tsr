+    /// The symbol a late-bound assignment's receiver names, as the binder's
+    /// `lookupSymbolForPropertyAccess` (`binder.go`) finds it: an identifier
+    /// by name, and `a.b` as the export `b` of `a`'s symbol. Only an entity
+    /// name qualifies; the caller confirms the owner by its `__assignment`
+    /// table, so a symbol this walk reaches that the binder did not file the
+    /// assignment under answers nothing.
+    fn late_bound_receiver_symbol(&mut self, receiver: Expression<'_>) -> Option<SymbolId> {
+        match receiver {
+            Expression::Identifier(name) => self.binder.resolve_name(
+                self.nodes,
+                self.node_map,
+                name.node_id?,
+                name.text,
+                SymbolFlags::VALUE,
+            ),
+            Expression::PropertyAccessExpression(access) => {
+                let tsr_ast::MemberName::Identifier(name) = access.name? else { return None };
+                let owner = self.late_bound_receiver_symbol(access.expression?)?;
+                [owner, self.binder.merged_symbol(owner)]
+                    .into_iter()
+                    .find_map(|owner| self.binder.symbols().get(owner).exports.get(name.text).copied())
+            }
+            _ => None,
+        }
+    }
