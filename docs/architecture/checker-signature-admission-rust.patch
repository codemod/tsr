+                let source = format!("{function} interface Owner<T> {{self:this}}");
+                let arena = tsr_core::Arena::new();
+                let parsed = tsr_parser::parse(&arena, &source);
+                assert!(parsed.diagnostics.is_empty());
+                let bound = tsr_binder::bind(
+                    &arena,
+                    parsed.source_file,
+                    &parsed.nodes,
+                    tsr_binder::FileInfo { name: "admission.ts", text: &source },
+                );
+                let root = parsed.source_file.node_id.unwrap();
+                let mut checker = crate::Checker::new(&bound, &parsed.nodes, &parsed.node_map);
+                if checked_first {
+                    checker.check_source_file(
+                        root,
+                        crate::check::FileContext { ambient: false, has_parse_errors: false },
+                    );
+                }
+                let callable_symbol = bound.lookup_local(root, "f").unwrap();
+                let callable = checker.get_type_of_symbol(callable_symbol);
+                let owner_symbol = bound.lookup_local(root, "Owner").unwrap();
+                let owner = checker.get_declared_type_of_symbol(owner_symbol);
+                let this_node = (0..u32::try_from(parsed.nodes.len()).unwrap())
+                    .find_map(|index| match parsed.node_map.get(tsr_ast::NodeId::new(index)) {
+                        Some(tsr_ast::Node::ThisTypeNode(node)) => {
+                            Some(tsr_ast::TypeNode::ThisTypeNode(node))
+                        }
+                        _ => None,
+                    })
+                    .unwrap();
+                let formal_this = checker.get_type_from_type_node(this_node);
+                assert!(
+                    checker
+                        .store
+                        .get(formal_this)
+                        .flags
+                        .contains(crate::flags::TypeFlags::TYPE_PARAMETER)
+                );
+                let absent = !checker.signature_types.contains_key(&callable);
+                if !checked_first && function.contains("namespace") {
+                    assert!(absent, "the merged control must reach actual absent metadata");
+                }
