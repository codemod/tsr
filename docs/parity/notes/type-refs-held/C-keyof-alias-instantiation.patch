+    /// Whether `reference` names a type alias whose body
+    /// [`Checker::instantiate_template_alias`] evaluates per instantiation (a
+    /// template literal or `keyof` body): its type never prints as the
+    /// written reference, so a printer that reuses written nodes must reuse
+    /// this one explicitly.
+    pub(crate) fn is_evaluated_operator_alias_reference(
+        &self,
+        reference: &tsr_ast::TypeReferenceNode<'_>,
+    ) -> bool {
+        let Some(tsr_ast::EntityName::Identifier(name)) = reference.type_name else {
+            return false;
+        };
+        let Some(id) = name.node_id else { return false };
+        let Some(symbol) = self.binder.resolve_name(
+            self.nodes,
+            self.node_map,
+            id,
+            name.text,
+            tsr_binder::SymbolFlags::TYPE,
+        ) else {
+            return false;
+        };
+        let symbol = self.binder.merged_symbol(symbol);
+        if !self.binder.symbols().get(symbol).flags.contains(tsr_binder::SymbolFlags::TYPE_ALIAS) {
+            return false;
+        }
+        let Some(declaration) = self.binder.symbols().get(symbol).declarations.first().copied()
+        else {
+            return false;
+        };
+        matches!(
+            self.node_map.get(declaration),
+            Some(tsr_ast::Node::TypeAliasDeclaration(alias)) if !alias.type_parameters.is_empty()
+                && match alias.r#type {
+                    Some(tsr_ast::TypeNode::TemplateLiteralTypeNode(_)) => true,
+                    Some(tsr_ast::TypeNode::TypeOperatorNode(operator)) => {
+                        operator.operator.kind == tsr_ast::SyntaxKind::KeyOfKeyword
+                    }
+                    _ => false,
+                }
+        )
+    }
