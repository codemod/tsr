+package checker_test
+
+import (
+	"encoding/json"
+	"fmt"
+	"github.com/microsoft/typescript-go/internal/ast"
+	"github.com/microsoft/typescript-go/internal/bundled"
+	"github.com/microsoft/typescript-go/internal/compiler"
+	"github.com/microsoft/typescript-go/internal/core"
+	"github.com/microsoft/typescript-go/internal/tsoptions"
+	"github.com/microsoft/typescript-go/internal/vfs/vfstest"
+	"testing"
+)
+
+func TestNativeSignatureAdmissionParsed(t *testing.T) {
+	cases := []struct {
+		name, body, expected string
+		nested, recursive    bool
+	}{
+		{"merged", "function f(){return 1} namespace f {export const bar=1}", "number", false, false},
+		{"plain", "function f(){return 1}", "number", false, false},
+		{"annotated", "function f():number{return 1}", "number", false, false},
+		{"ambient", "declare function f():number;", "number", false, false},
+		{"recursive-never", "function f(){return f()}", "never", false, false},
+		{"recursive-annotation", "function f():ReturnType<typeof f>{return f()}", "any", false, true},
+		{"unresolved", "function f(){return missingValue}", "any", false, false},
+		{"nested-generic", "function outer<T>(x:T){function f(){return x} return f}", "number", true, false},
+		{"nested-shadow", "function outer<T>(x:T){function f<U>(u:U){return u} return f}", "U", true, false},
+	}
+	for _, tc := range cases {
+		for _, order := range []string{"cold", "signatures-first", "return-first", "checked-first"} {
+			mappers := []string{"this-only", "nil"}
+			if tc.nested {
+				mappers = []string{"outer-number", "outer-no-op", "nil"}
+			}
+			for _, mapperKind := range mappers {
+				t.Run(tc.name+"/"+order+"/"+mapperKind, func(t *testing.T) {
+					body := tc.body + " interface Owner<T>{value:T}"
+					config := `{"compilerOptions":{"strict":true,"target":"es2020","types":[],"skipLibCheck":true,"noEmit":true,"incremental":false,"composite":false,"singleThreaded":true},"files":["input.ts"]}`
+					fs := bundled.WrapFS(vfstest.FromMap(map[string]string{"/input.ts": body, "/tsconfig.json": config}, false))
+					host := compiler.NewCompilerHost("/", fs, bundled.LibPath(), nil, nil)
+					parsed, errors := tsoptions.GetParsedCommandLineOfConfigFile("/tsconfig.json", &core.CompilerOptions{}, nil, host, nil)
+					if len(errors) != 0 {
+						t.Fatal(errors)
+					}
+					p := compiler.NewProgram(compiler.ProgramOptions{Config: parsed, Host: host})
+					p.BindSourceFiles()
+					file := p.GetSourceFile("/input.ts")
+					if order == "checked-first" {
+						p.GetSemanticDiagnostics(t.Context(), file)
+					}
+					var fn, owner *ast.Node
+					var visit func(*ast.Node) bool
+					visit = func(n *ast.Node) bool {
+						if n.Kind == ast.KindFunctionDeclaration && n.Name() != nil && n.Name().Text() == "f" {
+							fn = n
+						}
+						if n.Kind == ast.KindInterfaceDeclaration && n.Name().Text() == "Owner" {
+							owner = n
+						}
+						n.ForEachChild(visit)
+						return false
+					}
+					file.ForEachChild(visit)
+					if fn == nil || owner == nil {
+						t.Fatal("missing declaration")
+					}
+					c, done := p.GetTypeChecker(t.Context())
+					defer done()
+					row := c.NativeAdmissionContract(fn, owner, order, mapperKind)
+					row["case"] = tc.name
+					row["order"] = order
+					row["mapper"] = mapperKind
+					row["body"] = body
+					row["program"] = fmt.Sprintf("%p", p)
+					raw, _ := json.Marshal(row)
+					t.Logf("NATIVE_ADMISSION %s", raw)
+					expected := tc.expected
+					if tc.name == "nested-generic" && mapperKind != "outer-number" {
+						expected = "T"
+					}
+					returns := row["return_types"].([]string)
+					if len(returns) != 1 || returns[0] != expected {
+						t.Fatalf("return mismatch: %v", row)
+					}
+					if row["repeat_same_identity"] != true {
+						t.Fatal("warm mapper identity", row)
+					}
+					if !tc.nested || mapperKind != "outer-number" {
+						if row["same_identity"] != true {
+							t.Fatal("nongeneric/no-op identity", row)
+						}
+					} else if row["same_identity"] != false {
+						t.Fatal("required generic instantiation missing", row)
+					}
+					for _, e := range row["map_events"].([]map[string]any) {
+						if e["event"] == "return-worker" || e["event"] == "signature-worker" || e["event"] == "anonymous-worker" {
+							t.Fatal("instantiation eagerly forced signatures or return", row)
+						}
+					}
+					if order == "cold" {
+						b := row["before"].(map[string]any)
+						if b["members_resolved"] != false || b["signature_count"] != 0 {
+							t.Fatal("cold metadata was already forced", row)
+						}
+					}
+					for _, e := range row["warm_events"].([]map[string]any) {
+						if e["event"] == "return-worker" || e["event"] == "signature-worker" || e["event"] == "anonymous-worker" {
+							t.Fatal("warm demand repeats actual work", row)
+						}
+					}
+					if tc.recursive && order != "checked-first" {
+						active := false
+						reentry := false
+						for _, e := range row["all_events"].([]map[string]any) {
+							if e["return_active"] == true {
+								active = true
+							}
+							if e["event"] == "return-reentry-error" {
+								reentry = true
+							}
+						}
+						if !active || !reentry {
+							t.Fatal("actual recursive return admission not observed", row)
+						}
+					}
+				})
+			}
+		}
+	}
+}
