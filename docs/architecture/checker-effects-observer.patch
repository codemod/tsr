@@ -0,0 +1,26 @@
+//! Task-only executed-work observer. Never included in ordinary timing builds.
+use std::{collections::BTreeMap, io::Write, sync::{LazyLock, atomic::{AtomicU64, Ordering}}};
+static DIRECTORY: LazyLock<Option<std::path::PathBuf>> = LazyLock::new(|| std::env::var_os("TSR_EFFECTS_PROBE_DIR").map(Into::into));
+static DISABLE_REUSE: LazyLock<bool> = LazyLock::new(|| std::env::var_os("TSR_EFFECTS_PROBE_DISABLE_REUSE").is_some());
+static OWNER: AtomicU64 = AtomicU64::new(0);
+pub(crate) fn reuse_enabled() -> bool { !*DISABLE_REUSE }
+#[derive(Default)]
+pub(crate) struct EffectsProbe { rows: BTreeMap<tsr_ast::NodeId, [u64; 7]> }
+impl EffectsProbe {
+    pub(crate) fn record(&mut self, call: tsr_ast::NodeId, stage: usize) { self.rows.entry(call).or_default()[stage] += 1; }
+}
+impl Drop for EffectsProbe {
+    fn drop(&mut self) {
+        let Some(directory) = &*DIRECTORY else { return; };
+        if self.rows.is_empty() { return; }
+        std::fs::create_dir_all(directory).unwrap();
+        let owner = OWNER.fetch_add(1, Ordering::Relaxed);
+        let mut file = std::fs::File::create(directory.join(format!("checker-{owner}.tsv"))).unwrap();
+        writeln!(file, "call\trequest\tcallee_worker\tsignature_worker\tcompleted_hit\tpublication\tnegative\tpositive").unwrap();
+        for (call, stages) in &self.rows {
+            write!(file, "{call:?}").unwrap();
+            for count in stages { write!(file, "\t{count}").unwrap(); }
+            writeln!(file).unwrap();
+        }
+    }
+}
