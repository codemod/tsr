+//! Private locating observer; never supplies semantic answers.
+use std::time::Instant;
+
+pub(crate) struct LegacyMemberCost {
+    pub(crate) enabled: bool,
+    timed: bool,
+    depth: [u32; 3],
+    calls: [u64; 3],
+    roots: [u64; 3],
+    success: [u64; 3],
+    elapsed_ns: [u128; 3],
+    pub(crate) declared_entries: u64,
+    pub(crate) declared_guards: u64,
+    pub(crate) declared_own_hits: u64,
+    pub(crate) names_entries: u64,
+    pub(crate) names_guards: u64,
+}
+
+impl Default for LegacyMemberCost {
+    fn default() -> Self {
+        let mode = std::env::var("TSR_MEMBER_FIELD_COST").unwrap_or_default();
+        Self {
+            enabled: matches!(mode.as_str(), "count" | "time"),
+            timed: mode == "time",
+            depth: [0; 3], calls: [0; 3], roots: [0; 3], success: [0; 3],
+            elapsed_ns: [0; 3], declared_entries: 0, declared_guards: 0,
+            declared_own_hits: 0, names_entries: 0, names_guards: 0,
+        }
+    }
+}
+
+impl LegacyMemberCost {
+    pub(crate) fn enter(&mut self, kind: usize) -> Option<Instant> {
+        if !self.enabled { return None; }
+        self.calls[kind] += 1;
+        let root = self.depth[kind] == 0;
+        if root { self.roots[kind] += 1; }
+        self.depth[kind] += 1;
+        (self.timed && root).then(Instant::now)
+    }
+
+    pub(crate) fn exit(&mut self, kind: usize, start: Option<Instant>, success: bool) {
+        if !self.enabled { return; }
+        if success { self.success[kind] += 1; }
+        self.depth[kind] -= 1;
+        if let Some(start) = start { self.elapsed_ns[kind] += start.elapsed().as_nanos(); }
+    }
+}
+
+impl Drop for LegacyMemberCost {
+    fn drop(&mut self) {
+        if self.enabled {
+            eprintln!("MEMBER_LEGACY {{\"calls\":{:?},\"roots\":{:?},\"success\":{:?},\"elapsed_ns\":{:?},\"depth_at_drop\":{:?},\"declared_entries\":{},\"declared_guards\":{},\"declared_own_hits\":{},\"names_entries\":{},\"names_guards\":{}}}",
+                self.calls,self.roots,self.success,self.elapsed_ns,self.depth,
+                self.declared_entries,self.declared_guards,self.declared_own_hits,
+                self.names_entries,self.names_guards);
+        }
+    }
+}
+
+#[derive(Default)]
+pub(crate) struct PublicationCost {
+    pub(crate) legacy: LegacyMemberCost,
+    pub(crate) image_calls: u64,
+    pub(crate) completed_hits: u64,
+    pub(crate) active_hits: u64,
+    pub(crate) image_workers: u64,
+    pub(crate) unsupported: u64,
+    pub(crate) declared_calls: u64,
+    pub(crate) declared_hits: u64,
+    pub(crate) declared_none_hits: u64,
+    pub(crate) declared_workers: u64,
+    pub(crate) read_calls: u64,
+    pub(crate) read_hits: u64,
+    pub(crate) read_misses: u64,
+    pub(crate) new_members: u64,
+    pub(crate) invariant_reuses: u64,
+    pub(crate) instantiate_calls: u64,
+    pub(crate) resets: u64,
+    // clone operations, member entries, string payload bytes, calls, constructs, indexes
+    pub(crate) copies: [[u64; 6]; 5],
+}
+
+impl PublicationCost {
+    pub(crate) fn copy(&mut self, kind: usize, counts: [u64; 5]) {
+        if !self.legacy.enabled { return; }
+        self.copies[kind][0] += 1;
+        for (out, value) in self.copies[kind][1..].iter_mut().zip(counts) { *out += value; }
+    }
+}
