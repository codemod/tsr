+            "literal_prelookup_signature_allocations",
+            "literal_prelookup_signature_requested_bytes",
+            "literal_prelookup_signature_usable_bytes",
+            "reference_key_allocations",
+            "reference_key_requested_bytes",
+            "reference_key_usable_bytes",
+            "reference_publication_allocations",
+            "reference_publication_requested_bytes",
+            "reference_publication_usable_bytes",
+            "reference_target_allocations",
+            "reference_target_requested_bytes",
+            "reference_target_usable_bytes",
+        ]
+        .into_iter()
+        .zip(COUNTS.iter().map(|v| v.load(Ordering::Relaxed)))
+        .collect()
+    }
+}
+static REFERENCE: [AtomicU64; 8] = [const { AtomicU64::new(0) }; 8];
+type ReferenceKey = (SymbolId, Vec<TypeId>);
+std::thread_local! { static REFERENCE_ACTIVE: RefCell<Vec<(usize,ReferenceKey)>> = const { RefCell::new(Vec::new()) }; }
+pub fn reference_key(symbol: SymbolId, arguments: &[TypeId]) -> ReferenceKey {
+    if enabled() {
+        reference_record(0, 1);
+        reference_record(1, arguments.len() as u64);
+    }
+    let start = enabled().then(Instant::now);
+    let key = {
+        let _scope = allocation::enter(10);
+        (symbol, arguments.to_vec())
+    };
+    if let Some(start) = start {
+        reference_record(
+            2,
+            u64::try_from(start.elapsed().as_nanos())
+                .expect("probe interval exceeds u64 nanoseconds"),
+        );
+    }
+    key
+}
+#[must_use]
+pub fn reference_copy(arguments: &[TypeId], tag: usize) -> Vec<TypeId> {
+    let _scope = allocation::enter(tag);
+    arguments.to_vec()
+}
+pub fn reference_lookup(
+    owner: usize,
+    key: &ReferenceKey,
+    result: Option<TypeId>,
+    start: Option<Instant>,
+) {
+    if let Some(start) = start {
+        reference_record(
+            3,
+            u64::try_from(start.elapsed().as_nanos())
+                .expect("probe interval exceeds u64 nanoseconds"),
+        );
+    }
+    if result.is_some() && enabled() {
+        let active = REFERENCE_ACTIVE
+            .with(|s| s.borrow().iter().any(|(domain, k)| *domain == owner && k == key));
+        reference_record(if active { 4 } else { 5 }, 1);
+    }
+}
+pub struct ReferenceWorker {
+    start: Option<Instant>,
+}
+impl ReferenceWorker {
+    pub fn enter(owner: usize, key: &ReferenceKey) -> Self {
+        if enabled() {
+            reference_record(6, 1);
+            REFERENCE_ACTIVE.with(|s| s.borrow_mut().push((owner, key.clone())));
+        }
+        Self { start: enabled().then(Instant::now) }
+    }
+}
+impl Drop for ReferenceWorker {
+    fn drop(&mut self) {
+        if let Some(start) = self.start {
+            reference_record(
+                7,
+                u64::try_from(start.elapsed().as_nanos())
+                    .expect("probe interval exceeds u64 nanoseconds"),
+            );
+            REFERENCE_ACTIVE.with(|s| {
+                s.borrow_mut().pop().expect("balanced reference diagnostic frames");
+            });
+        }
+    }
+}
+fn reference_counts() -> Vec<(&'static str, u64)> {
+    [
+        "reference_lookup_requests",
+        "reference_key_items",
+        "reference_key_ns",
+        "reference_lookup_ns",
+        "reference_active_hits",
+        "reference_nonactive_hits",
+        "reference_miss_blocks",
+        "reference_miss_inclusive_ns",
+    ]
+    .into_iter()
+    .zip(REFERENCE.iter().map(|v| v.load(Ordering::Relaxed)))
+    .collect()
+}
+
+#[must_use]
+pub fn capacities(checker: &Checker<'_, '_>) -> Vec<(&'static str, u64)> {
+    let mut counts = Vec::new();
+    counts.extend([
+        ("reference_cache_entries", checker.instantiations.len() as u64),
+        ("reference_cache_bucket_capacity", checker.instantiations.capacity() as u64),
+        (
+            "reference_cache_key_payload_capacity_bytes",
+            checker
+                .instantiations
+                .keys()
+                .map(|(_, a)| a.capacity() * std::mem::size_of::<TypeId>())
+                .sum::<usize>() as u64,
+        ),
+    ]);
+    counts.extend([
+        ("object_cache_entries", checker.instantiated_objects.len() as u64),
+        ("object_cache_bucket_capacity", checker.instantiated_objects.capacity() as u64),
+        (
+            "object_cache_key_payload_capacity_bytes",
+            checker
+                .instantiated_objects
+                .keys()
+                .map(|(_, m)| m.capacity() * std::mem::size_of::<(TypeId, TypeId)>())
+                .sum::<usize>() as u64,
+        ),
+        ("signature_cache_entries", checker.instantiated_signatures.len() as u64),
+        ("signature_cache_bucket_capacity", checker.instantiated_signatures.capacity() as u64),
+        (
+            "signature_cache_key_payload_capacity_bytes",
+            checker
+                .instantiated_signatures
+                .keys()
+                .map(|(_, m)| m.capacity() * std::mem::size_of::<(TypeId, TypeId)>())
+                .sum::<usize>() as u64,
+        ),
+        ("predicate_cache_entries", checker.could_contain_parameter_cache.len() as u64),
+        (
+            "predicate_cache_bucket_capacity",
+            checker.could_contain_parameter_cache.capacity() as u64,
+        ),
+        (
+            "predicate_cache_key_payload_capacity_bytes",
+            checker
+                .could_contain_parameter_cache
+                .keys()
+                .map(|(_, p)| p.capacity() * std::mem::size_of::<TypeId>())
+                .sum::<usize>() as u64,
+        ),
+    ]);
+    counts
+}
+
+// Actual pool events are independently enabled by a trace path; allocation and
+// key counters can be disabled while observing the same admitted workers/files.
+// One file per owner avoids locks and parallel stderr interleaving. Aggregate
+// counters are read once, after every checker has dropped and every join ended.
+use std::io::Write;
+use std::marker::PhantomData;
+use std::path::PathBuf;
+use std::rc::Rc;
+static EPOCH: OnceLock<(Instant, u128)> = OnceLock::new();
+fn epoch() -> &'static (Instant, u128) {
+    EPOCH.get_or_init(|| {
+        let unix =
+            std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_nanos();
+        (Instant::now(), unix)
+    })
+}
+fn trace_path() -> Option<&'static PathBuf> {
+    static PATH: OnceLock<Option<PathBuf>> = OnceLock::new();
+    PATH.get_or_init(|| std::env::var_os("TSR_MAPPER_TRACE").map(PathBuf::from)).as_ref()
+}
+fn elapsed() -> u128 {
+    epoch().0.elapsed().as_nanos()
+}
+pub struct PoolWorker {
+    owner: usize,
+    count: usize,
+    started: u128,
+    setup_end: u128,
+    checks: Vec<(usize, String, u128, u128)>,
+    retained: Vec<(&'static str, u64)>,
+    complete: bool,
+    _thread: PhantomData<Rc<()>>,
+}
+impl PoolWorker {
+    #[must_use]
+    pub fn enter(owner: usize, count: usize) -> Self {
+        Self {
+            owner,
+            count,
+            started: elapsed(),
+            setup_end: 0,
+            checks: Vec::new(),
+            retained: Vec::new(),
+            complete: false,
+            _thread: PhantomData,
+        }
+    }
+    pub fn setup_complete(&mut self) {
+        self.setup_end = elapsed();
+    }
+    #[must_use]
+    pub fn check_start(&self) -> u128 {
+        elapsed()
+    }
+    pub fn checked(&mut self, index: usize, name: &str, start: u128) {
+        if trace_path().is_some() {
+            self.checks.push((index, name.to_string(), start, elapsed()));
+        }
+    }
+    pub fn complete(&mut self, checker: &Checker<'_, '_>) {
+        if enabled() {
+            self.retained = capacities(checker);
+        }
+        self.complete = true;
+    }
+}
+impl Drop for PoolWorker {
+    fn drop(&mut self) {
+        let Some(base) = trace_path() else { return };
+        let ended = elapsed();
+        let path = base.with_extension(format!("owner-{}.tsv", self.owner));
+        let mut out = std::fs::File::create_new(path).expect("fresh mapper owner receipt");
+        writeln!(
+            out,
+            "owner\t{}\t{}\t{}\t{}\t{}\t{}\t{}",
+            std::process::id(),
+            self.owner,
+            self.count,
+            self.started,
+            self.setup_end,
+            ended,
+            usize::from(self.complete && !std::thread::panicking())
+        )
+        .unwrap();
+        for (index, name, start, end) in &self.checks {
+            // File spellings are local evidence; do not export private names.
+            writeln!(out, "check\t{index}\t{start}\t{end}\t{name}").unwrap();
+        }
+        if enabled() {
+            let local = LOCAL_COUNTS.with(std::cell::Cell::get);
+            let names = global_counts();
+            assert_eq!(names.len(), local.len());
+            for ((name, _), value) in names.into_iter().zip(local) {
+                writeln!(out, "owner_count\t{name}\t{value}").unwrap();
+            }
+            for (name, value) in crate::mapper_hash_probe::local_counts() {
+                writeln!(out, "owner_count\t{name}\t{value}").unwrap();
+            }
+        }
+        for (name, value) in &self.retained {
+            writeln!(out, "capacity\t{name}\t{value}").unwrap();
+        }
+    }
+}
+pub fn finish_pool(count: usize) {
+    let Some(path) = trace_path() else { return };
+    let mut out = std::fs::File::create_new(path).expect("fresh mapper aggregate receipt");
+    writeln!(out, "schema\tmapper-pool-hash-v1").unwrap();
+    writeln!(
+        out,
+        "process\t{}\t{}\t{}\t{}",
+        std::process::id(),
+        count,
+        usize::from(enabled()),
+        epoch().1
+    )
+    .unwrap();
+    if enabled() {
+        for (name, value) in global_counts() {
+            writeln!(out, "count\t{name}\t{value}").unwrap();
+        }
+        for (name, value) in crate::mapper_hash_probe::global_counts() {
+            writeln!(out, "count\t{name}\t{value}").unwrap();
+        }
+    }
+    writeln!(out, "pool_joined\t{}", elapsed()).unwrap();
+}
