+package checker
+
+import "github.com/microsoft/typescript-go/internal/ast"
+
+// Scratch-only access to actual native getter state, with no replacement answer.
+type CompletionObservation struct {
+	Before, After, Result                *ast.Symbol
+	BeforeState, AfterState, ResultState string
+	ErrorsBefore, ErrorsAfter            int
+	WorkerBranches                       uint64
+}
+
+func (c *Checker) ObserveCompletion(kind int, node *ast.Node, file *ast.SourceFile) CompletionObservation {
+	states := [5]string{"nil", "unknown", "unresolved", "alias", "declared"}
+	before := c.symbolNodeLinks.Get(node).resolvedSymbol
+	result := CompletionObservation{Before: before, BeforeState: states[symbolProbeState(before, c.unknownSymbol)], ErrorsBefore: len(c.diagnostics.GetDiagnosticsForFile(file.FileName()))}
+	workers := symbolProbeData[kind].Workers.Load()
+	switch kind {
+	case 0:
+		result.Result = c.getResolvedSymbol(node)
+	case 1:
+		result.Result = c.getReferencedValueOrAliasSymbol(node)
+	case 2:
+		result.Result = c.getSymbolFromTypeReference(node)
+	default:
+		panic("invalid completion getter")
+	}
+	result.After = c.symbolNodeLinks.Get(node).resolvedSymbol
+	result.AfterState = states[symbolProbeState(result.After, c.unknownSymbol)]
+	result.ResultState = states[symbolProbeState(result.Result, c.unknownSymbol)]
+	result.ErrorsAfter = len(c.diagnostics.GetDiagnosticsForFile(file.FileName()))
+	result.WorkerBranches = symbolProbeData[kind].Workers.Load() - workers
+	return result
+}
