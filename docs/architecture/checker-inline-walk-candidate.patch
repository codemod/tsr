+    #[test]
+    fn inline_parameter_markers_preserve_empty_prefix_spill_order_and_duplicates() {
+        let arena = Arena::new();
+        let source = "";
+        let parsed = tsr_parser::parse(&arena, source);
+        let bound = tsr_binder::bind(
+            &arena,
+            parsed.source_file,
+            &parsed.nodes,
+            tsr_binder::FileInfo { name: "markers.ts", text: source },
+        );
+        let mut checker = Checker::new(&bound, &parsed.nodes, &parsed.node_map);
+        let ids: Vec<_> = (0..24)
+            .map(|n| {
+                checker.store.new_named(crate::flags::TypeFlags::OBJECT, format!("Marker{n}"), None)
+            })
+            .collect();
+        let mut visited = super::ParameterWalkVisited::new(ids[0]);
+        assert!(visited.as_slice().is_empty());
+        assert!(!visited.contains(ids[0]), "unused slots must not mark the root");
+        let mut expected = Vec::new();
+        for &id in ids.iter().chain(ids[..3].iter()) {
+            visited.push(id);
+            expected.push(id);
+            assert_eq!(visited.as_slice(), expected);
+            for &query in &ids {
+                assert_eq!(visited.contains(query), expected.contains(&query));
+            }
+        }
+    }
