 //! reporting would add false TS2589s (r5-spans §2.3).
 
 use tsr_ast::{NodeId, SyntaxKind};
+use tsr_diagnostics::{Diagnostic, messages};
 
 use crate::checker::Checker;
 
@@ -66,4 +67,22 @@ impl Checker<'_, '_> {
     pub(crate) fn leave_current_node(&mut self, saved: Option<NodeId>) {
         self.current_node = saved;
     }
+
+    /// `c.error(c.currentNode, diagnostics.Type_instantiation_is_excessively_deep_and_possibly_infinite)`
+    /// (`checker.go:22118`, `:24311`).
+    ///
+    /// Upstream with no current node (an instantiation outside any check)
+    /// makes a diagnostic with no file; this port reports nothing there.
+    pub(crate) fn report_excessive_instantiation_depth(&mut self) {
+        let Some(node) = self.current_node else { return };
+        let Some(file) = self.source_file_of_for_diagnostics(node) else { return };
+        let span = self.error_span(node);
+        self.report(
+            file,
+            Diagnostic::new(
+                &messages::TYPE_INSTANTIATION_IS_EXCESSIVELY_DEEP_AND_POSSIBLY_INFINITE,
+                span,
+            ),
+        );
+    }
 }
