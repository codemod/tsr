diff --git a/crates/tsr-binder/tests/jsdoc_namespaced_aliases.rs b/crates/tsr-binder/tests/jsdoc_namespaced_aliases.rs
new file mode 100644
index 0000000..779486e
--- /dev/null
+++ b/crates/tsr-binder/tests/jsdoc_namespaced_aliases.rs
@@ -0,0 +1,39 @@
+//! A dotted `@callback`/`@typedef` name binds as namespaces holding the
+//! alias, pinned to 5b1047d1: `parseJSDocTypeNameWithNamespace`
+//! (`parser/jsdoc.go:992`) and `wrapInJSDocNamespace`
+//! (`parser/reparser.go:729`). `docs/parity/notes/r6-jsdoc.md` §10.
+
+use tsr_ast::NodeFlags;
+use tsr_binder::{BindResult, FileInfo, SymbolFlags};
+use tsr_core::Arena;
+
+#[test]
+fn a_dotted_callback_name_is_namespaces_holding_the_alias() {
+    let source = "/**\n * @callback NS.Nested.Inner\n * @param {Object} space\n * @return {string}\n */\nvar x = 1;\n";
+    let arena = Arena::new();
+    let mut parsed = tsr_parser::parse_with_options(
+        &arena,
+        source,
+        tsr_parser::ParseOptions::for_file("namespaced.js"),
+    );
+    assert!(parsed.diagnostics.is_empty());
+    let root = parsed.source_file.node_id.expect("registered source file");
+    parsed.nodes.add_flags(root, NodeFlags::JAVASCRIPT_FILE);
+    let docs: Vec<_> = parsed.jsdoc.iter().collect();
+    let bound = tsr_binder::bind_into_with_jsdoc(
+        BindResult::empty(),
+        &arena,
+        parsed.source_file,
+        &parsed.nodes,
+        FileInfo { name: "namespaced.js", text: source },
+        &docs,
+    );
+    assert!(bound.diagnostics().is_empty());
+    let ns = bound.lookup_local(root, "NS").expect("NS is a local");
+    assert!(bound.symbols().get(ns).flags.contains(SymbolFlags::NAMESPACE_MODULE));
+    let nested = *bound.symbols().get(ns).exports.get("Nested").expect("NS exports Nested");
+    assert!(bound.symbols().get(nested).flags.contains(SymbolFlags::NAMESPACE_MODULE));
+    let inner = *bound.symbols().get(nested).exports.get("Inner").expect("Nested exports Inner");
+    assert!(bound.symbols().get(inner).flags.contains(SymbolFlags::TYPE_ALIAS));
+    assert_eq!(bound.lookup_local(root, "Inner"), None);
+}
