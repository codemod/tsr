+    #[test]
+    fn member_consumer_active_bases_are_not_completed_empty_members() {
+        use crate::member_completeness::MemberConsumerResult as Result;
+        use crate::resolution::PropertyName;
+        with_checker(
+            "interface Root {root:number} interface A extends Root {own:string}",
+            |checker, root| {
+                let symbol = checker.binder.lookup_local(root, "A").unwrap();
+                let receiver = checker.get_declared_type_of_symbol(symbol);
+                // Explicit frame countercontrol, not a claimed natural nested
+                // callback. The native producer separately qualifies natural reentry.
+                assert!(checker.resolutions.push(symbol, PropertyName::ResolvedBaseTypes));
+                assert_eq!(
+                    checker.member_consumer_view(receiver, "own"),
+                    Result::Active { prefix: vec![] }
+                );
+                assert!(!checker.resolutions.pop(), "base reentry marked the cycle frame");
+                let Result::Complete(view) = checker.member_consumer_view(receiver, "own") else {
+                    panic!("own completion");
+                };
+                assert_eq!(checker.type_to_string(view.read), "string");
+                let Result::Complete(view) = checker.member_consumer_view(receiver, "root") else {
+                    panic!("base completion");
+                };
+                assert_eq!(checker.type_to_string(view.read), "number");
+                assert_eq!(checker.resolutions.depth(), 0);
+                assert_eq!(checker.member_consumer_view(receiver, "missing"), Result::Unsupported);
+            },
+        );
+    }
