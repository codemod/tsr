+    fn publication_signature(&mut self,key:ImageKey,signature:Signature) -> Option<Signature> {
+        let TypeData::Named {members:Some(owner),..}=self.store.get(key.ty).data else {return None};
+        let parameters=self.local_type_parameter_types_of(owner)?;
+        let arguments=self.type_reference_targets.get(&key.ty).map(|(_,args)|args.clone()).unwrap_or_else(||parameters.iter().map(|(ty,_)|*ty).collect());
+        if arguments.len()!=parameters.len() && arguments.len()!=parameters.len()+1 {return None;}
+        let mut ids:Vec<_>=parameters.iter().map(|(ty,_)|*ty).collect();
+        let names:Vec<_>=parameters.iter().map(|(_,name)|name.as_str()).collect();
+        let mut map:Vec<_>=ids.iter().copied().zip(arguments.iter().copied()).collect();
+        if let Some(&this)=self.this_types.get(&owner) {
+            ids.push(this);
+            map.push((this,key.receiver));
+        }
+        self.instantiate_signature_with_fresh_parameters(signature,&map,&ids,&names)
