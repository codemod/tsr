+    /// `canHaveSyntheticDefault(file, module, _, usage)` (`checker.go:14818`)
+    /// with its usage-dependent `node16`/`nodenext` block in front of
+    /// [`Checker::can_have_synthetic_default`]'s file arms.
+    fn can_have_synthetic_default_at(&self, module: SymbolId, usage: NodeId) -> bool {
+        let file = self
+            .binder
+            .symbols()
+            .get(module)
+            .declarations
+            .iter()
+            .copied()
+            .find(|&declaration| self.nodes.kind(declaration) == SyntaxKind::SourceFile);
+        if let Some(file) = file
+            && let Some(importing) = self.source_file_of(usage)
+            && let Some(decided) = self.synthetic_default_node_arm(file, importing)
+        {
+            return decided;
+        }
+        self.can_have_synthetic_default(module)
+    }
+
+    /// The block at `checker.go:14823-14833` for an import-declaration usage:
+    /// `Some(true)` when a `CommonJS` target is imported from ESM under
+    /// `node16`..`nodenext`, `Some(false)` when both sides are ESM, `None` to
+    /// fall through. The project-reference arm (`:14836`) is not ported; this
+    /// port's programs have no project references.
+    fn synthetic_default_node_arm(&self, target: NodeId, importing: NodeId) -> Option<bool> {
+        use tsr_core::ModuleKind;
+        // `getEmitSyntaxForUsageLocationWorker` for an import declaration: the
+        // importing file's emit format (`GetEmitModuleFormatOfFileWorker`).
+        let file_emit_mode =
+            self.implied_node_format_for_emit(importing).unwrap_or(self.module_kind);
+        let usage_mode = match file_emit_mode {
+            ModuleKind::CommonJS => ModuleKind::CommonJS,
+            ModuleKind::ES2015
+            | ModuleKind::ES2020
+            | ModuleKind::ES2022
+            | ModuleKind::ESNext
+            | ModuleKind::Preserve => ModuleKind::ESNext,
+            _ => return None,
+        };
+        let target_mode = self.implied_node_format_for_emit(target);
+        // `usage ESM && target CommonJS && node16..nodenext` answers `true`
+        // upstream (`:14825`). Not taken: the default alias then shares the
+        // module with `import * as ns`, which upstream separates by cloning
+        // (`resolveESModuleSymbol`'s ESM→CJS arm, cluster tsr-2zk.16.22) and
+        // this port does not, so `ns` would print through `d`. Falling through
+        // keeps the file arms' answer. names-modules notes §3.
+        if usage_mode == ModuleKind::ESNext && target_mode == Some(ModuleKind::ESNext) {
+            return Some(false);
+        }
+        None
+    }
+
+    /// `GetImpliedNodeFormatForEmitWorker` (`ast/utilities.go:2573`) from what
+    /// the checker can see. Under `node16`..`nodenext` it is the file's
+    /// implied node format, which the host answers as the file's default
+    /// resolution mode. Otherwise only the extension decides it here:
+    /// `.mts`/`.mjs`/`.d.mts` are ESM and `.cts`/`.cjs`/`.d.cts` `CommonJS`.
+    /// A `.ts`/`.js` file's package.json `type` is not visible to the checker,
+    /// so it answers `None`, which upstream gives exactly when that `type` is
+    /// absent.
+    fn implied_node_format_for_emit(&self, file: NodeId) -> Option<tsr_core::ModuleKind> {
+        use tsr_core::ModuleKind;
+        let host = self.module_host?;
+        if (ModuleKind::Node16 as u32..=ModuleKind::NodeNext as u32)
+            .contains(&(self.module_kind as u32))
+        {
+            return match host.default_resolution_mode_for_file(file) {
+                ModuleKind::None => None,
+                mode => Some(mode),
+            };
+        }
+        let path = host.file_path(file)?;
+        if [".mts", ".mjs"].iter().any(|extension| path.ends_with(extension)) {
+            return Some(ModuleKind::ESNext);
+        }
+        if [".cts", ".cjs"].iter().any(|extension| path.ends_with(extension)) {
+            return Some(ModuleKind::CommonJS);
+        }
+        None
+    }
