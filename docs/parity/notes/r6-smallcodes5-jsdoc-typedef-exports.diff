+                Destination::Exports,
+                root,
+                Some(module),
+                name,
+                SymbolFlags::TYPE_ALIAS,
+                declaration,
+            );
+            self.node_symbols[declaration.index() - self.node_base] = Some(symbol);
+            return;
+        }
+        self.declare_jsdoc_symbol(scope, name, SymbolFlags::TYPE_ALIAS, declaration);
+    }
