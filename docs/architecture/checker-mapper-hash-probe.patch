+// GlobalAlloc is diagnostic tooling only (ADR-0011), removed after profiling.
+#[allow(unsafe_code)]
+mod allocation {
+    use std::alloc::{GlobalAlloc, Layout, System};
+    use std::cell::Cell;
+    use std::sync::atomic::{AtomicU64, Ordering};
+    std::thread_local! { static TAG: Cell<usize> = const { Cell::new(0) }; }
+    static COUNTS: [AtomicU64; 36] = [const { AtomicU64::new(0) }; 36];
+    pub struct Scope(usize);
+    impl Drop for Scope {
+        fn drop(&mut self) {
+            TAG.with(|t| t.set(self.0));
+        }
+    }
+    pub fn enter(tag: usize) -> Scope {
+        Scope(TAG.with(|t| t.replace(if super::enabled() { tag } else { 0 })))
+    }
+    struct Probe;
+    #[global_allocator]
+    static GLOBAL: Probe = Probe;
+    unsafe extern "C" {
+        fn malloc_size(ptr: *const std::ffi::c_void) -> usize;
+    }
+    fn observe(ptr: *mut u8, size: usize) {
+        if ptr.is_null() {
+            return;
+        }
+        let tag = TAG.try_with(Cell::get).unwrap_or(0);
+        if tag == 0 {
+            return;
+        }
+        // SAFETY: immediately returned successful live System allocation; the
+        // macOS SDK malloc_size declaration observes it without retaining it.
+        let usable = unsafe { malloc_size(ptr.cast()) };
+        for (offset, value) in [1, size as u64, usable as u64].into_iter().enumerate() {
+            COUNTS[(tag - 1) * 3 + offset].fetch_add(value, Ordering::Relaxed);
+            super::local_add(64 + (tag - 1) * 3 + offset, value);
+        }
+    }
+    // SAFETY: unmodified arguments delegate to System; constant TLS and atomics
+    // do not allocate, retain pointers or change the allocation's ownership.
+    unsafe impl GlobalAlloc for Probe {
+        unsafe fn alloc(&self, layout: Layout) -> *mut u8 {
+            let p = unsafe { System.alloc(layout) };
+            observe(p, layout.size());
+            p
+        }
+        unsafe fn alloc_zeroed(&self, layout: Layout) -> *mut u8 {
+            let p = unsafe { System.alloc_zeroed(layout) };
+            observe(p, layout.size());
+            p
+        }
+        unsafe fn realloc(&self, p: *mut u8, layout: Layout, size: usize) -> *mut u8 {
+            let p = unsafe { System.realloc(p, layout, size) };
+            observe(p, size);
+            p
+        }
+        unsafe fn dealloc(&self, p: *mut u8, layout: Layout) {
+            unsafe { System.dealloc(p, layout) };
+        }
+    }
