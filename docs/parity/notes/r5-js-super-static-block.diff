diff --git a/crates/tsr-checker/tests/super_expressions.rs b/crates/tsr-checker/tests/super_expressions.rs
index 43a8b6c..ef8639f 100644
--- a/crates/tsr-checker/tests/super_expressions.rs
+++ b/crates/tsr-checker/tests/super_expressions.rs
@@ -170,3 +170,24 @@ fn a_computed_name_on_a_nested_class_member_answers_the_outer_base() {
         "A"
     );
 }
+
+/// `GetSuperContainer` (`ast/utilities.go:1835`) stops at a `static {}`
+/// block, and `ast.IsStatic` is true for it, so `super.x` inside one is the
+/// base constructor's side (`classStaticBlock5`, `classFieldSuperAccessible`).
+/// `docs/parity/notes/r5-js.md` §3.3.
+#[test]
+fn super_in_a_static_block_is_the_base_constructor() {
+    assert_eq!(
+        type_of_super(
+            "class B { static x = 1 }\nclass D extends B { static { const y = super.x; } }"
+        ),
+        "typeof B"
+    );
+}
+
+/// A `super(...)` call in a static block is not in a constructor, so it is
+/// the call arm's error-any (`checker.go:7867`), not the base.
+#[test]
+fn a_super_call_in_a_static_block_is_the_error_any() {
+    assert_eq!(type_of_super("class B {}\nclass D extends B { static { super(); } }"), "any");
+}
