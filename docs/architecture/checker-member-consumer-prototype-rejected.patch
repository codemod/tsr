+    pub(crate) fn member_consumer_view(
+        &mut self,
+        receiver: TypeId,
+        name: &str,
+    ) -> crate::member_completeness::MemberConsumerResult {
+        self.member_consumer_view_worker(receiver, name, receiver, &mut Vec::new())
+    }
+
+    fn member_consumer_view_worker(
+        &mut self,
+        id: TypeId,
+        name: &str,
+        receiver: TypeId,
+        path: &mut Vec<SymbolId>,
+    ) -> crate::member_completeness::MemberConsumerResult {
+        use crate::member_completeness::{
+            MemberConsumerIdentity as Identity, MemberConsumerResult as Result,
+            MemberConsumerView as View,
+        };
+        if id == self.intrinsics.error {
+            return Result::Failed;
+        }
+        if let TypeData::Intersection { types, .. } = self.store.get(id).data.clone() {
+            if types.len() != 2 {
+                return Result::Unsupported;
+            }
+            let mut views = Vec::new();
+            for part in types {
+                let apparent = self.apparent_type(part);
+                match self.member_consumer_view_worker(apparent, name, receiver, path) {
+                    Result::Complete(view) => views.push(view),
+                    other => return other,
+                }
+            }
+            let mut first = views.remove(0);
+            let second = views.remove(0);
+            // Native compareProperties does NOT compare writes. A merged
+            // instantiated clone keeps the first supplier/mapper/write.
+            if first.root == second.root
+                && first.read == second.read
+                && first.optional == second.optional
+                && first.readonly == second.readonly
+                && first.accessibility == second.accessibility
+            {
+                first.identity = if first.supplier == second.supplier {
+                    Identity::Single
+                } else {
+                    Identity::Merged
+                };
+            } else {
+                first.read = self.get_intersection_type(&[first.read, second.read], None);
+                first.identity = Identity::Synthesized;
+                // A general synthesized writable view needs native index,
+                // union and deferred rules; this read consumer does not use it.
+                first.write = None;
+            }
+            return Result::Complete(first);
+        }
+        let TypeData::Named { members: Some(owner), .. } = self.store.get(id).data else {
+            return Result::Unsupported;
+        };
+        let owner = self.binder.merged_symbol(owner);
+        if !self
+            .binder
+            .symbols()
+            .get(owner)
+            .flags
+            .intersects(SymbolFlags::INTERFACE | SymbolFlags::CLASS)
+        {
+            return Result::Unsupported;
+        }
+        if self.resolutions.on_stack(owner, crate::resolution::PropertyName::ResolvedBaseTypes)
+            || path.contains(&owner)
+        {
+            // Native re-entry still returns its valid partial prefix. Exposing
+            // it here never publishes that prefix as an immutable complete view.
+            return Result::Active { prefix: self.get_base_types(owner) };
+        }
+        self.get_declared_type_of_symbol(owner);
+        let bases = self.get_base_types(owner);
+        path.push(owner);
+        let result = if let Some(&property) = self.binder.symbols().get(owner).members.get(name) {
+            let flags = self.binder.symbols().get(property).flags;
+            if !flags.intersects(
+                SymbolFlags::PROPERTY | SymbolFlags::GET_ACCESSOR | SymbolFlags::SET_ACCESSOR,
+            ) {
+                Result::Unsupported
+            } else {
+                let declared = self.get_type_of_symbol(property);
+                let read = self.instantiate_for_reference_with_this(id, declared, receiver);
+                let write = self.accessor_write_parameter(property).map(|parameter| {
+                    self.instantiate_for_reference_with_this(id, parameter.r#type, receiver)
+                });
+                if read == self.intrinsics.error || write == Some(self.intrinsics.error) {
+                    Result::Failed
