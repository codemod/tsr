+    /// inherited from a class or interface base reads its declaring owner's
+    /// polymorphic `this` as `this_argument`. The receiver substitution
+    /// ([`Self::instantiate_for_reference_with_this`]) maps only the
+    /// receiver's own `this`; this maps the declaring owner's. Without it
+    /// `interface Y extends X {}` reads X's `a: (p: this) => void` as
+    /// `(p: X.this) => void` on `Y`, and `Y` is not assignable to `X`.
+    ///
+    /// No cache: one owner lookup, and an instantiation only when the
+    /// owner's `this` has been minted and is mentioned.
+    pub(crate) fn inherited_member_with_this_argument(
+        &mut self,
+        receiver: TypeId,
+        property: SymbolId,
+        instantiated: TypeId,
+        this_argument: TypeId,
+    ) -> TypeId {
+        let Some(owner) = self.binder.symbols().get(property).parent else {
+            return instantiated;
