+    #[test]
+    fn callable_mapping_keeps_outer_and_own_generic_parameters_distinct() {
+        for (body, own) in
+            [("function f(){return x}", false), ("function f<U>(u:U){return u}", true)]
+        {
+            let source = format!("function outer<T>(x:T){{{body} return f}}");
+            for return_first in [false, true] {
+                let arena = tsr_core::Arena::new();
+                let parsed = tsr_parser::parse(&arena, &source);
+                assert!(parsed.diagnostics.is_empty());
+                let bound = tsr_binder::bind(
+                    &arena,
+                    parsed.source_file,
+                    &parsed.nodes,
+                    tsr_binder::FileInfo { name: "outer.ts", text: &source },
+                );
+                let mut checker = crate::Checker::new(&bound, &parsed.nodes, &parsed.node_map);
+                let tsr_ast::Statement::FunctionDeclaration(outer) =
+                    parsed.source_file.statements[0]
+                else {
+                    panic!("outer")
+                };
+                let outer_signature =
+                    checker.get_signature_from_declaration(outer.node_id.unwrap()).unwrap();
+                let parameters = checker.type_parameter_types(&outer_signature).unwrap();
+                let function=(0..u32::try_from(parsed.nodes.len()).unwrap()).find_map(|index| {
+                    let id=tsr_ast::NodeId::new(index);
+                    matches!(parsed.node_map.get(id),Some(tsr_ast::Node::FunctionDeclaration(n)) if n.name.is_some_and(|name|name.text=="f")).then_some(id)
+                }).unwrap();
+                let original = checker.get_type_of_symbol(bound.symbol_of(function).unwrap());
+                if return_first {
+                    let sig = checker.resolve_call_signature(original, None).unwrap();
+                    checker.get_return_type_of_signature(&sig).unwrap();
+                }
+                for _ in 0..3 {
+                    let number = checker.intrinsics.number;
+                    let mapped = checker.instantiate_type(
+                        original,
+                        &[(parameters[0], number)],
+                        &parameters,
+                        &["T"],
+                    );
+                    assert_ne!(
+                        mapped, checker.intrinsics.error,
+                        "outer mapping must remain supported"
+                    );
+                    let signature = checker.resolve_call_signature(mapped, None).unwrap();
+                    let returned = checker.get_return_type_of_signature(&signature).unwrap();
+                    if own {
+                        assert_eq!(signature.type_parameters.len(), 1);
+                        assert_eq!(returned, checker.parameter_type(&signature.parameters[0]));
+                        assert_ne!(returned, number, "own U cannot become outer T's image");
+                    } else {
+                        assert_eq!(returned, number, "outer T must become number");
+                    }
+                }
+            }
+        }
+    }
