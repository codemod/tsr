+    #[test]
+    fn late_bound_lookup_skips_unbound_duplicate_declarations() {
+        with_checker("const key = 'late'; class Shape { [key] = 1 }", |checker, root| {
+            let owner = checker.binder.lookup_local(root, "Shape").unwrap();
+            let members = checker.late_bound_members_of(owner, false);
+            assert_eq!(members.len(), 1);
+            let member = members[0].1;
+            let expected = checker.binder.symbol_of(member).unwrap();
+            assert!(checker.binder.symbol_of(root).is_none());
+            checker.late_bound_member_names.insert(
+                (owner, false), vec![("late".into(), root), ("late".into(), member)]);
+            for _ in 0..2 {
+                assert_eq!(checker.get_property_of_declared_symbol(owner, "late", &mut Vec::new()), Some(expected));
+                assert_eq!(checker.get_property_of_declared_symbol(owner, "absent", &mut Vec::new()), None);
+            }
+        });
+    }
+
+    #[test]
+    fn late_bound_lookup_preserves_marker_then_recovers_inherited_identity() {
+        with_checker("const key = 'late'; class Base { [key] = 1 } class Derived extends Base {}", |checker, root| {
+            let base = checker.binder.lookup_local(root, "Base").unwrap();
+            let derived = checker.binder.lookup_local(root, "Derived").unwrap();
+            let expected = checker.get_property_of_declared_symbol(derived, "late", &mut Vec::new()).unwrap();
+            checker.late_bound_member_names.insert((base, false), Vec::new());
+            assert_eq!(checker.get_property_of_declared_symbol(derived, "late", &mut Vec::new()), None);
+            // Test-only reset: production has no invalidation writer for this cache.
+            checker.late_bound_member_names.remove(&(base, false));
+            for _ in 0..2 {
+                assert_eq!(checker.get_property_of_declared_symbol(derived, "late", &mut Vec::new()), Some(expected));
+            }
+        });
