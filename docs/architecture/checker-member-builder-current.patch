+
+    fn publication_thisless_interface(&mut self,owner:SymbolId,active:&mut Vec<SymbolId>) -> bool {
+        // The native declaration's this slot remains nil while its admission
+        // is active. This guard is not a completed member-image publication.
+        if active.contains(&owner) {return true;}
+        active.push(owner);
+        let declarations=self.binder.symbols().get(owner).declarations.to_vec();
+        let result=declarations.into_iter().all(|node| {
+            let Some(Node::InterfaceDeclaration(interface))=self.node_map.get(node) else {return true};
+            if self.binder.facts(node).contains(tsr_binder::NodeFacts::CONTAINS_THIS) {return false;}
+            for clause in interface.heritage_clauses {
+                if clause.token.kind!=tsr_ast::SyntaxKind::ExtendsKeyword {continue;}
+                for entry in clause.types {
+                    if !matches!(entry.expression,Some(tsr_ast::Expression::Identifier(_)|tsr_ast::Expression::PropertyAccessExpression(_))) {continue;}
+                    let Some(base)=self.base_symbol_of_heritage_entry(entry,false) else {return false};
+                    let base=self.binder.merged_symbol(base);
+                    if !self.binder.symbols().get(base).flags.contains(SymbolFlags::INTERFACE)
+                        || !self.local_type_parameters_of(base).is_empty()
+                        || self.this_types.contains_key(&base)
+                        || self.binder.symbols().get(base).declarations.iter().any(|node|self.this_type_nodes.contains_key(node))
+                        || !self.publication_thisless_interface(base,active) {return false;}
+                }
+            }
+            true
+        });
+        active.pop();
+        result
+    }
