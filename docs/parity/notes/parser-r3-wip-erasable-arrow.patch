+    /// The last arm of `Checker.checkGrammarArrowFunction`
+    /// (`grammarchecks.go:790`): TS1200 on the `=>` when its full text — the
+    /// token and the trivia before it — holds a line break.
+    ///
+    /// The trivia starts where the previous token ends, which is the end of
+    /// the arrow's last child before the `=>` or a `)` after it, so the scan
+    /// runs from there and reads the scanner's `PRECEDING_LINE_BREAK` on the
+    /// `=>` (set for a line break in whitespace or inside a comment, as
+    /// `strings.ContainsFunc(…, IsLineBreak)` is). Upstream reaches it after
+    /// `checkGrammarModifiers`, the type-parameter list and the parameter
+    /// list report nothing; the first two are this dispatcher's own gates and
+    /// the empty-list arm, the third (`check_grammar_parameter_list`) is not
+    /// consulted.
+    fn check_grammar_arrow_line_terminator(
+        &mut self,
+        typed: Node<'_>,
+        arrow: &tsr_ast::ArrowFunction<'_>,
+    ) {
+        let Some(arrow_token) = arrow.equals_greater_than_token.and_then(|t| t.node_id) else {
+            return;
+        };
+        let Some(node) = typed.node_id() else { return };
+        let arrow_span = self.nodes.span(arrow_token);
+        if arrow_span.start == arrow_span.end {
+            return;
+        }
+        let mut from = self.nodes.span(node).start;
+        tsr_ast::for_each_child_id(typed, |child| {
+            let end = self.nodes.span(child).end;
+            if child != arrow_token && end <= arrow_span.start {
+                from = from.max(end);
+            }
+        });
+        let Some(file) = self.source_file_of_for_diagnostics(node) else { return };
+        let Some(text) = self.module_host.and_then(|host| host.source_text(file, self.nodes))
+        else {
+            return;
+        };
+        let mut scanner = tsr_scanner::Scanner::new(text);
+        scanner.set_range(from, arrow_span.end);
+        let line_break = loop {
+            let token = scanner.scan();
+            if token.kind == SyntaxKind::EndOfFile {
+                return;
+            }
+            if token.span.start >= arrow_span.start {
+                break token.span.start == arrow_span.start
+                    && token.flags.contains(tsr_scanner::TokenFlags::PRECEDING_LINE_BREAK);
+            }
+        };
+        if line_break {
+            self.report(
+                file,
+                Diagnostic::new(&messages::LINE_TERMINATOR_NOT_PERMITTED_BEFORE_ARROW, arrow_span),
+            );
+        }
+    }
