+                let Some(owner) = symbol_owner else { return };
+                let members_table = matches!(destination, Destination::Members);
+                let symbol = self.symbols.get(owner);
+                let field = if members_table { &symbol.members } else { &symbol.exports };
+                if field.capacity() != 0 {
+                    return;
+                }
+                let Some(declaration) = symbol.declarations.last().copied() else { return };
+                let hints = if declaration == self.file_node {
+                    TableHints { exports: self.file_statements, ..TableHints::default() }
+                } else if let Some(&(_, node)) =
+                    self.ancestors.iter().rev().find(|(id, _)| *id == declaration)
+                {
+                    TableHints::of(node)
+                } else {
+                    return;
+                };
+                let hint = if members_table { hints.members } else { hints.exports };
+                if hint > 0 {
+                    let symbol = self.symbols.get_mut(owner);
+                    let field =
+                        if members_table { &mut symbol.members } else { &mut symbol.exports };
+                    // The insert that follows publishes the table anyway.
+                    field.initialize().reserve(hint);
+                }
+            }
+            Destination::GlobalExports => {}
+        }
+    }
