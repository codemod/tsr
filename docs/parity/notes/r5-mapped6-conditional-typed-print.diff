+/// emitConditionalType emits its check type at `TypePrecedenceUnion`
+/// (`printer.go:2060`), so a conditional or function check type keeps its
+/// parentheses. Same text reader as [`binds_below_intersection`].
+pub(crate) fn binds_below_union(text: &str) -> bool {
+    text_precedence(text) < Precedence::Union
+}
+
+/// In a conditional's `extends` clause `emitTypeNode` raises the precedence
+/// to `TypePrecedenceFunction` (`printer.go:2275`), so a conditional extends
+/// type is parenthesised. Same text reader as [`binds_below_intersection`].
+pub(crate) fn binds_below_function(text: &str) -> bool {
+    text_precedence(text) < Precedence::Function
+}
