+    #[test]
+    fn retained_bound_handle_preserves_identity_without_borrowing_program_records() {
+        fn assert_send_sync<T: Send + Sync>() {}
+        assert_send_sync::<SymbolRef>();
+        let (handle, weak) = {
+            let mut program = SymbolStore::new();
+            let raw = program.create("retained", SymbolFlags::PROPERTY);
+            let mut types = crate::TypeStore::new();
+            let unresolved = crate::Intrinsics::create(&mut types).unresolved;
+            let checker = CheckerSymbols::new(&program, unresolved);
+            let weak = Arc::downgrade(&checker.program_domain.0);
+            (checker.bound(raw).unwrap(), weak)
+        };
+        assert!(weak.upgrade().is_some(), "the holder survives the records and checker");
+        let transferred = std::thread::spawn(move || handle).join().unwrap();
+        let clone = transferred.clone();
+        drop(transferred);
+        assert!(weak.upgrade().is_some());
+
+        let mut replacement = SymbolStore::new();
+        let reused_index = replacement.create("replacement", SymbolFlags::PROPERTY);
+        let mut types = crate::TypeStore::new();
+        let unresolved = crate::Intrinsics::create(&mut types).unresolved;
+        let checker = CheckerSymbols::new(&replacement, unresolved);
+        assert_ne!(checker.bound(reused_index).unwrap(), clone);
+        assert!(matches!(checker.view(&clone), Err(SymbolAccessError::ForeignProgram)));
+        drop(clone);
+        assert!(weak.upgrade().is_none(), "no global holder registry retains the stamp");
+    }
