@@ -0,0 +1,130 @@
+package checker
+
+// These are synthetic internal API-state controls, not CLI workload counts.
+// They build legal low-level containers with pre-resolved declaration tables;
+// no claim is made that a public source naturally reaches each injected state.
+import (
+	"github.com/microsoft/typescript-go/internal/ast"
+	"slices"
+	"testing"
+)
+
+func mcChecker() *Checker {
+	c := &Checker{id: 1, memberCompletionProbe: &memberCompletionProbe{rows: map[*Type]*memberCompletionRow{}}}
+	c.compareSymbols = c.compareSymbolsWorker
+	return c
+}
+func mcProperty(name string) *ast.Symbol {
+	return &ast.Symbol{Name: name, Flags: ast.SymbolFlagsProperty}
+}
+func mcNames(d *StructuredType) []string {
+	out := []string{}
+	for _, s := range d.properties {
+		out = append(out, s.Name)
+	}
+	return out
+}
+func mcRequire(t *testing.T, ok bool, message string) {
+	t.Helper()
+	if !ok {
+		t.Fatal(message)
+	}
+}
+
+func TestMemberCompletionPublishedViews(t *testing.T) {
+	c := mcChecker()
+	obj := c.newObjectType(ObjectFlagsAnonymous, nil)
+	// Artificial builder depth is observation metadata, not a native builder.
+	finish := c.memberCompletionBegin(obj, "synthetic-state")
+	c.setStructuredTypeMembers(obj, nil, nil, nil, nil)
+	empty := c.resolveStructuredTypeMembers(obj)
+	mcRequire(t, len(empty.properties) == 0, "active published empty is readable")
+	r := c.memberCompletionRow(obj)
+	mcRequire(t, r.ActiveFlagHits == 1 && r.FinalFlagHits == 0, "resolved bit during active publication is not a final-state read")
+	own := mcProperty("own")
+	obj.objectFlags |= ObjectFlagsUnresolvedMembers
+	c.setStructuredTypeMembers(obj, ast.SymbolTable{"own": own}, nil, nil, nil)
+	provisional := c.resolveStructuredTypeMembers(obj)
+	mcRequire(t, slices.Equal(mcNames(provisional), []string{"own"}), "provisional own-member view is visible")
+	mcRequire(t, r.UnresolvedFlagHits == 1, "unresolved inheritance remains distinct")
+	base := mcProperty("base")
+	call, construct := &Signature{}, &Signature{}
+	index := &IndexInfo{}
+	obj.objectFlags &^= ObjectFlagsUnresolvedMembers
+	c.setStructuredTypeMembers(obj, ast.SymbolTable{"own": own, "base": base}, []*Signature{call}, []*Signature{construct}, []*IndexInfo{index})
+	finish()
+	final := c.resolveStructuredTypeMembers(obj)
+	mcRequire(t, slices.Equal(mcNames(final), []string{"base", "own"}), "final publication installs the full sorted view")
+	mcRequire(t, final.members["own"] == own && final.members["base"] == base, "publication preserves symbol identity")
+	mcRequire(t, len(final.signatures) == 2 && final.callSignatureCount == 1 && final.signatures[0] == call && final.signatures[1] == construct && final.indexInfos[0] == index, "signatures and indexes are part of the view")
+	mcRequire(t, empty == final && provisional == final, "native returned structured view is mutable, not an immutable snapshot")
+	mcRequire(t, r.FinalFlagHits == 1 && r.Workers["anonymous"] == 0, "reads of published states do not re-run an anonymous worker")
+	completedEmpty := c.newAnonymousType(nil, nil, nil, nil, nil)
+	c.resolveStructuredTypeMembers(completedEmpty)
+	er := c.memberCompletionRow(completedEmpty)
+	mcRequire(t, er.FinalFlagHits == 1 && er.ActiveFlagHits == 0 && len(completedEmpty.AsStructuredType().properties) == 0, "completed empty must remain distinct from active empty")
+}
+
+func TestMemberCompletionBaseResetAndRebuild(t *testing.T) {
+	c := mcChecker()
+	s := &ast.Symbol{Name: "MC_Interface", Flags: ast.SymbolFlagsInterface}
+	obj := c.newObjectType(ObjectFlagsInterface, s)
+	d := obj.AsInterfaceType()
+	own := mcProperty("own")
+	d.declaredMembersResolved = true
+	d.declaredMembers = ast.SymbolTable{"own": own}
+	// Inject a partial publication before bases have resolved. This exercises
+	// the real getBaseTypes reset; it does not model a complete source program.
+	c.setStructuredTypeMembers(obj, nil, nil, nil, nil)
+	c.resolveStructuredTypeMembers(obj)
+	c.getBaseTypes(obj)
+	r := c.memberCompletionRow(obj)
+	mcRequire(t, d.baseTypesResolved && obj.objectFlags&ObjectFlagsMembersResolved == 0, "actual base resolution resets a previously published member view")
+	mcRequire(t, r.ResolvedResets == 1 && r.ResetCalls == 1, "observe actual reset, not just an unconditionally reached reset line")
+	rebuilt := c.resolveStructuredTypeMembers(obj)
+	mcRequire(t, slices.Equal(mcNames(rebuilt), []string{"own"}) && rebuilt.members["own"] == own, "next read must execute the builder and install declared members")
+	mcRequire(t, r.Workers["class"] == 1 && r.Workers["object"] == 1, "class wrapper and nested object are one builder path")
+	for range 16 {
+		c.resolveStructuredTypeMembers(obj)
+	}
+	mcRequire(t, r.Workers["class"] == 1 && r.Workers["object"] == 1 && r.FinalFlagHits == 17, "completed repeated reads do not repeat builder work")
+	mcRequire(t, len(c.typeResolutions) == 0, "base resolution balances its resolution stack")
+}
+
+func TestMemberCompletionReferenceArgumentsAndThis(t *testing.T) {
+	c := mcChecker()
+	s := &ast.Symbol{Name: "MC_Generic", Flags: ast.SymbolFlagsInterface}
+	target := c.newObjectType(ObjectFlagsInterface, s)
+	d := target.AsInterfaceType()
+	p, q, this := c.newTypeParameter(nil), c.newTypeParameter(nil), c.newTypeParameter(nil)
+	d.allTypeParameters = []*Type{p, q, this}
+	d.declaredMembersResolved, d.baseTypesResolved = true, true
+	d.instantiations = map[CacheHashKey]*Type{}
+	number := c.newIntrinsicType(TypeFlagsNumber, "number")
+	str := c.newIntrinsicType(TypeFlagsString, "string")
+	a := c.createTypeReference(target, []*Type{number, str})
+	same := c.createTypeReference(target, []*Type{number, str})
+	reversed := c.createTypeReference(target, []*Type{str, number})
+	mcRequire(t, a == same && a != reversed, "ordered concrete arguments control native reference identity")
+	c.resolveStructuredTypeMembers(a)
+	for range 16 {
+		c.resolveStructuredTypeMembers(a)
+	}
+	c.resolveStructuredTypeMembers(reversed)
+	r := c.memberCompletionRow(a)
+	mcRequire(t, r.Workers["reference"] == 1 && r.Workers["object"] == 1 && r.FinalFlagHits == 16, "one concrete reference completion then completed reads")
+	ref := r.References[0]
+	mcRequire(t, slices.Equal(ref.Arguments, []TypeId{number.id, str.id}) && slices.Equal(ref.Padded, []TypeId{number.id, str.id, a.id}) && ref.ThisAppended, "reference builder appends the concrete receiver this")
+	other := c.memberCompletionRow(reversed).References[0]
+	mcRequire(t, slices.Equal(other.Padded, []TypeId{str.id, number.id, reversed.id}), "different ordered arguments retain a distinct receiver")
+	clone := c.cloneTypeReference(a)
+	mcRequire(t, clone != a && clone.objectFlags&ObjectFlagsMembersResolved == 0 && clone.Target() == target && slices.Equal(clone.AsTypeReference().resolvedTypeArguments, a.AsTypeReference().resolvedTypeArguments), "native clone preserves arguments/target but clears resolved member state")
+	c.resolveStructuredTypeMembers(clone)
+	mcRequire(t, c.memberCompletionRow(clone).Workers["reference"] == 1, "a cloned unresolved reference must build its own view")
+	foreignChecker := mcChecker()
+	var foreign *Type
+	for range c.TypeCount {
+		foreign = foreignChecker.newObjectType(ObjectFlagsAnonymous, nil)
+	}
+	mcRequire(t, foreign.id == clone.id && foreign.checker != clone.checker, "equal numeric TypeIds still belong to distinct private checker domains")
+}
