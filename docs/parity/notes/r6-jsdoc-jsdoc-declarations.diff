diff --git a/crates/tsr-binder/tests/jsdoc_declarations.rs b/crates/tsr-binder/tests/jsdoc_declarations.rs
new file mode 100644
index 0000000..172089a
--- /dev/null
+++ b/crates/tsr-binder/tests/jsdoc_declarations.rs
@@ -0,0 +1,60 @@
+//! JSDoc declarations bound through `declareSymbol`, pinned to 5b1047d1: an
+//! `@import` binding is a `JSImportDeclaration` alias in the file's locals
+//! (`declareModuleMember`'s alias arm, `binder/binder.go:380`), and a
+//! module-level `@typedef` is implicitly exported
+//! (`IsImplicitlyExportedJSDocDeclaration`, `ast/utilities.go:4184`).
+//! `docs/parity/notes/r6-jsdoc.md` §7.
+
+use tsr_ast::NodeFlags;
+use tsr_binder::{BindResult, FileInfo, SymbolFlags};
+use tsr_core::Arena;
+
+/// The binder's diagnostics as `(code, text at the span)`, and whether the
+/// file's module symbol exports `name`, with that export's flags.
+fn bind(source: &str, name: &str) -> (Vec<(u32, String)>, Option<SymbolFlags>) {
+    let arena = Arena::new();
+    let mut parsed =
+        tsr_parser::parse_with_options(&arena, source, tsr_parser::ParseOptions::for_file("t.js"));
+    assert!(parsed.diagnostics.is_empty());
+    let root = parsed.source_file.node_id.expect("registered source file");
+    parsed.nodes.add_flags(root, NodeFlags::JAVASCRIPT_FILE);
+    let docs: Vec<_> = parsed.jsdoc.iter().collect();
+    let bound = tsr_binder::bind_into_with_jsdoc(
+        BindResult::empty(),
+        &arena,
+        parsed.source_file,
+        &parsed.nodes,
+        FileInfo { name: "t.js", text: source },
+        &docs,
+    );
+    let diagnostics = bound
+        .diagnostics()
+        .iter()
+        .map(|d| (d.message.code(), source[d.span.start as usize..d.span.end as usize].to_string()))
+        .collect();
+    let export = bound
+        .symbol_of(root)
+        .and_then(|module| bound.symbols().get(module).exports.get(name).copied())
+        .map(|symbol| bound.symbols().get(symbol).flags);
+    (diagnostics, export)
+}
+
+/// `importTag4`: the same name imported twice is TS2300 on both.
+#[test]
+fn a_repeated_import_tag_binding_is_a_duplicate() {
+    let source = "/**\n * @import { Foo } from \"./types\"\n */\n\n/**\n * @import { Foo } from \"./types\"\n */\n\n/** @param {Foo} foo */\nfunction f(foo) {}\n";
+    let (diagnostics, _) = bind(source, "Foo");
+    assert_eq!(diagnostics, [(2300, "Foo".to_string()), (2300, "Foo".to_string())]);
+}
+
+/// A module's top-level typedef is exported, and conflicts there.
+#[test]
+fn a_module_typedef_is_implicitly_exported() {
+    let source = "/** @typedef {number} Foo */\nexport const x = 1;\n";
+    let (diagnostics, export) = bind(source, "Foo");
+    assert!(diagnostics.is_empty());
+    assert!(export.is_some_and(|flags| flags.contains(SymbolFlags::TYPE_ALIAS)));
+    let source = "export default class C {}\n/** @typedef {number} default */\nvar x;\n";
+    let (diagnostics, _) = bind(source, "default");
+    assert_eq!(diagnostics, [(2300, "default".to_string()), (2300, "C".to_string())]);
+}
