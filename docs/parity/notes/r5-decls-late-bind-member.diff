+    /// `lateBindMember`'s report (`checker.go:16045`): TS2300 at each
+    /// declaration's name. The argument is the late-bound property name, or
+    /// for a unique-symbol name `scanner.DeclarationNameToString` of the
+    /// declaration being bound (`current`).
+    pub(crate) fn report_late_bound_duplicates(
+        &mut self,
+        declarations: &[NodeId],
+        current: NodeId,
+        member_name: &str,
+    ) {
+        let Some(current_name) = self.declaration_name_of(current) else { return };
+        let unique = match self.node_map.get(current_name) {
+            Some(Node::ComputedPropertyName(computed)) => computed.expression.is_some_and(|e| {
+                let name_type = self.check_expression(e);
+                self.type_of(name_type).flags.intersects(TypeFlags::UNIQUE_ES_SYMBOL)
+            }),
+            _ => false,
+        };
+        let name = if unique {
+            let Some(spelled) = self.overload_name_to_string(current_name) else { return };
+            spelled
+        } else {
+            member_name.to_string()
+        };
+        for &declaration in declarations {
+            let at = self.declaration_name_of(declaration).unwrap_or(declaration);
+            let Some(file) = self.source_file_of_for_diagnostics(at) else { continue };
+            let span = self.error_span(at);
+            self.report(
+                file,
+                Diagnostic::with_args(&messages::DUPLICATE_IDENTIFIER_0, span, [name.clone()]),
+            );
+        }
+    }
