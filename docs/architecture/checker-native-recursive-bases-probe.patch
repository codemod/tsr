+package checker
+
+import "github.com/microsoft/typescript-go/internal/ast"
+
+// Private recorder: hook snapshots read existing fields only. Exported test
+// queries below intentionally execute native operations and are not passive.
+type NativeBaseType struct {
+	ID      uint32      `json:"id"`
+	Name    string      `json:"name"`
+	Flags   TypeFlags   `json:"flags"`
+	Objects ObjectFlags `json:"objects"`
+}
+
+func nativeBaseType(t *Type) NativeBaseType {
+	v := NativeBaseType{}
+	if t != nil {
+		v.ID = uint32(t.id)
+		v.Flags = t.flags
+		v.Objects = t.objectFlags
+		if t.symbol != nil {
+			v.Name = t.symbol.Name
+		}
+	}
+	return v
+}
+
+type NativeBaseFrame struct {
+	Target NativeBaseType `json:"target"`
+	Result bool           `json:"result"`
+}
+type NativeBaseEvent struct {
+	Kind            string            `json:"kind"`
+	Type            NativeBaseType    `json:"type"`
+	Related         NativeBaseType    `json:"related"`
+	Resolved        bool              `json:"resolved"`
+	MembersResolved bool              `json:"members_resolved"`
+	Bases           []NativeBaseType  `json:"bases"`
+	Stack           []NativeBaseFrame `json:"stack"`
+}
+type NativeBaseProbe struct {
+	Events []NativeBaseEvent `json:"events"`
+}
+
+func (c *Checker) NativeBaseStart() { c.nativeBaseProbe = &NativeBaseProbe{} }
+func (c *Checker) nativeBaseObserve(kind string, t, related *Type) {
+	if c.nativeBaseProbe == nil || t == nil || t.objectFlags&(ObjectFlagsClassOrInterface|ObjectFlagsTuple) == 0 {
+		return
+	}
+	d := t.AsInterfaceType()
+	v := NativeBaseEvent{Kind: kind, Type: nativeBaseType(t), Related: nativeBaseType(related), Resolved: d.baseTypesResolved, MembersResolved: t.objectFlags&ObjectFlagsMembersResolved != 0}
+	for _, base := range d.resolvedBaseTypes {
+		v.Bases = append(v.Bases, nativeBaseType(base))
+	}
+	for _, frame := range c.typeResolutions {
+		if frame.propertyName == TypeSystemPropertyNameResolvedBaseTypes {
+			v.Stack = append(v.Stack, NativeBaseFrame{Target: nativeBaseType(frame.target.(*Type)), Result: frame.result})
+		}
+	}
+	c.nativeBaseProbe.Events = append(c.nativeBaseProbe.Events, v)
+}
+func (c *Checker) NativeBaseEvents() []NativeBaseEvent {
+	return append([]NativeBaseEvent(nil), c.nativeBaseProbe.Events...)
+}
+func (c *Checker) NativeBaseResolve(symbol *ast.Symbol) NativeBaseEvent {
+	t := c.getDeclaredTypeOfSymbol(symbol)
+	c.getBaseTypes(t)
+	c.nativeBaseObserve("test-base-result", t, nil)
+	return c.nativeBaseProbe.Events[len(c.nativeBaseProbe.Events)-1]
+}
