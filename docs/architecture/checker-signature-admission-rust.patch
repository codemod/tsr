+    #[test]
+    fn uncomputed_callable_identity_obeys_nonempty_mapper_instantiation_budget() {
+        let source = "function f(){} namespace f {export const bar=1}";
+        for (depth, count, refuse) in [(100, 0, true), (0, 5_000_000, true), (0, 0, false)] {
+            let arena = tsr_core::Arena::new();
+            let parsed = tsr_parser::parse(&arena, source);
+            assert!(parsed.diagnostics.is_empty());
+            let bound = tsr_binder::bind(
+                &arena,
+                parsed.source_file,
+                &parsed.nodes,
+                tsr_binder::FileInfo { name: "budget.ts", text: source },
+            );
+            let mut checker = crate::Checker::new(&bound, &parsed.nodes, &parsed.node_map);
+            let root = parsed.source_file.node_id.unwrap();
+            let symbol = bound.lookup_local(root, "f").unwrap();
+            let callable = checker.get_type_of_symbol(symbol);
+            assert!(!checker.signature_types.contains_key(&callable));
+            checker.instantiation_depth = depth;
+            checker.instantiation_count = count;
+            let number = checker.intrinsics.number;
+            let string = checker.intrinsics.string;
+            let mapped = checker.instantiate_type(callable, &[(number, string)], &[], &[]);
+            assert_eq!(
+                mapped,
+                if refuse { checker.intrinsics.error } else { callable },
+                "native nonempty mapper budget depth={depth}, count={count}"
+            );
+            assert_eq!(checker.instantiation_depth, depth);
+            assert_eq!(checker.instantiation_count, count + u32::from(!refuse));
+            assert!(!checker.signature_types.contains_key(&callable));
+            assert!(checker.instantiated_objects.is_empty());
+            assert_eq!(
+                checker.instantiate_type(callable, &[], &[], &[]),
+                callable,
+                "native nil mapper precedes budget"
+            );
+            assert_eq!(checker.instantiation_count, count + u32::from(!refuse));
+        }
+    }
