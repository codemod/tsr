+#[test]
+fn an_object_binding_pattern_type_relates_structurally() {
+    // `declarationsAndAssignments` 106: getTypeFromObjectBindingPattern's
+    // anonymous object is compared member by member, and a missing required
+    // member is TS2741; a primitive argument against it is TS2345.
+    let source = r#"function g({ x, y = false }) { }
+g({ y: false }); // error
+g({ x: 0 });
+function g0({ x }) { }
+g0("s"); // error
+"#;
+    assert_eq!(lines_of(source, &[2741, 2345]), marked(source));
+}
