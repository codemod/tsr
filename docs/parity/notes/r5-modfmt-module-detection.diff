+pub fn bind_file_forcing_module<'a, 'n>(
+    names: &'n PreparedNames<'a>,
+    nodes: &'n NodeTable,
+    file: &'a SourceFile<'a>,
+    info: FileInfo<'a>,
+    jsdoc: &[(NodeId, &'a [&'a tsr_ast::JSDoc<'a>])],
+    node_range: std::ops::Range<u32>,
+    force_module: bool,
+) -> FileBindResult<'a, 'n> {
+    binder::Binder::bind_independent_forcing(
+        names,
+        nodes,
+        file,
+        info,
+        jsdoc,
+        node_range,
+        force_module,
+    )
+}
