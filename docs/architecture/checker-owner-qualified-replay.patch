+        let source_id = first.view(&a).unwrap().identity_id();
+        assert_eq!(second.view(&b).unwrap().identity_id(), source_id);
+        let copy = first.clone_module_symbol(&a).unwrap();
+        let twin = first.clone_module_symbol(&a).unwrap();
+        let twin_id = first.view(&twin).unwrap().identity_id();
+        let copy_id = first.view(&copy).unwrap().identity_id();
+        assert!(twin_id < copy_id, "query order owns lazy IDs");
+        assert_ne!(source_id, copy_id);
+        assert_ne!(source_id, twin_id);
