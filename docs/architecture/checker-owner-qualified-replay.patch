+#[cfg(test)]
+mod native_identity_tests {
+    use super::*;
+
+    #[test]
+    fn identities_publish_on_first_read_and_survive_store_relocation() {
+        let mut local = SymbolStore::new();
+        let first = local.create("same", SymbolFlags::PROPERTY);
+        let second = local.create("same", SymbolFlags::PROPERTY);
+        let second_id = local.get(second).identity_id();
+        let first_id = local.get(first).identity_id();
+        assert!(second_id < first_id, "first read, not creation, orders IDs");
+        assert_eq!(local.get(second).identity_id(), second_id);
+        let mut global = SymbolStore::new();
+        global.create("prefix", SymbolFlags::PROPERTY);
+        let base = global.append(local);
+        assert_eq!(global.get(second.relocated(base)).identity_id(), second_id);
+        assert_eq!(global.get(first.relocated(base)).identity_id(), first_id);
+    }
+
+    #[test]
+    fn concurrent_readers_publish_one_bound_identity() {
+        let mut store = SymbolStore::new();
+        let symbol = store.create("same", SymbolFlags::PROPERTY);
+        let barrier = std::sync::Barrier::new(8);
+        let ids = std::thread::scope(|scope| {
+            let readers: Vec<_> = (0..8)
+                .map(|_| {
+                    scope.spawn(|| {
+                        barrier.wait();
+                        store.get(symbol).identity_id()
+                    })
+                })
+                .collect();
+            readers.into_iter().map(|reader| reader.join().unwrap()).collect::<Vec<_>>()
+        });
+        assert!(ids[0] != 0);
+        assert!(ids.iter().all(|id| *id == ids[0]));
+        assert_eq!(store.get(symbol).identity_id(), ids[0]);
+    }
+}
