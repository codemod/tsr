+
+#[derive(Clone)]
+struct MapperOperation {
+    owner:TypeId,
+    receiver:TypeId,
+    prior:Option<MapperId>,
+}
+
+#[derive(Clone, Default)]
+pub(crate) struct MemberLinks {
+    pub(crate) target:Option<SymbolRef>,
+    pub(crate) mapper:Option<MapperId>,
+    pub(crate) read:Option<TypeId>,
+    pub(crate) write:Option<TypeId>,
+    pub(crate) containing:Option<TypeId>,
+}
+
+#[derive(Default)]
+pub(crate) struct MemberPublication {
+    images:FxHashMap<ImageKey,PropertyImage>,
+    pub(crate) links:FxHashMap<SymbolRef,MemberLinks>,
+    mappers:Vec<MapperOperation>,
+    composites:FxHashMap<(TypeId,TypeId,String),SymbolRef>,
+    apparent:FxHashMap<TypeId,TypeId>,
+    references:FxHashMap<(SymbolId,Vec<TypeId>),TypeId>,
+    reduced:FxHashMap<TypeId,bool>,
+    #[cfg(test)]
+    pub(crate) base_reentries:Vec<(SymbolId,Vec<TypeId>,bool)>,
+    #[cfg(test)]
+    pub(crate) member_entries:Vec<(SymbolId,TypeId)>,
+    #[cfg(test)]
+    pub(crate) target_resets:Vec<(SymbolId,TypeId,usize,bool)>,
+}
+
+impl Checker<'_, '_> {
+    /// getOptionalSymbolFlagForNode (binder.go:2727). Bound symbols do not
+    /// currently carry this native flag; recover the existing declaration fact
+    /// before constructing the private symbol, without forcing its type.
+    pub(crate) fn publication_optional(&self, symbol:&SymbolRef) -> bool {
+        if let Some(bound)=self.symbols.bound_id(symbol).unwrap() { self.property_is_optional(bound) }
+        else { self.symbols.view(symbol).unwrap().flags().contains(SymbolFlags::OPTIONAL) }
+    }
+
+    fn publication_new_member(&mut self, source:&SymbolRef, check:CheckFlags, optional:bool) -> SymbolRef {
+        self.symbols.new_member_from(source,check,optional).unwrap()
+    }
+
+    // Eligibility is a no-force observation. Object metadata needed by the
+    // complete native couldContainTypeVariables worker remains unsupported.
+    fn publication_invariant(&self, ty:TypeId) -> bool {
+        let value = self.store.get(ty);
+        if value.flags.intersects(TypeFlags::INSTANTIABLE | TypeFlags::OBJECT) { return false; }
+        match &value.data {
+            TypeData::Union { types, .. } | TypeData::Intersection { types, .. } => types.iter().all(|&t| self.publication_invariant(t)),
+            _ => true,
+        }
+    }
+
+    fn publication_cached_read(&self, symbol:&SymbolRef) -> Option<TypeId> {
+        match self.symbols.bound_id(symbol).expect("private ownership") {
+            Some(id) => self.symbol_types.get(&id).copied(),
+            None => self.member_publication.links.get(symbol).and_then(|l| l.read),
+        }
+    }
+
+    fn publication_instantiate(&mut self, original:SymbolRef, mapper:MapperId) -> SymbolRef {
+        let flags = self.symbols.view(&original).unwrap().flags();
+        if self.publication_cached_read(&original).is_some_and(|t| self.publication_invariant(t))
+            && (!flags.contains(SymbolFlags::SET_ACCESSOR)
+                || self.member_publication.links.get(&original).and_then(|l| l.write).is_some_and(|t| self.publication_invariant(t))) {
+            return original;
+        }
+        let check = self.symbols.view(&original).unwrap().check_flags();
+        let (target, mapper) = if check.contains(CheckFlags::INSTANTIATED) {
+            let previous = self.member_publication.links[&original].clone();
+            let mut operation = self.member_publication.mappers[mapper.0].clone();
+            operation.prior = previous.mapper;
+            let composed = MapperId(self.member_publication.mappers.len());
+            self.member_publication.mappers.push(operation);
+            (previous.target.unwrap(), composed)
+        } else { (original, mapper) };
+        let flags = CheckFlags::INSTANTIATED | (check & (CheckFlags::READONLY | CheckFlags::LATE | CheckFlags::OPTIONAL_PARAMETER | CheckFlags::REST_PARAMETER));
+        let result = self.publication_new_member(&target, flags, self.publication_optional(&target));
+        self.member_publication.links.insert(result.clone(), MemberLinks { target:Some(target), mapper:Some(mapper), ..MemberLinks::default() });
+        result
+    }
+
+    fn publication_apply(&mut self, mapper:MapperId, ty:TypeId) -> TypeId {
+        let operation = self.member_publication.mappers[mapper.0].clone();
+        let ty = if let Some(prior) = operation.prior { self.publication_apply(prior,ty) } else { ty };
+        self.instantiate_for_reference_with_this(operation.owner,ty,operation.receiver)
+    }
+
+    pub(crate) fn publication_read(&mut self, symbol:&SymbolRef) -> TypeId {
+        if let Some(read) = self.publication_cached_read(symbol) { return read; }
+        if let Some(bound) = self.symbols.bound_id(symbol).unwrap() { return self.get_type_of_symbol(bound); }
+        let links = self.member_publication.links[symbol].clone();
+        let mut read = self.publication_read(&links.target.expect("lazy target"));
+        if let Some(mapper) = links.mapper { read = self.publication_apply(mapper,read); }
+        self.member_publication.links.get_mut(symbol).unwrap().read = Some(read);
+        read
+    }
+
+    pub(crate) fn publication_write(&mut self, symbol:&SymbolRef) -> TypeId {
+        if let Some(write) = self.member_publication.links.get(symbol).and_then(|l| l.write) { return write; }
+        // getWriteTypeOfSymbol (checker.go:16434): ordinary properties remove
+        // missing after reading the instantiated symbol; accessor writes stay
+        // independently mapped, and synthetic properties use published writes.
+        let flags=self.symbols.view(symbol).unwrap().flags();
+        let check=self.symbols.view(symbol).unwrap().check_flags();
+        if flags.contains(SymbolFlags::PROPERTY) && !check.contains(CheckFlags::SYNTHETIC_PROPERTY) {
+            let read=self.publication_read(symbol);
+            let write=if self.publication_optional(symbol) {self.remove_missing_type(read)} else {read};
+            self.member_publication.links.entry(symbol.clone()).or_default().write=Some(write);
+            return write;
+        }
+        let write = if let Some(bound) = self.symbols.bound_id(symbol).unwrap() {
+            self.accessor_write_parameter(bound).map(|p| p.r#type).unwrap_or_else(|| self.get_type_of_symbol(bound))
+        } else {
+            let links = self.member_publication.links[symbol].clone();
+            let ty = self.publication_write(&links.target.expect("lazy target"));
+            if let Some(mapper) = links.mapper { self.publication_apply(mapper,ty) } else { ty }
+        };
+        self.member_publication.links.entry(symbol.clone()).or_default().write = Some(write);
+        write
+    }
+
+    pub(crate) fn publication_target(&self, symbol:&SymbolRef) -> SymbolRef {
+        if self.symbols.view(symbol).unwrap().check_flags().contains(CheckFlags::INSTANTIATED) {
+            self.member_publication.links[symbol].target.clone().unwrap()
+        } else { symbol.clone() }
+    }
+
+    pub(crate) fn publication_reset_target(&mut self, target:SymbolId) {
+        // Reset the declaration's target image only; escaped symbols and positive
+        // composite histories remain valid. This port has no native flag writer.
+        let Some(ty) = self.declared_types.get(&target).copied() else { return };
+        for (key,image) in &mut self.member_publication.images {
+            if key.ty==ty && key.receiver==ty {
+                #[cfg(test)]
+                self.member_publication.target_resets.push((target,ty,image.frames.len(),image.done));
+                image.revision+=1;
+                image.done=false;
+                for frame in &mut image.frames { *frame=image.revision; }
+            }
+        }
+    }
+
+    fn publication_image(&mut self, key:ImageKey) -> bool {
+        if let Some(image) = self.member_publication.images.get(&key)
+            && (image.done || !image.frames.is_empty()) { return true; }
+        let Some(owner) = (match self.store.get(key.ty).data {
+            TypeData::Named { members:Some(owner), .. } => Some(owner),
+            _ => None,
+        }) else { return false; };
+        if !self.binder.symbols().get(owner).flags.intersects(SymbolFlags::CLASS | SymbolFlags::INTERFACE) { return false; }
+        let target = self.get_declared_type_of_symbol(owner);
+        #[cfg(test)]
+        self.member_publication.member_entries.push((owner,key.ty));
+        let own:Vec<(String,SymbolId)> = self.binder.symbols().get(owner).members.as_ref().map(|m| m.iter().map(|(n,&s)| (n.to_string(),s)).collect()).unwrap_or_default();
+        let image = self.member_publication.images.entry(key).or_default();
+        image.frames.push(image.revision);
+        let mapper = MapperId(self.member_publication.mappers.len());
+        self.member_publication.mappers.push(MapperOperation { owner:key.ty, receiver:key.receiver, prior:None });
+        let mut members = FxHashMap::default();
+        for (name,id) in own {
+            let original = self.symbols.bound(id).unwrap();
+            let property = if key.ty==target && key.receiver==key.ty { original } else { self.publication_instantiate(original,mapper) };
+            members.insert(name,property);
+        }
+        self.member_publication.images.get_mut(&key).unwrap().members = members;
+        let bases = self.get_base_types(owner);
+        let bases_done = self.publication_bases_complete(owner);
+        let mut inherited_done = bases_done;
+        for base in bases {
+            let base = self.instantiate_for_reference_with_this(key.ty,base,key.receiver);
+            let base = self.publication_with_this(base,key.receiver);
+            let inherited = ImageKey { ty:base, receiver:key.receiver };
+            if !self.publication_image(inherited) { inherited_done=false; continue; }
+            let base_image = &self.member_publication.images[&inherited];
+            inherited_done &= base_image.done;
+            let members = base_image.members.clone();
+            let own = &mut self.member_publication.images.get_mut(&key).unwrap().members;
+            for (name,symbol) in members { own.entry(name).or_insert(symbol); }
+        }
+        let image = self.member_publication.images.get_mut(&key).unwrap();
+        image.frames.pop();
+        image.done = inherited_done && image.frames.is_empty();
+        true
+    }
+
+    /// getTypeWithThisArgument (checker.go:19573). The final this argument
+    /// belongs to the concrete reference, not a reconstructed getter key.
+    fn publication_with_this(&mut self, ty:TypeId, receiver:TypeId) -> TypeId {
+        if let TypeData::Intersection { types, .. } = self.store.get(ty).data.clone() {
+            let mapped:Vec<_> = types.iter().map(|&part| self.publication_with_this(part,receiver)).collect();
+            return if mapped==types { ty } else { self.get_intersection_type(&mapped,None) };
+        }
+        let Some(owner) = (match self.store.get(ty).data {
+            TypeData::Named { members:Some(owner), .. } => Some(owner),
+            _ => None,
+        }) else { return ty };
+        if !self.binder.symbols().get(owner).flags.intersects(SymbolFlags::CLASS|SymbolFlags::INTERFACE) { return ty; }
+        let Some(parameters) = self.local_type_parameter_types_of(owner) else { return ty };
+        let arguments = self.type_reference_targets.get(&ty).map(|(_,args)| args.clone())
+            .unwrap_or_else(|| parameters.iter().map(|(t,_)| *t).collect());
+        // An explicit final this argument is already prepared and is retained.
+        if arguments.len()!=parameters.len() { return ty; }
+        let mut full=arguments;
+        full.push(receiver);
+        let key=(owner,full.clone());
+        if let Some(&cached)=self.member_publication.references.get(&key) { return cached; }
+        let text=self.type_to_string(ty);
+        let result=self.store.new_named(TypeFlags::OBJECT,text,Some(owner));
+        self.type_reference_targets.insert(result,(owner,full));
+        self.reference_display_arity.insert(result,parameters.len());
+        self.member_publication.references.insert(key,result);
+        result
+    }
+
+    /// getApparentTypeOfIntersectionType (checker.go:21796), with the original
+    /// intersection retained as the final this argument of each reference.
+    pub(crate) fn publication_apparent(&mut self, ty:TypeId) -> TypeId {
+        if !self.store.get(ty).flags.contains(TypeFlags::INTERSECTION) { return ty; }
+        if let Some(&cached)=self.member_publication.apparent.get(&ty) { return cached; }
+        let result=self.publication_with_this(ty,ty);
+        self.member_publication.apparent.insert(ty,result);
+        result
+    }
+
+    /// getReducedType (checker.go:21819) publishes its in-progress reduction
+    /// before enumerating composite properties. No scalar links are preforced.
+    fn publication_reduce(&mut self, ty:TypeId) -> TypeId {
+        let TypeData::Intersection { types, .. }=self.store.get(ty).data.clone() else { return ty };
+        if let Some(&never)=self.member_publication.reduced.get(&ty) { return if never { self.intrinsics.never } else { ty }; }
+        self.member_publication.reduced.insert(ty,false);
+        let mut names=Vec::new();
+        for part in types {
+            let receiver=self.publication_reference_this(part);
+            let key=ImageKey {ty:part,receiver};
+            if !self.publication_image(key) { continue; }
+            for name in self.member_publication.images[&key].members.keys() {
+                if !names.contains(name) { names.push(name.clone()); }
+            }
+        }
+        names.sort();
+        for name in names { let _=self.publication_property_image(ty,ty,&name); }
+        // Existing discriminant/private admission is retained while complete
+        // native synthetic metadata remains outside this property-only port.
+        let never=self.intersection_has_never_discriminant(ty);
+        self.member_publication.reduced.insert(ty,never);
+        if never { self.intrinsics.never } else { ty }
+    }
+
+    fn publication_reference_this(&mut self, ty:TypeId) -> TypeId {
+        let Some((owner,args))=self.type_reference_targets.get(&ty).cloned() else { return ty };
+        let Some(params)=self.local_type_parameter_types_of(owner) else { return ty };
+        if args.len()==params.len()+1 { *args.last().unwrap() } else { ty }
+    }
+
+    /// getReducedApparentType (checker.go:21865) and getPropertyOfTypeEx.
+    pub(crate) fn publication_property(&mut self, ty:TypeId, _receiver:TypeId, name:&str) -> MemberQuery {
+        let reduced=self.publication_reduce(ty);
+        let apparent=self.publication_apparent(reduced);
+        let prepared=self.publication_reduce(apparent);
+        let receiver=self.publication_reference_this(prepared);
+        self.publication_property_image(prepared,receiver,name)
+    }
+
+    fn publication_property_image(&mut self, ty:TypeId, receiver:TypeId, name:&str) -> MemberQuery {
+        if let TypeData::Intersection { types, .. } = self.store.get(ty).data.clone() {
+            let cache_key = (ty,receiver,name.to_owned());
+            if let Some(symbol) = self.member_publication.composites.get(&cache_key) { return MemberQuery::Published { symbol:symbol.clone(), revision:0, active:false }; }
+            // Deferred >2, union/index/augmentation need separate native owners.
+            if types.len()>2 { return MemberQuery::Unsupported; }
+            let mut suppliers = Vec::new();
+            for part in types {
+                match self.publication_property(part,part,name) {
+                    MemberQuery::Published { symbol,active:false,.. } => suppliers.push(symbol),
+                    MemberQuery::Absent { active:false,.. } => {},
+                    _ => return MemberQuery::Unsupported,
+                }
+            }
+            let Some(first) = suppliers.first().cloned() else { return MemberQuery::Absent { revision:0,active:false }; };
+            let mut different = false;
+            let mut merged = false;
+            for supplier in suppliers.iter().skip(1) {
+                if *supplier==first { continue; }
+                let left = self.publication_target(&first);
+                let right = self.publication_target(supplier);
+                let bound_left = self.symbols.bound_id(&left).unwrap();
+                let bound_right = self.symbols.bound_id(&right).unwrap();
+                let metadata = bound_left.zip(bound_right).is_some_and(|(l,r)| {
+                    self.property_is_optional(l)==self.property_is_optional(r)
+                        && self.is_readonly_property(l)==self.is_readonly_property(r)
+                        && self.is_non_public_member(l)==self.is_non_public_member(r)
+                });
+                let same = left==right && metadata && self.publication_read(&first)==self.publication_read(supplier);
+                if same {
+                    let parent = self.symbols.view(&first).unwrap().parent();
+                    merged |= parent.and_then(|p| self.symbols.bound_id(&p).unwrap()).is_some_and(|p| !self.local_type_parameters_of(p).is_empty());
+                } else { different=true; }
+            }
+            let result = if different {
+                let mut reads=Vec::new(); let mut writes=Vec::new();
+                for symbol in &suppliers { reads.push(self.publication_read(symbol)); writes.push(self.publication_write(symbol)); }
+                let read = self.get_intersection_type(&reads,None);
+                let write = self.get_intersection_type(&writes,None);
+                let result = self.publication_new_member(&first,CheckFlags::SYNTHETIC_PROPERTY,suppliers.iter().all(|symbol|self.publication_optional(symbol)));
+                self.member_publication.links.insert(result.clone(),MemberLinks { read:Some(read),write:Some(write),containing:Some(ty),..MemberLinks::default() });
+                result
+            } else if merged {
+                let read = self.publication_cached_read(&first);
+                let write = self.publication_write(&first);
+                let check = self.symbols.view(&first).unwrap().check_flags() & CheckFlags::READONLY;
+                let result = self.publication_new_member(&first,check,self.publication_optional(&first));
+                let mapper = self.member_publication.links.get(&first).and_then(|l| l.mapper);
+                self.member_publication.links.insert(result.clone(),MemberLinks { target:Some(first),mapper,read,write:Some(write),containing:Some(ty) });
+                result
+            } else { first };
+            self.member_publication.composites.insert(cache_key,result.clone());
+            return MemberQuery::Published { symbol:result,revision:0,active:false };
+        }
+        let key = ImageKey { ty,receiver };
+        if !self.publication_image(key) { return MemberQuery::Unsupported; }
+        let image = &self.member_publication.images[&key];
+        let active = !image.done;
+        match image.members.get(name) {
+            Some(symbol) => MemberQuery::Published { symbol:symbol.clone(),revision:image.revision,active },
+            None => MemberQuery::Absent { revision:image.revision,active },
+        }
+    }
+}
