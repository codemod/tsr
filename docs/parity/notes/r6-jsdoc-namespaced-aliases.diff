+    /// `parseJSDocTypeNameWithNamespace` (`parser/jsdoc.go:992`): a
+    /// typedef's or callback's name, `A.B.C` read as namespace `A` holding
+    /// namespace `B` holding the alias `C`.
+    ///
+    /// Native's innermost `ModuleDeclaration` takes the last identifier as its
+    /// `Body`; this AST's `ModuleBody` holds only a block or a declaration,
+    /// so the last segment is a body-less `ModuleDeclaration` named `C` —
+    /// the shape `getInnermostNameOfJSDocNamespace` (`reparser.go:707`)
+    /// already reads as "the name is this declaration's name". The binder
+    /// declares namespaces for every segment but that last one.
+    fn parse_jsdoc_type_name_with_namespace(&mut self) -> Option<tsr_ast::JSDocFullName<'a>> {
+        if !self.at_jsdoc_identifier() {
+            return None;
+        }
+        let start = self.pos();
+        let name = self.parse_jsdoc_identifier_name();
+        if !self.eat_jsdoc(SyntaxKind::DotToken) {
+            return Some(tsr_ast::JSDocFullName::Identifier(name));
+        }
+        let body = self.parse_jsdoc_type_name_with_namespace().map(|body| match body {
+            tsr_ast::JSDocFullName::ModuleDeclaration(module) => module,
+            tsr_ast::JSDocFullName::Identifier(inner) => {
+                let span = self.span_of(inner.node_id);
+                let keyword = self.alloc_token(SyntaxKind::NamespaceKeyword, Span::at(span.start));
+                self.finish_node_with_end(
+                    tsr_ast::ModuleDeclaration::new(
+                        &[],
+                        keyword,
+                        Some(tsr_ast::ModuleName::Identifier(inner)),
+                        None,
+                        None,
+                    ),
+                    SyntaxKind::ModuleDeclaration,
+                    span.start,
+                    span.end,
+                )
+            }
+        });
+        let keyword = self.alloc_token(SyntaxKind::NamespaceKeyword, Span::at(start));
+        let end = self.pos();
+        Some(tsr_ast::JSDocFullName::ModuleDeclaration(self.finish_node_with_end(
+            tsr_ast::ModuleDeclaration::new(
+                &[],
+                keyword,
+                Some(tsr_ast::ModuleName::Identifier(name)),
+                body.map(tsr_ast::ModuleBody::ModuleDeclaration),
+                None,
+            ),
+            SyntaxKind::ModuleDeclaration,
+            start,
+            end,
+        )))
+    }
+
