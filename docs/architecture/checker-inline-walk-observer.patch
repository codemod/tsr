+/// Cycle markers for one parameter-identity graph walk.
+///
+/// Most walks that mark a node use at most four identities. Larger walks spill
+/// in the same order as the original vector; no state survives a root query.
+pub(crate) struct ParameterWalkVisited {
+    pub(crate) inline: [TypeId; 4],
+    pub(crate) inline_len: usize,
+    pub(crate) spill: Vec<TypeId>,
+}
+
+impl ParameterWalkVisited {
+    pub(crate) fn new(root: TypeId) -> Self {
+        // Initial slots are unused, not markers. Avoid a sentinel TypeId and
+        // inspect only the populated prefix until the first spill.
+        Self { inline: [root; 4], inline_len: 0, spill: Vec::new() }
+    }
+
+    pub(crate) fn as_slice(&self) -> &[TypeId] {
+        if self.spill.is_empty() { &self.inline[..self.inline_len] } else { &self.spill }
+    }
+
+    pub(crate) fn contains(&self, id: TypeId) -> bool {
+        self.as_slice().contains(&id)
+    }
+
+    pub(crate) fn push(&mut self, id: TypeId) {
+        if self.inline_len < self.inline.len() {
+            self.inline[self.inline_len] = id;
+            self.inline_len += 1;
+        } else {
+            if self.spill.is_empty() {
+                self.spill = Vec::with_capacity(8);
+                self.spill.extend_from_slice(&self.inline);
+            }
+            self.spill.push(id);
+        }
+    }
+}
