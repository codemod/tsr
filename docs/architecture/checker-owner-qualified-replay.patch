+#[cfg(test)]
+mod private_constructor_tests {
+    use super::*;
+
+    #[test]
+    fn private_class_constructor_frames_do_not_reuse_the_source_publication() {
+        let source = "class Base {} class Derived extends Base {}";
+        let arena = tsr_core::Arena::new();
+        let parsed = tsr_parser::parse(&arena, source);
+        let bound = tsr_binder::bind(
+            &arena,
+            parsed.source_file,
+            &parsed.nodes,
+            tsr_binder::FileInfo { name: "constructor-owner.ts", text: source },
+        );
+        let derived = bound.symbols().iter().find(|(_, entry)| entry.name == "Derived").unwrap().0;
+        for checked_first in [false, true] {
+            let mut checker = Checker::new(&bound, &parsed.nodes, &parsed.node_map);
+            if checked_first {
+                checker.check_source_file(
+                    parsed.source_file.node_id.unwrap(),
+                    crate::check::FileContext { ambient: false, has_parse_errors: false },
+                );
+            }
+            let raw = checker.symbols.bound(derived).unwrap();
+            let head = checker.symbols.clone_module_symbol(&raw).unwrap();
+            let twin = checker.symbols.clone_module_symbol(&raw).unwrap();
+            let constructor = checker.get_base_constructor_type_of_class_ref(&raw);
+            assert_ne!(constructor, checker.intrinsics.error);
+            assert_ne!(constructor, checker.intrinsics.undefined);
+            assert!(checker.resolutions.push(&head, PropertyName::ResolvedBaseConstructorType));
+            assert_eq!(
+                checker.get_base_constructor_type_of_class_ref(&head),
+                checker.intrinsics.error
+            );
+            assert!(!checker.resolutions.pop());
+            assert_eq!(checker.resolutions.depth(), 0);
+            assert_eq!(checker.get_base_constructor_type_of_class_ref(&head), constructor);
+            assert_eq!(checker.get_base_constructor_type_of_class_ref(&twin), constructor);
+            assert_eq!(checker.get_base_constructor_type_of_class(derived), constructor);
+            assert_eq!(checker.symbols.merged_symbol(&raw).unwrap(), raw);
+            assert!(checker.diagnostics().is_empty());
+        }
+    }
