diff --git a/crates/tsr-checker/tests/jsdoc_cast_context.rs b/crates/tsr-checker/tests/jsdoc_cast_context.rs
new file mode 100644
index 0000000..895085d
--- /dev/null
+++ b/crates/tsr-checker/tests/jsdoc_cast_context.rs
@@ -0,0 +1,62 @@
+//! JSDoc hosted on a cast or a `return`: `reparseHosted` wraps the paren's
+//! or `return`'s expression in an `AsExpression` (`makeNewCast`,
+//! `parser/reparser.go:378`), which is its operand's contextual type
+//! (`checker.go:29368`), and `getFunctionLikeHost` takes a `return`'s
+//! expression as the host of its `@param` tags (`reparser.go:662`).
+//! `docs/parity/notes/r5-js.md` §3.6.
+use tsr_ast::Node;
+use tsr_binder::BindResult;
+use tsr_checker::Checker;
+use tsr_core::Arena;
+
+/// The printed type of the JS file's first arrow function.
+fn first_arrow_type(source: &str) -> String {
+    let name = "t.js";
+    let arena = Arena::new();
+    let mut parsed =
+        tsr_parser::parse_with_options(&arena, source, tsr_parser::ParseOptions::for_file(name));
+    assert!(parsed.diagnostics.is_empty(), "fixture must parse");
+    let root = Node::SourceFile(parsed.source_file).node_id().unwrap();
+    parsed.nodes.add_flags(root, tsr_ast::NodeFlags::JAVASCRIPT_FILE);
+    let jsdoc: Vec<_> = parsed.jsdoc.iter().collect();
+    let bound = tsr_binder::bind_into_with_jsdoc(
+        BindResult::empty(),
+        &arena,
+        parsed.source_file,
+        &parsed.nodes,
+        tsr_binder::FileInfo { name, text: source },
+        &jsdoc,
+    );
+    let mut checker = Checker::new(&bound, &parsed.nodes, &parsed.node_map);
+    checker.set_jsdoc(parsed.jsdoc.iter());
+    let mut stack: Vec<Node<'_>> = vec![Node::SourceFile(parsed.source_file)];
+    let mut children = Vec::new();
+    while let Some(node) = stack.pop() {
+        if let Node::ArrowFunction(arrow) = node {
+            let id = checker.check_expression(tsr_ast::Expression::ArrowFunction(arrow));
+            return checker.type_to_string(id);
+        }
+        children.clear();
+        tsr_ast::push_children(node, &mut children);
+        stack.extend(children.iter().rev().copied());
+    }
+    panic!("the fixture must contain an arrow function")
+}
+
+#[test]
+fn a_jsdoc_cast_is_its_operands_context() {
+    let source = "const g = /** @type {(a: number) => number} */ ((a) => a);\n";
+    assert_eq!(first_arrow_type(source), "(a: number) => number");
+}
+
+#[test]
+fn a_type_tag_on_a_return_is_its_expressions_context() {
+    let source = "function f() {\n  /** @type {(a: number) => number} */\n  return (a) => a;\n}\n";
+    assert_eq!(first_arrow_type(source), "(a: number) => number");
+}
+
+#[test]
+fn a_param_tag_on_a_return_types_the_returned_function() {
+    let source = "function f() {\n  /** @param {number} a */\n  return (a) => a;\n}\n";
+    assert_eq!(first_arrow_type(source), "(a: number) => number");
+}
