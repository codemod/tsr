+#[test]
+fn inherited_generic_this_keeps_the_derived_receiver_after_checking() {
+    compare_fixture(
+        &[
+            (
+                "model.ts",
+                "export class Base<T> { declare value: T; declare self: this; } export class Middle<T> extends Base<T> { declare middle: boolean; } export class Derived<T> extends Middle<T> { declare own: number; }",
+            ),
+            (
+                "use.ts",
+                "import { Derived } from './model'; declare const d: Derived<string>; export const probe = d.self; const good: Derived<string> = probe; const bad: number = probe.value;",
+            ),
+        ],
+        &["--noLib", "--target", "es2020"],
+        |_, _, workers, diagnostics| {
+            assert_eq!(diagnostics.len(), 1, "{diagnostics:#?}");
+            assert!(
+                diagnostics[0]
+                    .ends_with("error TS2322: Type 'string' is not assignable to type 'number'.")
+            );
+            assert_eq!(queries(workers), [("/project/use.ts".into(), "Derived<string>".into())]);
+        },
+    );
+}
