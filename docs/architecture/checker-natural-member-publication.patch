+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) enum MemberQuery {
+    Published { symbol:SymbolRef, revision:u64, active:bool },
+    Absent { revision:u64, active:bool },
+    Unsupported,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+struct ImageKey { ty:TypeId, receiver:TypeId }
+
+#[derive(Clone, Default)]
+struct StructuredFields {
+    members:FxHashMap<String,SymbolRef>,
+    calls:Vec<Signature>,
+    constructs:Vec<Signature>,
+    indexes:Vec<IndexInfo>,
+}
+
+#[derive(Default)]
+struct PropertyImage {
+    members:FxHashMap<String,SymbolRef>,
+    calls:Vec<Signature>,
+    constructs:Vec<Signature>,
+    indexes:Vec<IndexInfo>,
+    published:bool,
+    inheritance_active:bool,
+    frames:Vec<u64>,
+    revision:u64,
+    done:bool,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct MapperId(pub(crate) usize);
+
+#[derive(Clone)]
+struct MapperOperation {
+    owner:TypeId,
+    receiver:TypeId,
