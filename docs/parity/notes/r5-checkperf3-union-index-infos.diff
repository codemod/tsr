+    /// A union `id`'s index infos through [`PerfLinks::union_index_infos`]:
+    /// the published answer, or `compute`'s (the union arm of
+    /// `get_index_infos_of_type`), published when no alias-evaluation or
+    /// mapped-template frame was open and [`Self::publishable_since`] holds
+    /// (`r5-checkperf3.md` §5).
+    pub(crate) fn composite_index_infos(
+        &mut self,
+        id: TypeId,
+        compute: impl FnOnce(&mut Self) -> Option<Vec<crate::index_signatures::IndexInfo>>,
+    ) -> Option<Vec<crate::index_signatures::IndexInfo>> {
+        let admitted = self.mapped_template_depth == 0
+            && !self.identity_unmapped_type_parameters
+            && self.alias_evaluation_bindings.iter().all(FxHashMap::is_empty);
+        if !admitted {
+            return compute(self);
+        }
+        if let Some(infos) = self.perf_links.union_index_infos.get(&id) {
+            return infos.clone();
+        }
+        let mark = self.publication_mark();
+        let infos = compute(self);
+        if self.publishable_since(mark) {
+            self.perf_links.union_index_infos.insert(id, infos.clone());
+        }
+        infos
+    }
