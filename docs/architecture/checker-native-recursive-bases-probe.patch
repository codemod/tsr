+package checker_test
+
+import (
+	"encoding/json"
+	"github.com/microsoft/typescript-go/internal/ast"
+	"github.com/microsoft/typescript-go/internal/bundled"
+	"github.com/microsoft/typescript-go/internal/checker"
+	"github.com/microsoft/typescript-go/internal/compiler"
+	"github.com/microsoft/typescript-go/internal/core"
+	"github.com/microsoft/typescript-go/internal/tsoptions"
+	"github.com/microsoft/typescript-go/internal/vfs/vfstest"
+	"slices"
+	"testing"
+)
+
+type baseCase struct {
+	Name, Body     string
+	Codes          []int32
+	BasesA         []string
+	Cycle, Partial bool
+}
+
+func baseCases() []baseCase {
+	return []baseCase{
+		{"generic-mutual", "interface A<T> extends B<T> {a:T} interface B<T> extends A<T> {b:T} declare const x:A<string>; const probe=x.a;", []int32{2310, 2310}, nil, true, false},
+		{"plain-mutual", "interface A extends B {a:number} interface B extends A {b:string} declare const x:A; const probe=x.a;", []int32{2310, 2310}, nil, true, false},
+		{"generic-self", "interface A<T> extends A<T> {a:T} declare const x:A<string>; const probe=x.a;", []int32{2310}, nil, true, false},
+		{"plain-self", "interface A extends A {a:number} declare const x:A; const probe=x.a;", []int32{2310}, nil, true, false},
+		{"valid-diamond", "interface Root {root:number} interface Left extends Root {left:number} interface Right extends Root {right:string} interface A extends Left,Right {a:number} declare const x:A; const probe=x.a;", nil, []string{"Left", "Right"}, false, false},
+		{"completed-empty", "interface A {a:number} declare const x:A; const probe=x.a;", nil, nil, false, false},
+		{"invalid-base", "type Bad=number; interface A extends Bad {a:number} declare const x:A; const probe=x.a;", []int32{2312}, nil, false, false},
+		{"acyclic-override", "interface Base {value:number} interface A extends Base {value:string} declare const x:A; const probe=x.value;", []int32{2430}, []string{"Base"}, false, false},
+		{"partial-valid-bases-cycle", "interface Root {root:number} interface Later {later:number} interface A<T> extends Root,B<T>,Later {a:T} interface B<T> extends A<T> {b:T} declare const x:A<string>; const probe=x.a;", []int32{2310, 2310}, []string{"Root", "Later"}, true, true},
+		{"natural-default-member-reset", "class BaseType<T> {bar:T} class NextType<C extends {someProp:any},T=C['someProp']> extends BaseType<T> {baz:string} class Foo extends NextType<Foo> {someProp:{test:true}} const foo=new Foo(); const probe=foo.bar.test;", []int32{2310}, nil, false, false},
+	}
+}
+func baseDiagnostic(d *ast.Diagnostic) map[string]any {
+	chain := []map[string]any{}
+	for _, item := range d.MessageChain() {
+		chain = append(chain, baseDiagnostic(item))
+	}
+	related := []map[string]any{}
+	for _, item := range d.RelatedInformation() {
+		related = append(related, baseDiagnostic(item))
+	}
+	return map[string]any{"code": d.Code(), "pos": d.Pos(), "end": d.End(), "category": d.Category(), "key": string(d.MessageKey()), "args": d.MessageArgs(), "chain": chain, "related": related}
+}
+func TestNativeRecursiveBaseParsedPrograms(t *testing.T) {
+	for _, tc := range baseCases() {
+		for _, order := range []string{"cold", "member-first", "checked-first"} {
+			t.Run(tc.Name+"/"+order, func(t *testing.T) {
+				config := `{"compilerOptions":{"strict":false,"target":"es2020","types":[],"skipLibCheck":true,"noEmit":true,"incremental":false,"composite":false,"singleThreaded":true},"files":["input.ts"]}`
+				fs := bundled.WrapFS(vfstest.FromMap(map[string]string{"/input.ts": tc.Body, "/tsconfig.json": config}, false))
+				host := compiler.NewCompilerHost("/", fs, bundled.LibPath(), nil, nil)
+				parsed, errors := tsoptions.GetParsedCommandLineOfConfigFile("/tsconfig.json", &core.CompilerOptions{}, nil, host, nil)
+				if len(errors) != 0 {
+					t.Fatal(errors)
+				}
+				p := compiler.NewProgram(compiler.ProgramOptions{Config: parsed, Host: host})
+				p.BindSourceFiles()
+				file := p.GetSourceFile("/input.ts")
+				var symbols []*ast.Symbol
+				var expression *ast.Node
+				for _, statement := range file.Statements.Nodes {
+					if statement.Kind == ast.KindInterfaceDeclaration || statement.Kind == ast.KindClassDeclaration {
+						symbols = append(symbols, statement.Symbol())
+					}
+					if statement.Kind == ast.KindVariableStatement {
+						for _, d := range statement.AsVariableStatement().DeclarationList.AsVariableDeclarationList().Declarations.Nodes {
+							if d.Name().Kind == ast.KindIdentifier && d.Name().AsIdentifier().Text == "probe" {
+								expression = d.Initializer()
+							}
+						}
+					}
+				}
+				if expression == nil {
+					t.Fatal("probe missing")
+				}
+				c, release := p.GetTypeChecker(t.Context())
+				c.NativeBaseStart()
+				if order == "checked-first" {
+					release()
+					p.GetSemanticDiagnostics(t.Context(), file)
+					c, release = p.GetTypeChecker(t.Context())
+				}
+				defer func() { release() }()
+				if order == "member-first" {
+					c.GetTypeAtLocation(expression)
+				}
+				var first []checker.NativeBaseEvent
+				for _, symbol := range symbols {
+					first = append(first, c.NativeBaseResolve(symbol))
+				}
+				c.GetTypeAtLocation(expression)
+				release()
+				diags := p.GetSemanticDiagnostics(t.Context(), file)
+				c, release = p.GetTypeChecker(t.Context())
+				var second []checker.NativeBaseEvent
+				for _, symbol := range symbols {
+					second = append(second, c.NativeBaseResolve(symbol))
+				}
+				codes := []int32{}
+				for _, d := range diags {
+					codes = append(codes, d.Code())
+				}
+				slices.Sort(codes)
+				diagnostics := []map[string]any{}
+				for _, d := range diags {
+					diagnostics = append(diagnostics, baseDiagnostic(d))
+				}
+				events := c.NativeBaseEvents()
+				row := map[string]any{"case": tc.Name, "order": order, "content": tc.Body, "config": config, "first": first, "second": second, "events": events, "diagnostic_codes": codes, "diagnostics": diagnostics}
+				encoded, _ := json.Marshal(row)
+				t.Logf("NATIVE_RECURSIVE_BASE %s", encoded)
+				if !slices.Equal(codes, tc.Codes) {
+					t.Fatalf("codes %v want %v", codes, tc.Codes)
+				}
+				for i, a := range first {
+					b := second[i]
+					if !a.Resolved || !b.Resolved || len(a.Bases) != len(b.Bases) {
+						t.Fatal("completed base state changed")
+					}
+					for j := range a.Bases {
+						if a.Bases[j].ID != b.Bases[j].ID {
+							t.Fatal("base identity changed")
+						}
+					}
+					if a.Type.Name == "A" {
+						names := []string{}
+						for _, base := range a.Bases {
+							names = append(names, base.Name)
+						}
+						if !slices.Equal(names, tc.BasesA) {
+							t.Fatalf("A bases %v want %v", names, tc.BasesA)
+						}
+					}
+				}
+				reentries, partial, reset := 0, 0, 0
+				for i, e := range events {
+					if e.Kind == "base-active-reentry" {
+						reentries++
+						if e.Resolved {
+							t.Fatal("active partial view marked completed")
+						}
+						if len(e.Bases) > 0 {
+							partial++
+						}
+					}
+					if e.Kind == "base-before-reset" && e.MembersResolved {
+						reset++
+						if i+1 >= len(events) || events[i+1].Kind != "base-published" || events[i+1].MembersResolved {
+							t.Fatal("member reset not published")
+						}
+					}
+					if e.Kind == "heritage-compare" && e.Type.Name == "A" && tc.Cycle {
+						admitted := false
+						for _, b := range tc.BasesA {
+							if b == e.Related.Name {
+								admitted = true
+							}
+						}
+						if !admitted {
+							t.Fatal("excluded cyclic base admitted to heritage comparison")
+						}
+					}
+				}
+				if tc.Cycle && tc.Name != "generic-self" && tc.Name != "plain-self" && reentries == 0 {
+					t.Fatal("mutual-cycle reentry not observed")
+				}
+				if tc.Partial && partial == 0 {
+					t.Fatal("nonempty partial base view not observed")
+				}
+				if tc.Name == "natural-default-member-reset" {
+					sawReset, rebuildExit := false, false
+					for _, e := range events {
+						if e.Type.Name != "Foo" {
+							continue
+						}
+						if e.Kind == "base-published" && e.Resolved && !e.MembersResolved {
+							sawReset = true
+						}
+
+						if sawReset && e.Kind == "member-worker-exit" && e.Related.ID == e.Type.ID && e.MembersResolved {
+							rebuildExit = true
+						}
+					}
+					if !rebuildExit {
+						t.Fatal("natural reset did not complete its own member view")
+					}
+				}
+				if tc.Name == "natural-default-member-reset" && reset == 0 {
+					t.Fatal("natural member reset not observed")
+				}
+			})
+		}
+	}
+}
