+package main
+
+import (
+	"encoding/json"
+	"fmt"
+
+	"github.com/microsoft/typescript-go/internal/ast"
+	"github.com/microsoft/typescript-go/internal/bundled"
+	"github.com/microsoft/typescript-go/internal/checker"
+	"github.com/microsoft/typescript-go/internal/compiler"
+	"github.com/microsoft/typescript-go/internal/core"
+	"github.com/microsoft/typescript-go/internal/tsoptions"
+	"github.com/microsoft/typescript-go/internal/vfs/vfstest"
+)
+
+func main() {
+	fs := vfstest.FromMap(map[string]string{
+		"/storage.ts": `interface Target { x: string }
+interface Source { y: number }
+namespace TargetNS { export interface Shared { a: string } export interface Existing { e: boolean } }
+namespace SourceNS { export interface Shared { b: number } export interface Added { n: number } }
+const assertion = {value: 1} as const;`,
+		"/tsconfig.json": `{"compilerOptions":{"strict":true,"singleThreaded":true,"noLib":true,"noEmit":true},"files":["storage.ts"]}`,
+	}, true)
+	host := compiler.NewCompilerHost("/", bundled.WrapFS(fs), bundled.LibPath(), nil, nil)
+	parsed, errors := tsoptions.GetParsedCommandLineOfConfigFile("/tsconfig.json", &core.CompilerOptions{}, nil, host, nil)
+	if len(errors) != 0 {
+		panic(fmt.Sprint(errors))
+	}
+	p := compiler.NewProgram(compiler.ProgramOptions{Config: parsed, Host: host})
+	p.BindSourceFiles()
+	locals := p.GetSourceFile("/storage.ts").AsNode().Locals()
+	get := func(name string) *ast.Symbol {
+		symbol := locals[name]
+		if symbol == nil {
+			panic("missing bound symbol " + name)
+		}
+		return symbol
+	}
+	newChecker := func() *checker.Checker { c, _ := checker.NewChecker(p, nil); return c }
+	rows := map[string]map[string]bool{}
+	check := func(name string, observed checker.StorageObservation) {
+		for key, value := range observed.Checks {
+			if !value {
+				panic(name + ": " + key)
+			}
+		}
+		rows[name] = observed.Checks
+	}
+	first, second := newChecker(), newChecker()
+	a := first.ObserveCloneStorage(get("Target"))
+	b := second.ObserveCloneStorage(get("Target"))
+	check("interface_clone_first_checker", a)
+	check("interface_clone_second_checker", b)
+	if a.Result == b.Result {
+		panic("clones must be private across Checkers")
+	}
+	rows["two_checker_domains"] = map[string]bool{"bound_origin_shared": a.Result.Name == b.Result.Name && a.Result.Declarations[0] == b.Result.Declarations[0], "private_clones_distinct": a.Result != b.Result}
+	check("namespace_clone", newChecker().ObserveCloneStorage(get("TargetNS")))
+	check("interface_merge", newChecker().ObserveMergeStorage(get("Target"), get("Source"), false))
+	check("namespace_merge", newChecker().ObserveMergeStorage(get("TargetNS"), get("SourceNS"), false))
+	check("unidirectional_namespace_merge", newChecker().ObserveMergeStorage(get("TargetNS"), get("SourceNS"), true))
+	if !newChecker().ObserveSameSymbolMerge(get("Target")) {
+		panic("same-symbol merge must return original")
+	}
+	rows["same_symbol_merge"] = map[string]bool{"returns_original_bound_symbol": true}
+	file := p.GetSourceFile("/storage.ts")
+	var assertion *ast.Node
+	file.AsNode().ForEachChild(func(node *ast.Node) bool {
+		if node.Kind == ast.KindVariableStatement {
+			node.ForEachChild(func(list *ast.Node) bool {
+				list.ForEachChild(func(declaration *ast.Node) bool {
+					if declaration.Kind == ast.KindVariableDeclaration && declaration.Name().Text() == "assertion" {
+						assertion = declaration.Initializer().Type()
+					}
+					return false
+				})
+				return false
+			})
+		}
+		return false
+	})
+	if assertion == nil {
+		panic("missing const assertion type node")
+	}
+	check("normal_const_type_query_bypass", newChecker().ObserveConstSymbolBypass(assertion, file))
+	data, err := json.Marshal(rows)
+	if err != nil {
+		panic(err)
+	}
+	fmt.Printf("SYMBOL_STORAGE_CONTRACT\t%s\n", data)
+}
