+    #[test]
+    fn receiver_preparation_revalidates_declared_parameter_identity_and_failure() {
+        with_checker(
+            "interface Box<T> { value: T } type TextBox = Box<string>;",
+            |checker, root| {
+                let owner = checker.binder.lookup_local(root, "Box").unwrap();
+                let alias = checker.binder.lookup_local(root, "TextBox").unwrap();
+                let receiver = checker.get_declared_type_of_symbol(alias);
+                let declaration = checker.local_type_parameters_of(owner)[0];
+                let parameter = checker.binder.symbol_of(declaration.node_id.unwrap()).unwrap();
+                let first = checker.get_declared_type_of_symbol(parameter);
+                let string = checker.intrinsics.string;
+                assert_eq!(checker.instantiate_for_reference(receiver, first), string);
+                checker.declared_types.remove(&parameter);
+                let second = checker.get_declared_type_of_symbol(parameter);
+                assert_ne!(first, second);
+                assert_eq!(checker.instantiate_for_reference(receiver, second), string);
+                checker.declared_types.insert(parameter, checker.intrinsics.error);
+                assert_eq!(
+                    checker.instantiate_for_reference(receiver, second),
+                    checker.intrinsics.error
+                );
+                checker.declared_types.insert(parameter, second);
+                assert_eq!(checker.instantiate_for_reference(receiver, second), string);
+            },
+        );
+    }
