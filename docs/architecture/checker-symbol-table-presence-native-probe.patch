+package checker
+
+import (
+	"encoding/hex"
+	"github.com/microsoft/typescript-go/internal/ast"
+	"maps"
+	"slices"
+)
+
+type TablePresence struct {
+	MembersPresent bool
+	ExportsPresent bool
+	MemberNames    []string
+	ExportNames    []string
+	MemberKeysHex  []string
+	ExportKeysHex  []string
+}
+
+func ObserveBoundTablePresence(symbol *ast.Symbol) TablePresence {
+	members, exports := slices.Sorted(maps.Keys(symbol.Members)), slices.Sorted(maps.Keys(symbol.Exports))
+	rawKeys := func(names []string) []string {
+		result := make([]string, len(names))
+		for i, name := range names {
+			result[i] = hex.EncodeToString([]byte(name))
+		}
+		return result
+	}
+	return TablePresence{
+		MembersPresent: symbol.Members != nil, ExportsPresent: symbol.Exports != nil,
+		MemberNames: members, ExportNames: exports,
+		MemberKeysHex: rawKeys(members), ExportKeysHex: rawKeys(exports),
+	}
+}
+
+func (c *Checker) ObserveTablePresenceClone(symbol *ast.Symbol) map[string]bool {
+	before := ObserveBoundTablePresence(symbol)
+	members, exports := maps.Clone(symbol.Members), maps.Clone(symbol.Exports)
+	clone := c.cloneSymbol(symbol)
+	copied := ObserveBoundTablePresence(clone)
+	checks := map[string]bool{
+		"clone_preserves_member_presence": before.MembersPresent == copied.MembersPresent,
+		"clone_preserves_export_presence": before.ExportsPresent == copied.ExportsPresent,
+		"clone_preserves_member_edges":    maps.Equal(members, clone.Members),
+		"clone_preserves_export_edges":    maps.Equal(exports, clone.Exports),
+		"clone_is_private":                clone != symbol && clone.Flags&ast.SymbolFlagsTransient != 0,
+	}
+	ast.GetMembers(clone)
+	ast.GetExports(clone)
+	checks["getters_initialize_empty_tables"] = clone.Members != nil && clone.Exports != nil
+	clone.Members["__private_member"] = c.newSymbol(ast.SymbolFlagsProperty, "__private_member")
+	clone.Exports["__private_export"] = c.newSymbol(ast.SymbolFlagsProperty, "__private_export")
+	clear(clone.Members)
+	clear(clone.Exports)
+	checks["clear_retains_present_empty_tables"] = clone.Members != nil && clone.Exports != nil && len(clone.Members) == 0 && len(clone.Exports) == 0
+	after := ObserveBoundTablePresence(symbol)
+	checks["bound_presence_unchanged"] = before.MembersPresent == after.MembersPresent && before.ExportsPresent == after.ExportsPresent
+	checks["bound_edges_unchanged"] = maps.Equal(members, symbol.Members) && maps.Equal(exports, symbol.Exports)
+	return checks
+}
+
+func (c *Checker) ObserveTablePresenceMerge(target, source *ast.Symbol) map[string]bool {
+	beforeTarget, beforeSource := ObserveBoundTablePresence(target), ObserveBoundTablePresence(source)
+	result := c.mergeSymbol(target, source, false)
+	actual := ObserveBoundTablePresence(result)
+	checks := map[string]bool{
+		"merge_member_presence_is_union":  actual.MembersPresent == (beforeTarget.MembersPresent || beforeSource.MembersPresent),
+		"merge_export_presence_is_union":  actual.ExportsPresent == (beforeTarget.ExportsPresent || beforeSource.ExportsPresent),
+		"merge_result_is_private":         result != target && result != source && result.Flags&ast.SymbolFlagsTransient != 0,
+		"bound_target_presence_unchanged": target.Members != nil == beforeTarget.MembersPresent && (target.Exports != nil) == beforeTarget.ExportsPresent,
+		"bound_source_presence_unchanged": source.Members != nil == beforeSource.MembersPresent && (source.Exports != nil) == beforeSource.ExportsPresent,
+	}
+	return checks
+}
