+package main
+
+import (
+	"encoding/json"
+	"fmt"
+	"github.com/microsoft/typescript-go/internal/ast"
+	"github.com/microsoft/typescript-go/internal/bundled"
+	"github.com/microsoft/typescript-go/internal/checker"
+	"github.com/microsoft/typescript-go/internal/compiler"
+	"github.com/microsoft/typescript-go/internal/core"
+	"github.com/microsoft/typescript-go/internal/tsoptions"
+	"github.com/microsoft/typescript-go/internal/vfs/vfstest"
+	"slices"
+)
+
+func main() {
+	fs := vfstest.FromMap(map[string]string{
+		"/tables.ts": `interface EmptyInterface {}
+interface FullInterface { field: string }
+namespace EmptyNamespace {}
+namespace HiddenNamespace { const hidden = 1; }
+namespace FullNamespace { export const visible = 1; }
+class EmptyClass {}
+class FullClass { field: string; static value: number; }
+type EmptyLiteral = {};
+type FullLiteral = { field: string };
+type FunctionType = () => string;
+type ConstructorType = new () => string;`,
+		"/tsconfig.json": `{"compilerOptions":{"strict":true,"singleThreaded":true,"noLib":true,"noEmit":true},"files":["tables.ts"]}`,
+	}, true)
+	host := compiler.NewCompilerHost("/", bundled.WrapFS(fs), bundled.LibPath(), nil, nil)
+	parsed, errors := tsoptions.GetParsedCommandLineOfConfigFile("/tsconfig.json", &core.CompilerOptions{}, nil, host, nil)
+	if len(errors) != 0 {
+		panic(fmt.Sprint(errors))
+	}
+	program := compiler.NewProgram(compiler.ProgramOptions{Config: parsed, Host: host})
+	program.BindSourceFiles()
+	locals := program.GetSourceFile("/tables.ts").AsNode().Locals()
+	samples := map[string]*ast.Symbol{}
+	for _, name := range []string{"EmptyInterface", "FullInterface", "EmptyNamespace", "HiddenNamespace", "FullNamespace", "EmptyClass", "FullClass"} {
+		samples[name] = locals[name]
+	}
+	for _, name := range []string{"EmptyLiteral", "FullLiteral", "FunctionType", "ConstructorType"} {
+		samples[name] = locals[name].Declarations[0].Type().Symbol()
+	}
+	samples["ExplicitEmpty"] = &ast.Symbol{Flags: ast.SymbolFlagsInterface, Name: "ExplicitEmpty", Members: make(ast.SymbolTable), Exports: make(ast.SymbolTable)}
+	expected := map[string]checker.TablePresence{
+		"EmptyInterface": {}, "EmptyNamespace": {}, "HiddenNamespace": {}, "EmptyLiteral": {},
+		"FullInterface":   {MembersPresent: true, MemberNames: []string{"field"}},
+		"FullNamespace":   {ExportsPresent: true, ExportNames: []string{"visible"}},
+		"EmptyClass":      {ExportsPresent: true, ExportNames: []string{"prototype"}},
+		"FullClass":       {MembersPresent: true, ExportsPresent: true, MemberNames: []string{"field"}, ExportNames: []string{"prototype", "value"}},
+		"FullLiteral":     {MembersPresent: true, MemberNames: []string{"field"}},
+		"FunctionType":    {MembersPresent: true, MemberNames: []string{ast.InternalSymbolNameCall}},
+		"ConstructorType": {MembersPresent: true, MemberNames: []string{ast.InternalSymbolNameNew}},
+		"ExplicitEmpty":   {MembersPresent: true, ExportsPresent: true},
+	}
+	observations := map[string]checker.TablePresence{}
+	assertions := 0
+	for name, symbol := range samples {
+		if symbol == nil {
+			panic(name + ":missing symbol")
+		}
+		observed := checker.ObserveBoundTablePresence(symbol)
+		want := expected[name]
+		if observed.MembersPresent != want.MembersPresent || observed.ExportsPresent != want.ExportsPresent || !slices.Equal(observed.MemberNames, want.MemberNames) || !slices.Equal(observed.ExportNames, want.ExportNames) {
+			panic(fmt.Sprintf("%s:got%+v want%+v", name, observed, want))
+		}
+		observations[name] = observed
+		assertions += 4
+	}
+	c, _ := checker.NewChecker(program, nil)
+	controls := map[string]map[string]bool{}
+	for name, symbol := range samples {
+		checks := c.ObserveTablePresenceClone(symbol)
+		for key, value := range checks {
+			if !value {
+				panic(name + ":" + key)
+			}
+			assertions++
+		}
+		controls[name] = checks
+	}
+	newNil := func() *ast.Symbol { return &ast.Symbol{Flags: ast.SymbolFlagsInterface, Name: "Nil"} }
+	newEmpty := func() *ast.Symbol {
+		return &ast.Symbol{Flags: ast.SymbolFlagsInterface, Name: "Empty", Members: make(ast.SymbolTable), Exports: make(ast.SymbolTable)}
+	}
+	for name, pair := range map[string][2]*ast.Symbol{
+		"merge_nil_with_empty": {newNil(), newEmpty()},
+		"merge_empty_with_nil": {newEmpty(), newNil()},
+		"merge_nil_with_nil":   {newNil(), newNil()},
+	} {
+		checks := c.ObserveTablePresenceMerge(pair[0], pair[1])
+		for key, value := range checks {
+			if !value {
+				panic(name + ":" + key)
+			}
+			assertions++
+		}
+		controls[name] = checks
+	}
+	data, err := json.Marshal(map[string]any{"observations": observations, "controls": controls, "assertions": assertions})
+	if err != nil {
+		panic(err)
+	}
+	fmt.Printf("SYMBOL_TABLE_PRESENCE\t%s\n", data)
+}
