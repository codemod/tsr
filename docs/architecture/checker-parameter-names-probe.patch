@@ -9377,3 +9381,34 @@ mod generic_keyword_alias_tests {
 #[cfg(test)]
 #[path = "keyword_owner_tests.rs"]
 mod keyword_owner_tests;
+
+// Private locating observer: per-thread counters, not semantic state.
+struct ParameterNameProbe(std::cell::Cell<[u64; 4]>);
+impl Drop for ParameterNameProbe {
+    fn drop(&mut self) {
+        let [calls, names, bytes, complete] = self.0.get();
+        eprintln!("PARAM_NAMES {calls} {names} {bytes} {complete}");
+    }
+}
+thread_local! {
+    static PARAMETER_NAME_PROBE: ParameterNameProbe = const { ParameterNameProbe(std::cell::Cell::new([0; 4])) };
+}
+fn parameter_name_probe(kind: u8, bytes: usize) {
+    static ENABLED: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    if !*ENABLED.get_or_init(|| std::env::var("TSR_PARAM_NAME_PROBE").is_ok()) {
+        return;
+    }
+    PARAMETER_NAME_PROBE.with(|probe| {
+        let mut counts = probe.0.get();
+        match kind {
+            0 => counts[0] += 1,
+            1 => {
+                counts[1] += 1;
+                counts[2] += bytes as u64;
+            }
+            2 => counts[3] += 1,
+            _ => unreachable!(),
+        }
+        probe.0.set(counts);
+    });
+}
