+fn selected_aliases_preserve_declared_type_and_invalid_generic_arity() {
+    let mut failures = Vec::new();
+    for (library, client, expected) in [
+        (
+            "class C { static B: number; } namespace C { export interface B { c: number } } export default C.B;",
+            "import B from './m'; const x: B = { c: B };",
+            "B",
+        ),
+        (
+            "export class A<T> { a!: T } export type { A as B };",
