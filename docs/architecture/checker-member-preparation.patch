+            ("unequal-generic", format!("{generic} type Both=Left<string>&Right<number>;"), "value", "synthesized", "never", "never"),
+            ("distinct-value", "interface Left { value:string;left:number } interface Right { value:string;right:number } type Both=Left&Right;".to_owned(), "value", "synthesized", "string", "string"),
