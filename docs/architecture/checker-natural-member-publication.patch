+        let root=parsed.source_file.node_id().unwrap();
+        let mut checker=crate::Checker::new(&bound,&parsed.nodes,&parsed.node_map);
+        let owner=checker.binder.lookup_local(root,"Leaf").unwrap();
+        let ty=checker.get_declared_type_of_symbol(owner);
+        let key=ImageKey {ty,receiver:ty};
+        assert!(checker.publication_image(key));
+        let symbol=checker.member_publication.images[&key].members.get("resolved").unwrap().clone();
+        assert_eq!(checker.publication_read(&symbol),checker.intrinsics.number);
