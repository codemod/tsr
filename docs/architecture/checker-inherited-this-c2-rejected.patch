+        with_checker(
+            "class Base<T> { declare value: T; declare self: this; } class Middle<T> extends Base<T> { declare middle: boolean; } class Derived<T> extends Middle<T> { declare own: number; } declare const text: Derived<string>; declare const number: Derived<number>; text.self; number.self; text.self;",
+            |checker, _| {
+                let mut expected =
