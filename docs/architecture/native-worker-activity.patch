@@ -0,0 +1,109 @@
+package workactivity
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"testing"
+)
+
+func decoded(t *testing.T, b *bytes.Buffer) []map[string]any {
+	t.Helper()
+	d := json.NewDecoder(b)
+	var rows []map[string]any
+	for d.More() {
+		var row map[string]any
+		if err := d.Decode(&row); err != nil {
+			t.Fatal(err)
+		}
+		rows = append(rows, row)
+	}
+	return rows
+}
+func TestActivityNestedDistinctCheckers(t *testing.T) {
+	var b bytes.Buffer
+	r := New(&b)
+	Current = r
+	defer func() { Current = nil }()
+	p := NewPool(2, []string{"a.ts", "b.ts"}, false, nil)
+	ctor := p.Begin(0, "constructor", -1)
+	other := p.Begin(1, "constructor", -1)
+	other.End()
+	ctor.End()
+	p.Created(0, 10)
+	p.Created(1, 20)
+	lease := p.Begin(0, "lease", -1)
+	full := p.Begin(0, "source_file_check", 0)
+	query := p.Begin(0, "symbol_type_query", -1)
+	nested := p.Begin(0, "declared_type_query", -1)
+	nested.End()
+	query.End()
+	full.End()
+	lease.End()
+	lease.End()
+	r.Finish(1)
+	rows := decoded(t, &b)
+	end := rows[len(rows)-1]
+	if end["complete"] != true {
+		t.Fatal(end)
+	}
+	peaks := end["peaks"].(map[string]any)
+	for name, want := range map[string]float64{"constructing": 2, "semantic": 1, "full": 1, "leased": 1, "observed": 2} {
+		if peaks[name] != want {
+			t.Fatalf("%s: %v", name, peaks)
+		}
+	}
+	var prior float64
+	for _, row := range rows {
+		now := row["recorded_at_ns"].(float64)
+		if now < prior {
+			t.Fatal("clock reversed")
+		}
+		prior = now
+	}
+}
+func TestActivityPanicAndIncomplete(t *testing.T) {
+	for _, mode := range []string{"panic", "pending", "missing-normal-return"} {
+		t.Run(mode, func(t *testing.T) {
+			var b bytes.Buffer
+			r := New(&b)
+			Current = r
+			defer func() { Current = nil }()
+			p := NewPool(1, nil, true, nil)
+			if mode == "panic" {
+				func() {
+					defer func() {
+						if recover() != "expected" {
+							t.Fatal("panic was changed")
+						}
+					}()
+					defer p.Begin(0, "constructor", -1).End()
+					panic("expected")
+				}()
+			} else if mode == "pending" {
+				p.Begin(0, "constructor", -1)
+			}
+			if mode == "missing-normal-return" {
+				r.Close()
+			} else {
+				r.Finish(0)
+			}
+			rows := decoded(t, &b)
+			if rows[len(rows)-1]["complete"] != false {
+				t.Fatal(rows)
+			}
+		})
+	}
+}
