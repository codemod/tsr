+    /// The span of the first token after `node` in its file's source text;
+    /// `None` without source text.
+    fn token_after(&self, node: NodeId) -> Option<tsr_core::Span> {
+        let file = self.source_file_of_for_diagnostics(node)?;
+        let text = self.module_host?.source_text(file, self.nodes)?;
+        let mut scanner = tsr_scanner::Scanner::new(text);
+        let end = u32::try_from(text.len()).ok()?;
+        scanner.set_range(self.nodes.span(node).end, end);
+        let token = scanner.scan();
+        (token.kind != SyntaxKind::EndOfFile).then_some(token.span)
+    }
