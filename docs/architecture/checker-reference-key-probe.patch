+//! Archive-only map-operation observation. Keys, hashing and equality are delegated unchanged.
+#![allow(missing_docs)]
+use crate::TypeId;
+use rustc_hash::FxHashMap;
+use std::borrow::Borrow;
+use std::cell::Cell;
+use std::hash::{Hash, Hasher};
