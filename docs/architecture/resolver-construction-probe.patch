+// Temporary surrounding-construction locator. Output lengths/capacities are
+// observations, not allocator totals or retained bytes. Timers stop before
+// shape inspection, origin construction, locking and counter bookkeeping.
+#[derive(Default)]
+struct Construction {
+    calls: u64,
+    ns: u64,
+    payload_bytes: usize,
+    output_capacity_bytes: usize,
+}
+fn constructions() -> &'static Mutex<BTreeMap<(String, String), Construction>> {
+    static S: OnceLock<Mutex<BTreeMap<(String, String), Construction>>> = OnceLock::new();
+    S.get_or_init(|| Mutex::new(BTreeMap::new()))
+}
+fn construction_record(kind: &'static str, ns: u64, payload: usize, capacity: usize) {
+    let key = (kind.into(), origin());
+    let mut counts = constructions().lock().unwrap();
+    let row = counts.entry(key).or_default();
+    row.calls += 1;
+    row.ns += ns;
+    row.payload_bytes += payload;
+    row.output_capacity_bytes += capacity;
+}
+/// Time one exact constructor; disabled mode executes the original operation.
+pub fn construction<T>(
+    kind: &'static str,
+    build: impl FnOnce() -> T,
+    shape: impl FnOnce(&T) -> (usize, usize),
+) -> T {
+    let clock = start();
+    let result = build();
+    if let Some(clock) = clock {
+        let ns = u64::try_from(clock.elapsed().as_nanos()).unwrap_or(u64::MAX);
+        let (payload, capacity) = shape(&result);
+        construction_record(kind, ns, payload, capacity);
+    }
+    result
+}
+/// Observe a String result without cloning it.
+pub fn text(kind: &'static str, build: impl FnOnce() -> String) -> String {
+    construction(kind, build, |s| (s.len(), s.capacity()))
+}
+/// Inclusive phase locator; never add these intervals to operation/syscall
+/// intervals. They include nested work, I/O and enabled observer bookkeeping.
+pub struct Interval {
+    kind: &'static str,
+    clock: Option<Instant>,
+    _thread: PhantomData<Rc<()>>,
+}
+impl Interval {
+    /// Guard remains on the creating thread; records after nested scopes drop.
+    #[must_use]
+    pub fn enter(kind: &'static str) -> Self {
+        Self { kind, clock: start(), _thread: PhantomData }
+    }
+}
+impl Drop for Interval {
+    fn drop(&mut self) {
+        if let Some(clock) = self.clock {
+            construction_record(
+                self.kind,
+                u64::try_from(clock.elapsed().as_nanos()).unwrap_or(u64::MAX),
+                0,
+                0,
+            );
+        }
+    }
+}
+/// Fixed labels and origins only; no path/source/diagnostic contents.
+#[must_use]
+pub fn construction_json() -> String {
+    let counts = constructions().lock().unwrap();
+    let rows = counts.iter().map(|((kind, origin), r)| format!(
+        "{{\"kind\":\"{kind}\",\"origin\":\"{origin}\",\"calls\":{},\"ns\":{},\"payload_bytes\":{},\"output_capacity_bytes\":{}}}",
+        r.calls, r.ns, r.payload_bytes, r.output_capacity_bytes
+    )).collect::<Vec<_>>().join(",");
+    format!("{{\"rows\":[{rows}]}}")
+}
+
+#[cfg(test)]
+mod construction_tests {
+    use super::*;
+    #[test]
+    fn constructor_runs_once_and_returns_original_owned_value() {
+        assert!(enabled());
+        let _scope = Scope::enter("construction_test.once");
+        let calls = std::cell::Cell::new(0);
+        let value = text("test.once", || {
+            calls.set(calls.get() + 1);
+            "owned".to_owned()
+        });
+        assert_eq!(calls.get(), 1);
+        assert_eq!(value, "owned");
+        let counts = constructions().lock().unwrap();
+        let row = &counts[&("test.once".into(), "construction_test.once".into())];
+        assert_eq!(row.calls, 1);
+        assert_eq!(row.payload_bytes, value.len());
+        assert_eq!(row.output_capacity_bytes, value.capacity());
+    }
+    #[test]
+    fn shape_observation_preserves_a_non_string_result() {
+        assert!(enabled());
+        let _scope = Scope::enter("construction_test.result");
+        let value: Result<usize, &str> =
+            construction("test.result", || Err("same failure"), |_| (0, 0));
+        assert_eq!(value, Err("same failure"));
+        let counts = constructions().lock().unwrap();
+        assert_eq!(counts[&("test.result".into(), "construction_test.result".into())].calls, 1);
+    }
+}
+
+/// Private preflight capability: export queried file/directory paths only when the
+/// coordinator explicitly requests them. Never include this in public evidence.
+#[must_use]
+pub fn input_paths() -> Vec<String> {
+    let counts = state().lock().unwrap();
+    let mut paths = std::collections::BTreeSet::new();
+    for (operation, entries) in &counts.global_paths {
+        if matches!(
+            operation.as_str(),
+            "disk.file" | "cached.file" | "disk.directory" | "cached.directory"
+        ) {
+            paths.extend(entries.iter().cloned());
+        }
+    }
+    paths.into_iter().collect()
+}
