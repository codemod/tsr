+                    let read=checker.publication_read(&first);
+                    let write=checker.publication_write(&first);
+                    // Native adapter asks getNonMissingTypeOfSymbol. Keep
+                    // the raw read link unchanged and project missing here.
+                    let optional=checker.publication_optional(&first);
+                    let projected_read=if optional {checker.remove_missing_type(read)} else {read};
