+package checker
+
+import (
+	"maps"
+	"slices"
+
+	"github.com/microsoft/typescript-go/internal/ast"
+)
+
+// Scratch-only characterization of the original clone/merge implementations.
+type StorageObservation struct {
+	Result *ast.Symbol
+	Checks map[string]bool
+}
+
+func (c *Checker) ObserveCloneStorage(bound *ast.Symbol) StorageObservation {
+	flags, checkFlags := bound.Flags, bound.CheckFlags
+	parent, valueDeclaration := bound.Parent, bound.ValueDeclaration
+	declarations := slices.Clone(bound.Declarations)
+	members, exports := maps.Clone(bound.Members), maps.Clone(bound.Exports)
+	clone := c.cloneSymbol(bound)
+	checks := map[string]bool{
+		"bound_not_transient":            bound.Flags&ast.SymbolFlagsTransient == 0,
+		"clone_distinct":                 clone != bound,
+		"clone_transient":                clone.Flags&ast.SymbolFlagsTransient != 0,
+		"clone_zero_check_flags":         clone.CheckFlags == 0,
+		"clone_copies_declarations":      slices.Equal(clone.Declarations, declarations),
+		"clone_copies_parent_and_value":  clone.Parent == parent && clone.ValueDeclaration == valueDeclaration,
+		"clone_shallow_member_values":    maps.Equal(clone.Members, members),
+		"clone_shallow_export_values":    maps.Equal(clone.Exports, exports),
+		"checker_redirects_bound_origin": c.getMergedSymbol(bound) == clone,
+	}
+	// Mutate only the private clone: independent map storage and append capacity
+	// are required even though the original declaration/member values are shared.
+	clone.Declarations = append(clone.Declarations, declarations...)
+	ast.GetSymbolTable(&clone.Members)["__private_clone_member"] = c.newProperty("__private_clone_member", c.stringType)
+	ast.GetSymbolTable(&clone.Exports)["__private_clone_export"] = c.newProperty("__private_clone_export", c.numberType)
+	checks["bound_declarations_unchanged_after_append"] = slices.Equal(bound.Declarations, declarations)
+	checks["bound_tables_unchanged_after_clone_mutation"] = maps.Equal(bound.Members, members) && maps.Equal(bound.Exports, exports)
+	checks["bound_metadata_unchanged"] = bound.Flags == flags && bound.CheckFlags == checkFlags && bound.Parent == parent && bound.ValueDeclaration == valueDeclaration
+	return StorageObservation{clone, checks}
+}
+
+func (c *Checker) ObserveMergeStorage(target, source *ast.Symbol, unidirectional bool) StorageObservation {
+	targetDeclarations, sourceDeclarations := slices.Clone(target.Declarations), slices.Clone(source.Declarations)
+	targetMembers, sourceMembers := maps.Clone(target.Members), maps.Clone(source.Members)
+	targetExports, sourceExports := maps.Clone(target.Exports), maps.Clone(source.Exports)
+	targetFlags, sourceFlags := target.Flags, source.Flags
+	result := c.mergeSymbol(target, source, unidirectional)
+	checks := map[string]bool{
+		"merge_distinct_private_target":     result != target && result != source && result.Flags&ast.SymbolFlagsTransient != 0,
+		"merge_zero_check_flags":            result.CheckFlags == 0,
+		"merge_keeps_all_declarations":      len(result.Declarations) == len(targetDeclarations)+len(sourceDeclarations),
+		"target_declarations_unchanged":     slices.Equal(target.Declarations, targetDeclarations),
+		"source_declarations_unchanged":     slices.Equal(source.Declarations, sourceDeclarations),
+		"target_tables_unchanged":           maps.Equal(target.Members, targetMembers) && maps.Equal(target.Exports, targetExports),
+		"source_tables_unchanged":           maps.Equal(source.Members, sourceMembers) && maps.Equal(source.Exports, sourceExports),
+		"bound_flags_unchanged":             target.Flags == targetFlags && source.Flags == sourceFlags,
+		"target_redirects_to_private_clone": c.getMergedSymbol(target) == result,
+		"source_redirect_matches_direction": (c.getMergedSymbol(source) == result) == !unidirectional,
+	}
+	if targetMembers != nil && sourceMembers != nil {
+		checks["merge_contains_both_member_tables"] = result.Members["x"] == targetMembers["x"] && result.Members["y"] == sourceMembers["y"]
+	}
+	if targetExports != nil && sourceExports != nil {
+		merged := result.Exports["Shared"]
+		originalTarget, originalSource := targetExports["Shared"], sourceExports["Shared"]
+		added := sourceExports["Added"]
+		checks["merged_export_private_distinct"] = merged != nil && merged != originalTarget && merged != originalSource && merged.Flags&ast.SymbolFlagsTransient != 0
+		checks["merged_export_parent_is_private_module"] = merged != nil && merged.Parent == result
+		checks["original_export_parents_unchanged"] = originalTarget.Parent == target && originalSource.Parent == source
+		checks["source_only_export_keeps_raw_parent"] = result.Exports["Added"] == added && added.Parent == source
+		checks["source_only_export_parent_accessor_redirects"] = (c.getParentOfSymbol(added) == result) == !unidirectional
+		checks["merged_export_has_both_members"] = merged != nil && merged.Members["a"] == originalTarget.Members["a"] && merged.Members["b"] == originalSource.Members["b"]
+		checks["original_shared_declarations_unchanged"] = len(originalTarget.Declarations) == 1 && len(originalSource.Declarations) == 1
+	}
+	return StorageObservation{result, checks}
+}
+
+func (c *Checker) ObserveSameSymbolMerge(bound *ast.Symbol) bool {
+	return c.mergeSymbol(bound, bound, false) == bound
+}
+
+func (c *Checker) ObserveConstSymbolBypass(node *ast.Node, file *ast.SourceFile) StorageObservation {
+	before := c.symbolNodeLinks.Get(node).resolvedSymbol
+	errors := len(c.diagnostics.GetDiagnosticsForFile(file.FileName()))
+	result := c.getTypeFromTypeNode(node)
+	repeated := c.getTypeFromTypeNode(node)
+	return StorageObservation{Checks: map[string]bool{
+		"const_symbol_entry_stays_uncomputed":         before == nil && c.symbolNodeLinks.Get(node).resolvedSymbol == nil,
+		"const_type_query_preserves_readonly_literal": c.TypeToString(result) == "{ readonly value: 1; }",
+		"const_type_query_reuses_type_identity":       result == repeated,
+		"const_type_query_adds_no_missing_name_error": len(c.diagnostics.GetDiagnosticsForFile(file.FileName())) == errors,
+	}}
+}
