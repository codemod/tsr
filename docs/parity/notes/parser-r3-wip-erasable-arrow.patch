+    /// TS1294, `This syntax is not allowed when 'erasableSyntaxOnly' is
+    /// enabled.` — every `shouldCheckErasableSyntax` (`checker.go:2650`) site,
+    /// each a `c.error`, so it stands in a file with parse errors:
+    ///
+    /// | upstream | construct | span |
+    /// |---|---|---|
+    /// | `checkParameter` (`:2667`) | parameter property | the parameter |
+    /// | `checkEnumDeclaration` (`:5076`) | non-ambient enum | its name |
+    /// | `checkModuleDeclaration` (`:5165`) | non-ambient instantiated namespace | its name |
+    /// | `checkImportEqualsDeclaration` (`:5469`) | non-ambient `import x =` | the declaration |
+    /// | `checkExportAssignment` (`:5595`) | non-ambient `export =` | the declaration |
+    /// | `checkAssertion` (`:12293`) | `<T>x` | `<` through `>` |
+    ///
+    /// Upstream's `NodeFlagsAmbient` is `declaration_is_in_an_ambient_context`
+    /// here (the parser never sets the flag). The three module-element sites
+    /// sit after `checkGrammarModuleElementContext`, whose report returns
+    /// first: a grammar error, so it only reports in a file without parse
+    /// errors, for a declaration whose parent is neither a source file nor a
+    /// module block. `symbol.Flags&SymbolFlagsValueModule` in front of
+    /// `isInstantiatedModule` is implied by it for the declaration itself.
+    fn check_erasable_syntax(&mut self, typed: Node<'_>) {
+        let Some(node) = typed.node_id() else { return };
+        if self.in_js_file(node) {
+            return;
+        }
+        let module_element_bails = |checker: &Self| {
+            !checker.file_has_parse_errors
+                && !checker.nodes.parent(node).is_some_and(|parent| {
+                    matches!(
+                        checker.nodes.kind(parent),
+                        SyntaxKind::SourceFile | SyntaxKind::ModuleBlock
+                    )
+                })
+        };
+        let span = match typed {
+            Node::ParameterDeclaration(parameter)
+                if parameter.modifiers.iter().any(|modifier| {
+                    matches!(
+                        modifier,
+                        ModifierLike::Token(token) if matches!(
+                            token.kind,
+                            SyntaxKind::PublicKeyword
+                                | SyntaxKind::PrivateKeyword
+                                | SyntaxKind::ProtectedKeyword
+                                | SyntaxKind::ReadonlyKeyword
+                                | SyntaxKind::OverrideKeyword
