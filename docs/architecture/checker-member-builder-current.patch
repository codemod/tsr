+            let mut different = false;
+            let mut merged = false;
+            for supplier in suppliers.iter().skip(1) {
+                if *supplier==first { continue; }
+                let left = self.publication_target(&first);
+                let right = self.publication_target(supplier);
+                let bound_left = self.symbols.bound_id(&left).unwrap();
+                let bound_right = self.symbols.bound_id(&right).unwrap();
+                let metadata = bound_left.zip(bound_right).is_some_and(|(l,r)| {
+                    self.property_is_optional(l)==self.property_is_optional(r)
+                        && self.is_readonly_property(l)==self.is_readonly_property(r)
+                        && self.is_non_public_member(l)==self.is_non_public_member(r)
+                });
+                let same = left==right && metadata && self.publication_read(&first)==self.publication_read(supplier);
+                if same {
+                    let parent = self.symbols.view(&first).unwrap().parent();
+                    merged |= parent.and_then(|p| self.symbols.bound_id(&p).unwrap()).is_some_and(|p| !self.local_type_parameters_of(p).is_empty());
+                } else { different=true; }
+            }
+            let result = if different {
+                let mut reads=Vec::new(); let mut writes=Vec::new();
+                for symbol in &suppliers { reads.push(self.publication_read(symbol)); writes.push(self.publication_write(symbol)); }
+                let read = self.get_intersection_type(&reads,None);
+                let write = self.get_intersection_type(&writes,None);
+                let result = self.publication_new_member(&first,CheckFlags::SYNTHETIC_PROPERTY,suppliers.iter().all(|symbol|self.publication_optional(symbol)));
+                self.member_publication.links.insert(result.clone(),MemberLinks { read:Some(read),write:Some(write),containing:Some(ty),..MemberLinks::default() });
+                result
+            } else if merged {
+                let read = self.publication_cached_read(&first);
+                let write = self.publication_write(&first);
+                let check = self.symbols.view(&first).unwrap().check_flags() & CheckFlags::READONLY;
+                let result = self.publication_new_member(&first,check,self.publication_optional(&first));
+                let mapper = self.member_publication.links.get(&first).and_then(|l| l.mapper);
+                self.member_publication.links.insert(result.clone(),MemberLinks { target:Some(first),mapper,read,write:Some(write),containing:Some(ty) });
+                result
+            } else { first };
+            self.member_publication.composites.insert(cache_key,result.clone());
+            return MemberQuery::Published { symbol:result,revision:0,active:false };
+        }
+        let key = ImageKey { ty,receiver };
+        if !self.publication_image(key) { return MemberQuery::Unsupported; }
+        let image = &self.member_publication.images[&key];
+        let active = !image.done;
+        match image.members.get(name) {
+            Some(symbol) => MemberQuery::Published { symbol:symbol.clone(),revision:image.revision,active },
+            None => MemberQuery::Absent { revision:image.revision,active },
+        }
+    }
+}
