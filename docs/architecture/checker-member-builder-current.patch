+    /// getDeclaredTypeOfClassOrInterface / isThislessInterface (5b1047d,
+    /// checker.go:17319/17356). A declared target may itself be a reference.
+    /// Reuse the existing class-symbol/interface-declaration this identities;
+    /// establish them before fields, including when a base requires this.
+    fn publication_formal_this(&mut self,owner:SymbolId) -> Option<TypeId> {
+        let declarations=self.binder.symbols().get(owner).declarations.to_vec();
+        let class=self.binder.symbols().get(owner).flags.contains(SymbolFlags::CLASS);
+        let existing=self.this_types.get(&owner).copied().or_else(|| {
+            declarations.iter().find_map(|node|self.this_type_nodes.get(node).copied())
+        });
+        if existing.is_none() && !class && self.local_type_parameters_of(owner).is_empty()
+            && self.publication_thisless_interface(owner,&mut Vec::new()) {return None;}
+        let formal=existing.unwrap_or_else(||self.store.new_named(TypeFlags::TYPE_PARAMETER,"this".into(),Some(owner)));
+        if class {self.this_types.insert(owner,formal);}
+        else {
+            for node in declarations {
+                if self.nodes.kind(node)==tsr_ast::SyntaxKind::InterfaceDeclaration {
+                    self.this_type_nodes.insert(node,formal);
+                }
+            }
+        }
+        Some(formal)
