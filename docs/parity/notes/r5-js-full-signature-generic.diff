diff --git a/crates/tsr-checker/tests/jsdoc_full_signature_generic.rs b/crates/tsr-checker/tests/jsdoc_full_signature_generic.rs
new file mode 100644
index 0000000..34d5cad
--- /dev/null
+++ b/crates/tsr-checker/tests/jsdoc_full_signature_generic.rs
@@ -0,0 +1,49 @@
+//! A JS function whose `@type` tag is its full signature takes that tag's
+//! single call signature, type parameters included
+//! (`getSignaturesOfSymbol` → `getSignatureOfFullSignatureType`,
+//! `checker.go:19827`/`:20072`). `docs/parity/notes/r5-js.md` §3.5.
+use tsr_ast::{Node, NodeId, SyntaxKind};
+use tsr_binder::BindResult;
+use tsr_checker::Checker;
+use tsr_core::Arena;
+
+/// The printed type of the JS file's first function declaration.
+fn function_type(source: &str) -> String {
+    let name = "t.js";
+    let arena = Arena::new();
+    let mut parsed =
+        tsr_parser::parse_with_options(&arena, source, tsr_parser::ParseOptions::for_file(name));
+    assert!(parsed.diagnostics.is_empty(), "fixture must parse");
+    let root = Node::SourceFile(parsed.source_file).node_id().unwrap();
+    parsed.nodes.add_flags(root, tsr_ast::NodeFlags::JAVASCRIPT_FILE);
+    let jsdoc: Vec<_> = parsed.jsdoc.iter().collect();
+    let bound = tsr_binder::bind_into_with_jsdoc(
+        BindResult::empty(),
+        &arena,
+        parsed.source_file,
+        &parsed.nodes,
+        tsr_binder::FileInfo { name, text: source },
+        &jsdoc,
+    );
+    let mut checker = Checker::new(&bound, &parsed.nodes, &parsed.node_map);
+    checker.set_jsdoc(parsed.jsdoc.iter());
+    let function = (0..u32::try_from(parsed.nodes.len()).expect("fits"))
+        .map(NodeId::new)
+        .find(|&id| parsed.nodes.kind(id) == SyntaxKind::FunctionDeclaration)
+        .expect("a function declaration");
+    let symbol = bound.symbol_of(function).expect("bound");
+    let id = checker.get_type_of_symbol(symbol);
+    checker.type_to_string(id)
+}
+
+#[test]
+fn a_generic_full_signature_keeps_its_type_parameters() {
+    let source = "/** @type {<T>(param?: T) => T} */\nfunction typed(param) { return param; }\n";
+    assert_eq!(function_type(source), "<T>(param?: T) => T");
+}
+
+#[test]
+fn a_plain_full_signature_still_types_the_function() {
+    let source = "/** @type {(n?: number) => number} */\nfunction typed(n) { return 1; }\n";
+    assert_eq!(function_type(source), "(n?: number) => number");
+}
