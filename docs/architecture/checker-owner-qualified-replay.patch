+#[cfg(test)]
+mod private_parameter_owner_tests {
+    use super::*;
+
+    #[test]
+    fn private_class_parameter_readers_keep_declaration_symbols() {
+        let source = "class Box<T, U = string> { value!: T; other!: U }";
+        let arena = tsr_core::Arena::new();
+        let parsed = tsr_parser::parse(&arena, source);
+        let bound = tsr_binder::bind(
+            &arena,
+            parsed.source_file,
+            &parsed.nodes,
+            tsr_binder::FileInfo { name: "parameter-owner.ts", text: source },
+        );
+        let owner = bound.symbols().iter().find(|(_, entry)| entry.name == "Box").unwrap().0;
+        for checked_first in [false, true] {
+            let mut checker = Checker::new(&bound, &parsed.nodes, &parsed.node_map);
+            if checked_first {
+                checker.check_source_file(
+                    parsed.source_file.node_id.unwrap(),
+                    crate::check::FileContext { ambient: false, has_parse_errors: false },
+                );
+            }
+            let raw = checker.symbols.bound(owner).unwrap();
+            let head = checker.symbols.clone_module_symbol(&raw).unwrap();
+            let twin = checker.symbols.clone_module_symbol(&raw).unwrap();
+            let expected = checker.local_type_parameter_types_of(owner).unwrap();
+            assert_eq!(expected.len(), 2);
+            for selected in [&raw, &head, &twin] {
+                assert_eq!(checker.local_type_parameter_names_of_ref(selected), ["T", "U"]);
+                let parameters = checker.local_type_parameters_of_ref(selected);
+                assert_eq!(parameters[0].name.unwrap().text, "T");
+                assert_eq!(parameters[1].name.unwrap().text, "U");
+                assert_eq!(checker.local_type_parameter_types_of_ref(selected).unwrap(), expected);
+            }
+            assert_ne!(head, twin);
+            assert_eq!(checker.symbols.merged_symbol(&raw).unwrap(), raw);
+        }
+    }
+}
