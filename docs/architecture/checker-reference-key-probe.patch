+pub trait KeyShape {
+    fn vector_items(&self) -> usize;
+    fn identity_fields(&self) -> usize;
+}
+impl KeyShape for (TypeId, Vec<(TypeId, TypeId)>) {
+    fn vector_items(&self) -> usize {
+        self.1.len()
+    }
+    fn identity_fields(&self) -> usize {
+        1 + 2 * self.1.len()
+    }
+}
+impl KeyShape for (SymbolId, Vec<TypeId>) {
+    fn vector_items(&self) -> usize {
+        self.1.len()
+    }
+    fn identity_fields(&self) -> usize {
+        1 + self.1.len()
+    }
+}
+impl KeyShape for (TypeId, Vec<TypeId>) {
+    fn vector_items(&self) -> usize {
+        self.1.len()
+    }
+    fn identity_fields(&self) -> usize {
+        1 + self.1.len()
+    }
