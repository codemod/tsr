+fn clone_program_stamp(domain: &SymbolStoreIdentity, site: usize) -> SymbolStoreIdentity {
+    #[cfg(feature = "work-trace")]
+    STAMP_PROBE.with(|n| { let mut v=n.get(); v[site]+=1; n.set(v); });
+    domain.clone()
+}
+impl Clone for SymbolRef {
+    fn clone(&self) -> Self {
+        Self(match &self.0 {
+            Identity::Bound(domain, id) => Identity::Bound(clone_program_stamp(domain, 0), *id),
+            Identity::Private(domain, id) => {
+                #[cfg(feature = "work-trace")]
