--- a/crates/tsr-checker/src/symbol_access.rs
+++ b/crates/tsr-checker/src/symbol_access.rs
@@ -84,0 +85,44 @@
+}
+
+// Private measurement of actual worker requests. Site keys are not native cache keys:
+// best_name_ref has no explicit meaning, and its scope walker differs from native.
+#[cfg(feature = "work-trace")]
+#[derive(Default)]
+struct ChainProbeData {
+    counts: [[u64; 7]; 2],
+    sites: FxHashMap<(u8, SymbolRef, NodeId), u64>,
+    active: FxHashMap<(u8, SymbolRef, NodeId), u64>,
+    owners: rustc_hash::FxHashSet<(u8, SymbolRef)>,
+    scopes: FxHashMap<(SymbolRef, NamingProbeKey), u64>,
+}
+#[cfg(feature = "work-trace")]
+thread_local! { static CHAIN_PROBE: std::cell::RefCell<ChainProbeData> = std::cell::RefCell::new(ChainProbeData::default()); }
+#[cfg(feature = "work-trace")]
+pub fn chain_probe_reset() { CHAIN_PROBE.with(|d| *d.borrow_mut() = ChainProbeData::default()); }
+#[cfg(feature = "work-trace")]
+pub fn chain_probe_begin(route: u8, symbol: &SymbolRef, site: NodeId) {
+    CHAIN_PROBE.with(|d| {
+        let mut d = d.borrow_mut(); let i = usize::from(route); let key = (route, symbol.clone(), site);
+        d.counts[i][0] += 1;
+        if d.sites.insert(key.clone(), 1).is_none() { d.counts[i][1] += 1; }
+        if d.owners.insert((route, symbol.clone())) { d.counts[i][2] += 1; }
+        let depth = d.active.entry(key).or_default(); let repeat = *depth > 0; *depth += 1;
+        d.counts[i][3] += u64::from(repeat);
+    });
+}
+#[cfg(feature = "work-trace")]
+pub fn chain_probe_end(route: u8, symbol: &SymbolRef, site: NodeId, success: bool) {
+    CHAIN_PROBE.with(|d| { let mut d = d.borrow_mut();
+        *d.active.get_mut(&(route, symbol.clone(), site)).unwrap() -= 1;
+        d.counts[usize::from(route)][if success { 4 } else { 5 }] += 1;
+    });
+}
+#[cfg(feature = "work-trace")]
+pub fn chain_probe_scope(symbol: &SymbolRef, scope: NamingProbeKey) {
+    CHAIN_PROBE.with(|d| *d.borrow_mut().scopes.entry((symbol.clone(), scope)).or_default() += 1);
+}
+#[cfg(feature = "work-trace")]
+pub fn chain_probe_table(route: u8) { CHAIN_PROBE.with(|d| d.borrow_mut().counts[usize::from(route)][6] += 1); }
+#[cfg(feature = "work-trace")]
+pub fn chain_probe_counts() -> ([[u64; 7]; 2], usize) {
+    CHAIN_PROBE.with(|d| { let d = d.borrow(); assert!(d.active.values().all(|v| *v == 0)); (d.counts, d.scopes.len()) })
