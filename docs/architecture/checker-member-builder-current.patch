+        if !self.binder.symbols().get(owner).flags.intersects(SymbolFlags::CLASS|SymbolFlags::INTERFACE) { return ty; }
+        // getTypeWithThisArgument only appends for ObjectFlagsReference.
+        // A thisless, non-generic interface is not a reference; preserve its
+        // existing type identity and do not manufacture a final-this entry.
+        if self.publication_formal_this(owner).is_none() { return ty; }
+        let Some(parameters) = self.local_type_parameter_types_of(owner) else { return ty };
+        let arguments = self.type_reference_targets.get(&ty).map(|(_,args)| args.clone())
+            .unwrap_or_else(|| parameters.iter().map(|(t,_)| *t).collect());
+        // An explicit final this argument is already prepared and is retained.
+        if arguments.len()!=parameters.len() { return ty; }
+        let mut full=arguments;
+        full.push(receiver);
+        let key=(owner,full.clone());
+        if let Some(&cached)=self.member_publication.references.get(&key) { return cached; }
+        let text=self.type_to_string(ty);
+        let result=self.store.new_named(TypeFlags::OBJECT,text,Some(owner));
+        self.type_reference_targets.insert(result,(owner,full));
+        self.reference_display_arity.insert(result,parameters.len());
+        self.member_publication.references.insert(key,result);
+        result
+    }
