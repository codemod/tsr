+    #[test]
+    fn absent_callable_identity_keeps_pending_active_and_alias_contexts_ineligible() {
+        let source = "type Frame<T>=T; function f(){return 1} namespace f {export const bar=1}";
+        for state in ["pending", "active", "resolution", "alias"] {
+            let arena = tsr_core::Arena::new();
+            let parsed = tsr_parser::parse(&arena, source);
+            assert!(parsed.diagnostics.is_empty());
+            let bound = tsr_binder::bind(
+                &arena,
+                parsed.source_file,
+                &parsed.nodes,
+                tsr_binder::FileInfo { name: "states.ts", text: source },
+            );
+            let root = parsed.source_file.node_id.unwrap();
+            let mut checker = crate::Checker::new(&bound, &parsed.nodes, &parsed.node_map);
+            let owner = bound.lookup_local(root, "f").unwrap();
+            let ty = checker.get_type_of_symbol(owner);
+            assert!(!checker.signature_types.contains_key(&ty));
+            let declaration = bound
+                .symbols()
+                .get(owner)
+                .declarations
+                .iter()
+                .copied()
+                .find(|id| {
+                    matches!(parsed.node_map.get(*id), Some(tsr_ast::Node::FunctionDeclaration(_)))
+                })
+                .unwrap();
+            let key = checker.type_literal_key(declaration);
+            // Explicit admission fault controls use the real parsed owner/type;
+            // these state injections are not natural return-resolution traces.
+            match state {
+                "pending" => {
+                    checker
+                        .pending_signature_returns
+                        .insert(key.clone(), super::LazyReturnState::Pending);
+                }
+                "active" => {
+                    checker
+                        .pending_signature_returns
+                        .insert(key.clone(), super::LazyReturnState::Active);
+                }
+                "resolution" => {
+                    assert!(checker.resolutions.push(
+                        crate::resolution::ResolutionTarget::Signature(key.clone()),
+                        crate::resolution::PropertyName::ResolvedReturnType
+                    ));
+                }
+                "alias" => {
+                    let tsr_ast::Statement::TypeAliasDeclaration(alias) =
+                        parsed.source_file.statements[0]
+                    else {
+                        panic!("alias")
+                    };
+                    let parameter =
+                        bound.symbol_of(alias.type_parameters[0].node_id.unwrap()).unwrap();
+                    checker
+                        .alias_evaluation_bindings
+                        .push([(parameter, checker.intrinsics.number)].into_iter().collect());
+                }
+                _ => unreachable!(),
+            }
+            let image = checker.intrinsics.string;
+            let before = source_view_snapshot(&checker);
+            for _ in 0..3 {
+                assert_eq!(
+                    checker.instantiate_type(ty, &[(ty, image)], &[], &[]),
+                    image,
+                    "direct hit {state}"
+                );
+                assert_eq!(
+                    checker.instantiate_type(ty, &[], &[], &[]),
+                    checker.intrinsics.error,
+                    "unsupported admission {state}"
+                );
+                assert_eq!(
+                    source_view_snapshot(&checker),
+                    before,
+                    "refusal must not publish {state}"
+                );
+            }
+            if state == "resolution" {
+                assert!(checker.resolutions.pop());
+            }
+            if state == "alias" {
+                checker.alias_evaluation_bindings.pop();
+            }
+            checker.pending_signature_returns.remove(&key);
+            assert_eq!(
+                checker.instantiate_type(ty, &[], &[], &[]),
+                ty,
+                "actual cold identity after fault state is removed"
+            );
+            assert!(!checker.signature_types.contains_key(&ty));
+        }
+    }
