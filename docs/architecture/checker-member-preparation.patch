+            ("accessor-reverse", format!("{accessor} type Both=Right<number>&Left<string>;"), "value", "merged", "number", "number"),
+        ];
+        let mut failures=Vec::new();
+        for (case,body,property,want_kind,want_read,want_write) in rows {
+            let source=format!("{body} declare const receiver:Both; const probe=receiver.{property};");
