+                    {
+                        1
+                    } else if self
+                        .property_has_modifier(property, tsr_ast::SyntaxKind::ProtectedKeyword)
+                    {
+                        2
+                    } else {
+                        0
+                    };
+                    Result::Complete(View {
+                        root: property,
+                        supplier: id,
+                        receiver,
+                        read,
+                        write,
+                        optional: self.property_is_optional(property),
+                        readonly: self.is_readonly_property(property),
+                        accessibility,
+                        identity: Identity::Single,
+                    })
+                }
+            }
+        } else {
+            let mut result = Result::Unsupported;
+            // Use filtered resolved bases, never re-admit written excluded
+            // cycle edges. Instantiate each under the receiving reference.
+            for base in bases {
+                let base = self.instantiate_for_reference(id, base);
+                match self.member_consumer_view_worker(base, name, receiver, path) {
+                    Result::Unsupported => {}
+                    answer => {
+                        result = answer;
+                        break;
+                    }
+                }
+            }
+            result
+        };
+        path.pop();
+        result
+    }
