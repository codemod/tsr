@@ -3121,0 +3166,36 @@ mod property_name_tests {
+
+    #[test]
+    fn ordered_name_index_keeps_first_occurrences_across_growth_and_collisions() {
+        #[derive(Default)]
+        struct CollisionHasher;
+        impl std::hash::Hasher for CollisionHasher {
+            fn finish(&self) -> u64 {
+                0
+            }
+            fn write(&mut self, _bytes: &[u8]) {}
+        }
+        type Collisions = std::hash::BuildHasherDefault<CollisionHasher>;
+        let mut names = super::OrderedPropertyNames::<Collisions>::default();
+        let mut expected: Vec<String> = (0..80).map(|i| format!("p{i}")).collect();
+        expected.extend(["", "P0", "é", "é"].map(str::to_owned));
+        for name in &expected {
+            names.insert(name.clone());
+        }
+        for name in expected.iter().rev() {
+            names.insert(name.clone());
+        }
+        assert_eq!(names.into_vec(), expected);
+    }
+
+    #[test]
+    fn ordered_name_index_keeps_small_storage_until_the_measured_boundary() {
+        let mut names = super::OrderedPropertyNames::<rustc_hash::FxBuildHasher>::default();
+        for i in 0..32 {
+            names.insert(format!("p{i}"));
+        }
+        assert!(names.index.is_none());
+        names.insert("p0".to_owned());
+        assert!(names.index.is_some());
+        assert_eq!(names.into_vec(), (0..32).map(|i| format!("p{i}")).collect::<Vec<_>>());
+    }
