+//! Temporary attribution only. No filesystem answers or cache semantics change.
+use std::{
+    cell::RefCell,
+    collections::{BTreeMap, HashSet},
+    marker::PhantomData,
+    rc::Rc,
+    sync::{Mutex, OnceLock},
+    time::Instant,
+};
+thread_local! { static ORIGINS: RefCell<Vec<&'static str>> = const { RefCell::new(Vec::new()) }; }
+fn enabled() -> bool {
+    static FLAG: OnceLock<bool> = OnceLock::new();
+    *FLAG.get_or_init(|| std::env::var_os("TSR_META_PROFILE").is_some())
+}
+/// Origin stack guard; remains on its creating thread.
+pub struct Scope {
+    name: Option<&'static str>,
+    _thread: PhantomData<Rc<()>>,
+}
+impl Scope {
+    /// Enter a diagnostic origin without changing any lookup.
+    #[must_use]
+    pub fn enter(name: &'static str) -> Self {
+        let name = if enabled() {
+            ORIGINS.with(|s| s.borrow_mut().push(name));
+            Some(name)
+        } else {
+            None
+        };
+        Self { name, _thread: PhantomData }
+    }
+}
+impl Drop for Scope {
+    fn drop(&mut self) {
+        if let Some(name) = self.name {
+            ORIGINS.with(|s| assert_eq!(s.borrow_mut().pop(), Some(name)));
+        }
+    }
+}
+fn origin() -> String {
+    ORIGINS.with(|s| {
+        let s = s.borrow();
+        if s.is_empty() { "unclassified".into() } else { s.join(" > ") }
+    })
+}
+#[derive(Default)]
+struct Row {
+    calls: u64,
+    yes: u64,
+    no: u64,
+    ns: u64,
+    paths: HashSet<String>,
+    outcomes: BTreeMap<String, u64>,
+}
+#[derive(Default)]
+struct State {
+    rows: BTreeMap<(String, String), Row>,
+    global_paths: BTreeMap<String, HashSet<String>>,
+}
+fn state() -> &'static Mutex<State> {
+    static S: OnceLock<Mutex<State>> = OnceLock::new();
+    S.get_or_init(|| Mutex::new(State::default()))
+}
+/// Start a disjoint metadata timer when enabled.
+pub fn start() -> Option<Instant> {
+    enabled().then(Instant::now)
+}
+/// Record an operation after its answer was computed.
+pub fn record(operation: &str, path: &str, yes: bool, ns: Option<u64>, outcome: &str) {
+    if !enabled() {
+        return;
+    }
+    let mut s = state().lock().unwrap();
+    s.global_paths.entry(operation.into()).or_default().insert(path.into());
+    let r = s.rows.entry((operation.into(), origin())).or_default();
+    r.calls += 1;
+    r.yes += u64::from(yes);
+    r.no += u64::from(!yes);
+    r.ns += ns.unwrap_or(0);
+    r.paths.insert(path.into());
+    *r.outcomes.entry(outcome.into()).or_default() += 1;
+}
+/// Count logical cached queries separately from disk calls.
+pub fn cached(operation: &str, path: &str, yes: bool) {
+    record(operation, path, yes, None, if yes { "yes" } else { "no" });
+}
+/// Run the unchanged metadata query and record its origin.
+#[must_use]
+pub fn disk_metadata(path: &str, directory: bool) -> bool {
+    let clock = start();
+    let m = std::fs::metadata(path);
+    let ns = clock.map(|s| u64::try_from(s.elapsed().as_nanos()).unwrap_or(u64::MAX));
+    let yes = m.as_ref().is_ok_and(|m| if directory { m.is_dir() } else { !m.is_dir() });
+    if enabled() {
+        let outcome = match &m {
+            Ok(_) if yes => "found",
+            Ok(_) => "wrong_kind",
+            Err(e) if e.kind() == std::io::ErrorKind::NotFound => "not_found",
+            Err(_) => "other_error",
+        };
+        record(if directory { "disk.directory" } else { "disk.file" }, path, yes, ns, outcome);
+    }
+    yes
+}
+/// Render counts without exposing filesystem paths.
+#[must_use]
+pub fn snapshot_json() -> String {
+    let s = state().lock().unwrap();
+    let rows=s.rows.iter().map(|((op,origin),r)| {
+        let outcomes=r.outcomes.iter().map(|(k,v)|format!("\"{k}\":{v}")).collect::<Vec<_>>().join(",");
+        format!("{{\"operation\":\"{op}\",\"origin\":\"{origin}\",\"calls\":{},\"yes\":{},\"no\":{},\"stat_ns\":{},\"unique_paths\":{},\"outcomes\":{{{outcomes}}}}}",r.calls,r.yes,r.no,r.ns,r.paths.len())
+    }).collect::<Vec<_>>().join(",");
+    let global = s
+        .global_paths
+        .iter()
+        .map(|(k, v)| format!("\"{k}\":{}", v.len()))
+        .collect::<Vec<_>>()
+        .join(",");
+    format!("{{\"rows\":[{rows}],\"global_unique_paths\":{{{global}}}}}")
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::FileSystem;
+    #[test]
+    fn origin_scopes_restore_after_nested_work_and_unwind() {
+        assert!(enabled(), "run probe controls with TSR_META_PROFILE=1");
+        assert_eq!(origin(), "unclassified");
+        let _outer = Scope::enter("probe_test.outer");
+        assert_eq!(origin(), "probe_test.outer");
+        {
+            let _inner = Scope::enter("probe_test.inner");
+            assert_eq!(origin(), "probe_test.outer > probe_test.inner");
+        }
+        let result = std::panic::catch_unwind(|| {
+            let _panic = Scope::enter("probe_test.panic");
+            panic!("forced unwind");
+        });
+        assert!(result.is_err());
+        assert_eq!(origin(), "probe_test.outer");
+    }
+    #[test]
+    fn cached_repeats_and_underlying_calls_are_counted_separately() {
+        assert!(enabled(), "run probe controls with TSR_META_PROFILE=1");
+        let _scope = Scope::enter("probe_test.cache");
+        let unique = format!("/tmp/tsr-origin-probe-missing-{}", std::process::id());
+        let fs = crate::OsFileSystem::new();
+        let cached = crate::CachedFileSystem::new(&fs);
+        assert!(!cached.file_exists(&unique));
+        assert!(!cached.file_exists(&unique));
+        let s = state().lock().unwrap();
+        let logical = &s.rows[&("cached.file".into(), "probe_test.cache".into())];
+        let disk = &s.rows[&("disk.file".into(), "probe_test.cache".into())];
+        assert_eq!(
+            (logical.calls, logical.paths.len(), disk.calls, disk.paths.len()),
+            (2, 1, 1, 1)
+        );
+        assert_eq!(disk.outcomes["not_found"], 1);
+    }
+}
