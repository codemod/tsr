+    /// `gatherTypeParameters(jsDoc, typedefOrCallback=false)`
+    /// (`parser/reparser.go:293`) over a class's last comment: nothing when
+    /// the comment declares a typedef or callback, else every `@template`
+    /// tag's parameters in order. The written slices cannot be concatenated
+    /// without an allocation this borrowed return has no owner for, so a
+    /// comment with several parameter-carrying `@template` tags keeps the
+    /// unparameterised answer (a known limitation, not native).
+    fn jsdoc_class_template_parameters(
+        &self,
+        class: NodeId,
+    ) -> &'a [&'a tsr_ast::TypeParameterDeclaration<'a>] {
+        if !self.in_js_file(class) {
+            return &[];
+        }
+        let Some(doc) = self.jsdoc_entries.get(&class).and_then(|docs| docs.last()) else {
+            return &[];
+        };
+        let mut found: &'a [&'a tsr_ast::TypeParameterDeclaration<'a>] = &[];
+        for tag in doc.tags {
+            match tag {
+                tsr_ast::JSDocTag::JSDocTypedefTag(_) | tsr_ast::JSDocTag::JSDocCallbackTag(_) => {
+                    return &[];
+                }
+                tsr_ast::JSDocTag::JSDocTemplateTag(template)
+                    if !template.type_parameters.is_empty() =>
+                {
+                    if !found.is_empty() {
+                        return &[];
+                    }
+                    found = template.type_parameters;
+                }
+                _ => {}
+            }
+        }
+        found
+    }
