+            let parent=checker.symbols.view(&clone).unwrap().parent().unwrap();
+            assert_eq!(checker.symbols.view(&parent).unwrap().name(),"Base");
+            assert_eq!(checker.symbols.view(&clone).unwrap().declarations(),checker.symbols.view(&root_symbol).unwrap().declarations());
+            let base=checker.binder.lookup_local(root,"Base").unwrap();
+            // Deliberate reset notification, distinct from natural TS2310.
