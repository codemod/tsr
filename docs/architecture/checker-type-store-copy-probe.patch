+// Temporary, opt-in locating accounting. No semantic answers or key changes.
+#[derive(Debug, Default)]
+struct TypeAllocationProbe {
+    rows: std::collections::BTreeMap<&'static str, [usize; 9]>,
+}
+
+fn type_copy_payload(data: &TypeData) -> (&'static str, usize, usize, usize) {
+    match data {
+        TypeData::Intrinsic { .. } => ("intrinsic", 0, 0, 0),
+        TypeData::BooleanLiteral(_) => ("boolean", 0, 0, 0),
+        TypeData::StringLiteral(text) => ("string", text.len(), text.capacity(), usize::from(!text.is_empty())),
+        TypeData::NumberLiteral(text) => ("number", text.len(), text.capacity(), usize::from(!text.is_empty())),
+        TypeData::BigIntLiteral(text) => ("bigint", text.len(), text.capacity(), usize::from(!text.is_empty())),
+        TypeData::Named { text, .. } => ("named", text.len(), text.capacity(), usize::from(!text.is_empty())),
+        TypeData::Anonymous { text, .. } => ("anonymous", text.len(), text.capacity(), usize::from(!text.is_empty())),
+        TypeData::EnumLiteral { value, text, .. } => {
+            let value = match value { EnumLiteralValue::String(value) | EnumLiteralValue::Number(value) => value };
+            ("enum", text.len() + value.len(), text.capacity() + value.capacity(), usize::from(!text.is_empty()) + usize::from(!value.is_empty()))
+        }
+        TypeData::Union { text, types, .. } | TypeData::Intersection { text, types, .. } => {
+            let kind = if matches!(data, TypeData::Union { .. }) { "union" } else { "intersection" };
+            (kind, text.len() + types.len() * std::mem::size_of::<TypeId>(),
+                text.capacity() + types.capacity() * std::mem::size_of::<TypeId>(),
+                usize::from(!text.is_empty()) + usize::from(!types.is_empty()))
+        }
+    }
+}
+
+impl Drop for TypeStore {
+    fn drop(&mut self) {
+        if let Some(probe) = &self.allocation_probe {
+            let type_payload_capacity: usize = self.types.iter().map(|ty| type_copy_payload(&ty.data).2).sum();
+            let key_payload_capacity: usize = self.interned.keys().map(|(_, data, _)| type_copy_payload(data).2).sum();
+            eprintln!("TSR_TYPE_STORE_SUMMARY\t{}\t{}\t{}\t{}\t{}\t{}", self.types.len(), self.types.capacity(), self.interned.len(), self.interned.capacity(), type_payload_capacity, key_payload_capacity);
+            for (kind, row) in &probe.rows {
+                eprintln!("TSR_TYPE_STORE_ROW\t{kind}\t{}", row.iter().map(usize::to_string).collect::<Vec<_>>().join("\t"));
+            }
+        }
+    }
+}
