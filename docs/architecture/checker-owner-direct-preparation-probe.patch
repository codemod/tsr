+// TSR_NAMING_PROBE: private attribution only, never runtime delivery.
+#[cfg(feature = "work-trace")]
+#[derive(Clone, Debug, PartialEq, Eq, Hash)]
+pub enum NamingProbeKey {
+    Locals(NodeId),
+    Exports(SymbolRef),
+    ClassName(SymbolRef),
+    Globals,
+    AliasExports(SymbolRef),
+}
+#[cfg(feature = "work-trace")]
+thread_local! {
+    static NAMING_PROBE: std::cell::RefCell<FxHashMap<NamingProbeKey, [u64; 7]>> = std::cell::RefCell::new(FxHashMap::default());
+}
+#[cfg(feature = "work-trace")]
+pub fn naming_probe_reset() { NAMING_PROBE.with(|m| m.borrow_mut().clear()); }
+#[cfg(feature = "work-trace")]
+pub fn naming_probe_table(key: &NamingProbeKey, entries: usize, aliases: usize, bytes: usize, present: bool, empty: bool) {
+    NAMING_PROBE.with(|m| {
+        let mut m = m.borrow_mut();
+        let v = m.entry(key.clone()).or_default();
+        v[0] += 1; v[1] += entries as u64; v[2] += aliases as u64; v[3] += bytes as u64;
+        v[5] += u64::from(!present); v[6] += u64::from(present && empty);
+    });
+}
+#[cfg(feature = "work-trace")]
+pub fn naming_probe_direct(key: &NamingProbeKey) {
+    NAMING_PROBE.with(|m| m.borrow_mut().get_mut(key).unwrap()[4] += 1);
+}
+#[cfg(feature = "work-trace")]
+pub fn naming_probe_counts() -> [[u64; 8]; 5] {
+    NAMING_PROBE.with(|m| {
+        let mut totals = [[0; 8]; 5];
+        for (key, value) in m.borrow().iter() {
+            let kind = match key { NamingProbeKey::Locals(_) => 0, NamingProbeKey::Exports(_) => 1, NamingProbeKey::ClassName(_) => 2, NamingProbeKey::Globals => 3, NamingProbeKey::AliasExports(_) => 4 };
+            totals[kind][0] += 1;
+            for (i, v) in value.iter().enumerate() { totals[kind][i + 1] += v; }
+        }
+        totals
+    })
 }

