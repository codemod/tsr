+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) enum MemberQuery {
+    Published { symbol:SymbolRef, revision:u64, active:bool },
+    Absent { revision:u64, active:bool },
+    Unsupported,
+}
