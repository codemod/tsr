+    #[test]
+    fn inherited_member_this_uses_the_original_receiver_and_supplying_base_mapper() {
+        with_checker(
+            "interface A { self: this } interface B extends A { own: number; ownThis: this } interface C extends B { extra: string; ownThis: this }",
+            |checker, root| {
+                for name in ["B", "C", "B", "A", "C"] {
+                    let symbol = checker.binder.lookup_local(root, name).unwrap();
+                    let receiver = checker.get_declared_type_of_symbol(symbol);
+                    assert_eq!(
+                        checker.get_type_of_property_of_type(receiver, "self"),
+                        Some(receiver),
+                        "the member supplied by A must keep the {name} receiver",
+                    );
+                    let own_name = if name == "A" { "self" } else { "ownThis" };
+                    let own = checker.get_property_of_type(receiver, own_name).unwrap();
+                    let formal_this = checker.get_type_of_symbol(own);
+                    assert_eq!(
+                        checker.get_type_of_property_with_this_argument(
+                            receiver,
+                            "self",
+                            formal_this,
+                            false,
+                        ),
+                        Some(formal_this),
+                        "the supplying base must also map to {name}'s explicit formal this",
+                    );
+                }
+            },
+        );
+    }
+
+    #[test]
+    fn inherited_member_this_composes_each_outer_generic_mapper() {
+        with_checker(
+            "interface A<T> { value: T; self: this } interface B<U> extends A<U> { own: U } interface C<V> extends B<V> { extra: V } type S = C<string>; type N = C<number>;",
+            |checker, root| {
+                for (name, value) in [
+                    ("S", checker.intrinsics.string),
+                    ("N", checker.intrinsics.number),
+                    ("S", checker.intrinsics.string),
+                ] {
+                    let symbol = checker.binder.lookup_local(root, name).unwrap();
+                    let receiver = checker.get_declared_type_of_symbol(symbol);
+                    assert_eq!(
+                        checker.get_type_of_property_of_type(receiver, "self"),
+                        Some(receiver),
+                        "the supplying base must retain the concrete {name} receiver",
+                    );
+                    assert_eq!(
+                        checker.get_type_of_property_of_type(receiver, "value"),
+                        Some(value)
+                    );
+                }
+            },
+        );
+    }
+
