+    /// The reparsed `JSTypeAliasDeclaration` of a `@typedef`/`@callback`,
+    /// bound as `bindBlockScopedDeclaration(node, TypeAlias,
+    /// TypeAliasExcludes)` (`binder/binder.go:1238`): in the file's own scope
+    /// of an external or `CommonJS` module, `declareModuleMember` (`:373`) with
+    /// the alias implicitly exported (`IsImplicitlyExportedJSDocDeclaration`,
+    /// `ast/utilities.go:4184`) — a local carrying no flags and the export
+    /// symbol, as an `export type` gets; otherwise the scope's locals.
+    /// `declareSymbol`'s exclusion test reports a redeclaration (TS2300).
+    fn declare_jsdoc_alias(
+        &mut self,
+        root: NodeId,
+        scope: NodeId,
+        name: &'a str,
+        declaration: NodeId,
+        name_node: Option<NodeId>,
+    ) {
+        if let Some(name_node) = name_node {
+            self.name_nodes.push((declaration, name_node));
+        }
+        if scope == root
+            && let Some(module) = self.module_symbol
+        {
+            let local = self.declare_into_with_excludes(
+                Destination::Locals,
+                root,
+                Some(module),
+                name,
+                SymbolFlags::empty(),
+                SymbolFlags::TYPE_ALIAS.excludes(),
+                declaration,
+            );
+            let exported = self.declare_into(
+                Destination::Exports,
+                root,
+                Some(module),
+                name,
+                SymbolFlags::TYPE_ALIAS,
+                declaration,
+            );
+            self.symbols.get_mut(local).export_symbol = Some(exported);
+            self.node_symbols[declaration.index() - self.node_base] = Some(exported);
+            return;
+        }
+        let symbol = self.declare_into(
+            Destination::Locals,
+            scope,
+            None,
+            name,
+            SymbolFlags::TYPE_ALIAS,
+            declaration,
+        );
+        self.node_symbols[declaration.index() - self.node_base] = Some(symbol);
+    }
