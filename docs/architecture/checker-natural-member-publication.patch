+    pub(crate) fn publication_read(&mut self, symbol:&SymbolRef) -> TypeId {
+        if let Some(read) = self.publication_cached_read(symbol) { return read; }
+        if let Some(bound) = self.symbols.bound_id(symbol).unwrap() { return self.get_type_of_symbol(bound); }
+        let links = self.member_publication.links[symbol].clone();
+        let mut read = self.publication_read(&links.target.expect("lazy target"));
+        if let Some(mapper) = links.mapper { read = self.publication_apply(mapper,read); }
+        self.member_publication.links.get_mut(symbol).unwrap().read = Some(read);
+        read
+    }
