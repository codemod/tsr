+            let receiver=checker.get_type_of_symbol(receiver_symbol);
+            let clone=publication(checker,receiver,"value");
+            assert_eq!(checker.publication_target(&clone),clone);
+            assert!(!checker.symbols.view(&clone).unwrap().check_flags().contains(CheckFlags::INSTANTIATED));
+            let links=checker.member_publication.links[&clone].clone();
+            let first=links.target.unwrap();
+            assert_ne!(clone,first);
