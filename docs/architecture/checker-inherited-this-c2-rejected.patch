+                for raw in 0..u32::try_from(checker.nodes.len()).unwrap() {
+                    let id = NodeId::new(raw);
+                    if checker.nodes.kind(id) != tsr_ast::SyntaxKind::PropertyAccessExpression {
+                        continue;
+                    }
+                    let expression =
