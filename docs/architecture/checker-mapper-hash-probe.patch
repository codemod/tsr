+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn object_and_signature_active_domains_stay_disjoint() {
+        let mut store = crate::TypeStore::new();
+        let id = store.new_named(crate::TypeFlags::OBJECT, "source".to_string(), None);
+        let image = store.new_named(crate::TypeFlags::OBJECT, "image".to_string(), None);
+        let key = (id, vec![(id, image)]);
+        ACTIVE.with(|s| s.borrow_mut().push((7, table_domain(0), key.clone())));
+        assert!(active(7, 0, &key));
+        assert!(active(7, 2, &key));
+        assert!(active(7, 3, &key));
+        assert!(!active(7, 1, &key));
+        assert!(!active(8, 0, &key));
+        let reordered = (id, vec![(image, id)]);
+        assert!(!active(7, 0, &reordered));
+        ACTIVE.with(|s| s.borrow_mut().pop().unwrap());
+        assert!(!active(7, 0, &key));
+    }
+    #[test]
+    fn owner_guard_records_initialization_only_and_is_thread_local() {
+        assert_eq!(table_domain(1), 1);
+        assert_eq!(table_domain(0), 0);
+        assert_eq!(table_domain(2), 0);
+        assert_eq!(table_domain(3), 0);
+        std::thread::scope(|s| {
+            for owner in 0..4 {
+                s.spawn(move || {
+                    let mut guard = PoolWorker::enter(owner, 4);
+                    guard.setup_complete();
+                    assert!(guard.setup_end >= guard.started);
+                    assert!(guard.checks.is_empty());
+                    assert!(!guard.complete);
+                });
+            }
+        });
+    }
+}
