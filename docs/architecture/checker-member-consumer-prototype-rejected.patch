+    #[test]
+    fn member_consumer_generic_reads_do_not_merge_on_bare_symbol() {
+        use crate::member_completeness::{
+            MemberConsumerIdentity as Identity, MemberConsumerResult as Result,
+        };
+        let prefix = "interface Base<T> { value:T } interface Left<U> extends Base<U> { left:U } interface Right<V> extends Base<V> { right:V }";
+        for (body, expected_read, expected_identity) in [
+            ("type Both = Left<string> & Right<string>;", "string", Identity::Single),
+            ("type Both = Left<string> & Right<number>;", "never", Identity::Synthesized),
+        ] {
+            let source =
+                format!("{prefix} {body} declare const receiver:Both; const probe=receiver.value;");
+            for order in 0..3 {
+                with_checker(&source, |checker, root| {
+                    if order == 1 {
+                        let probe = checker.binder.lookup_local(root, "probe").unwrap();
+                        checker.get_type_of_symbol(probe);
+                    } else if order == 2 {
+                        checker.check_source_file(
+                            root,
+                            crate::check::FileContext { ambient: false, has_parse_errors: false },
+                        );
+                    }
+                    let both = checker.binder.lookup_local(root, "Both").unwrap();
+                    let receiver = checker.get_declared_type_of_symbol(both);
+                    let Result::Complete(first) = checker.member_consumer_view(receiver, "value")
+                    else {
+                        panic!("no completed generic view");
+                    };
+                    assert_eq!(checker.type_to_string(first.read), expected_read);
+                    assert_eq!(first.identity, expected_identity);
+                    assert_eq!(first.receiver, receiver);
+                    for _ in 0..3 {
+                        assert_eq!(
+                            checker.member_consumer_view(receiver, "value"),
+                            Result::Complete(first.clone())
+                        );
+                    }
+                });
+            }
+        }
+    }
