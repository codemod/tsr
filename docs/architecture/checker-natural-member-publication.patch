+    // Eligibility is a no-force observation. Object metadata needed by the
+    // complete native couldContainTypeVariables worker remains unsupported.
+    fn publication_invariant(&self, ty:TypeId) -> bool {
+        let value = self.store.get(ty);
+        if value.flags.intersects(TypeFlags::INSTANTIABLE | TypeFlags::OBJECT) { return false; }
+        match &value.data {
+            TypeData::Union { types, .. } | TypeData::Intersection { types, .. } => types.iter().all(|&t| self.publication_invariant(t)),
+            _ => true,
+        }
+    }
+
+    fn publication_cached_read(&self, symbol:&SymbolRef) -> Option<TypeId> {
+        match self.symbols.bound_id(symbol).expect("private ownership") {
+            Some(id) => self.symbol_types.get(&id).copied(),
+            None => self.member_publication.links.get(symbol).and_then(|l| l.read),
