+    /// TS2702 / TS2713 — `checkAndReportErrorForUsingTypeAsNamespace`
+    /// (`checker.go:1608`), the arm of `onFailedToResolveSymbol` a qualified
+    /// name's left side reaches when its namespace lookup fails.
+    ///
+    /// `resolveSymbol(resolveName(left, Type &^ Namespace))`: a type that is
+    /// not also a namespace. When the type's declared type has a property of
+    /// the right side's name the whole qualified name gets TS2713 (`C2.Red`
+    /// for `type C2 = typeof Color`); otherwise the left side gets TS2702.
+    /// An alias answers when its resolved flags carry the meaning, as
+    /// `getSymbol` admits it.
+    fn check_using_type_as_namespace(
+        &mut self,
+        qualified: NodeId,
+        left: NodeId,
+        name: &str,
+        member: &str,
+    ) -> bool {
+        let meaning = SymbolFlags::TYPE.difference(SymbolFlags::NAMESPACE);
+        let Some(symbol) = self.binder.resolve_name(
+            self.nodes,
+            self.node_map,
+            left,
+            name,
+            meaning | SymbolFlags::ALIAS,
+        ) else {
+            return false;
+        };
+        let symbol = self.binder.merged_symbol(symbol);
+        let symbol = if self.binder.symbols().get(symbol).flags.intersects(SymbolFlags::ALIAS) {
+            if !self.get_symbol_flags(symbol).intersects(meaning) {
+                return false;
+            }
+            let Some(target) = self.resolve_alias(symbol) else { return false };
+            self.binder.merged_symbol(target)
+        } else {
+            symbol
+        };
+        let Some(file) = self.source_file_of_for_diagnostics(left) else { return true };
+        // `getPropertyOfType` reads through `getReducedApparentType`, so a
+        // type parameter answers its constraint's property (`T.abc` for
+        // `T extends { abc: number }`).
+        let declared = self.get_declared_type_of_symbol(symbol);
+        let reduced = self.get_reduced_type(declared);
+        let apparent = self.apparent_type(reduced);
+        let apparent = self.get_reduced_type(apparent);
+        if self.get_property_of_type(apparent, member).is_some() {
+            let span = self.error_span(qualified);
+            self.report(
+                file,
+                Diagnostic::with_args(
+                    &messages::CANNOT_ACCESS_0_1_BECAUSE_0_IS_A_TYPE_BUT_NOT_A_NAMESPACE_DID_YOU_MEAN_TO_RETRIEVE_THE_TYPE_OF_THE_PROPERTY_1_IN_0_WITH_0_1,
+                    span,
+                    [name.to_string(), member.to_string()],
+                ),
+            );
+            return true;
+        }
+        let span = self.nodes.span(left);
+        self.report(
+            file,
+            Diagnostic::with_args(
+                &messages::_0_ONLY_REFERS_TO_A_TYPE_BUT_IS_BEING_USED_AS_A_NAMESPACE_HERE,
+                span,
+                [name.to_string()],
+            ),
+        );
+        true
+    }
