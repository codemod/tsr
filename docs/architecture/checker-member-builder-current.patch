+    fn inherited_generic_fields_instantiate_calls_constructs_and_indexes() {
+        let source="interface Base<T> {base:T;(v:T):T;new(v:T):{v:T};[key:string]:T} interface Mid<U> extends Base<U> {mid:U;[key:string]:U} interface Leaf extends Mid<number> {leaf:number}";
